{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/eval/schema/noise-summary-v1.json",
  "title": "Rio noise summary v1",
  "description": "eval/runs/noise/<date>/summary.json. harmful is a lower bound (harmful_is_lower_bound is always true); unadjudicated findings are never counted as neutral.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rio-noise-summary-v1"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "window_days": {
      "type": "integer",
      "minimum": 1
    },
    "rio": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binary",
        "sha256",
        "profile"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "considered": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "considered",
        "selected"
      ],
      "additionalProperties": false
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "ran",
              "failed"
            ]
          },
          "findings": {
            "type": "integer",
            "minimum": 0
          },
          "harmful": {
            "type": "integer",
            "minimum": 0
          },
          "neutral": {
            "type": "integer",
            "minimum": 0
          },
          "useful": {
            "type": "integer",
            "minimum": 0
          },
          "unadjudicated": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "pr",
          "status",
          "findings",
          "harmful",
          "neutral",
          "useful",
          "unadjudicated"
        ],
        "additionalProperties": false
      }
    },
    "pr_count": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "integer",
      "minimum": 0
    },
    "harmful": {
      "type": "integer",
      "minimum": 0
    },
    "harmful_is_lower_bound": {
      "const": true
    },
    "harmful_note": {
      "type": "string",
      "minLength": 1
    },
    "neutral": {
      "type": "integer",
      "minimum": 0
    },
    "useful": {
      "type": "integer",
      "minimum": 0
    },
    "unadjudicated": {
      "type": "integer",
      "minimum": 0
    },
    "harmful_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "adjudicator": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "pr",
          "finding_id",
          "rule_id",
          "path",
          "line_start"
        ],
        "additionalProperties": false
      }
    },
    "unadjudicated_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "pr": {
            "type": "integer",
            "minimum": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "adjudicator": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "pr",
          "finding_id",
          "rule_id",
          "path",
          "line_start"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema",
    "date",
    "repository",
    "branch",
    "window_days",
    "rio",
    "profile",
    "selection",
    "prs",
    "pr_count",
    "findings",
    "harmful",
    "harmful_is_lower_bound",
    "harmful_note",
    "neutral",
    "useful",
    "unadjudicated",
    "harmful_findings",
    "unadjudicated_findings",
    "failures"
  ],
  "additionalProperties": false
}
