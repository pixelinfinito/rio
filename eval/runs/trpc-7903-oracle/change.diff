+          { a2: 'someone' },
+        ),
+      ),
+    ).toContain(
+      [
+        `* fix(client): new title by @KATT in ${prUrl(1)}`,
+        `* fix(client): pushed directly by @someone in https://github.com/trpc/trpc/commit/a2`,
