  "locked": false,
  "title": "fix(svelte-query-devtools): update the devtools instance when options change after mount",
  "user": {
    "login": "sukvvon",
    "id": 66409882,
    "node_id": "MDQ6VXNlcjY2NDA5ODgy",
    "avatar_url": "https://avatars.githubusercontent.com/u/66409882?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/sukvvon",
    "html_url": "https://github.com/sukvvon",
    "followers_url": "https://api.github.com/users/sukvvon/followers",
    "following_url": "https://api.github.com/users/sukvvon/following{/other_user}",
    "gists_url": "https://api.github.com/users/sukvvon/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/sukvvon/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/sukvvon/subscriptions",
    "organizations_url": "https://api.github.com/users/sukvvon/orgs",
    "repos_url": "https://api.github.com/users/sukvvon/repos",
