FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 ca-certificates openssl util-linux python3 postgresql mariadb-server redis-server && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund && ln -s /app/node_modules /node_modules
COPY . .
RUN npm run build && mkdir -p data && chown -R node:node /app
USER node
EXPOSE 4173
CMD ["node", "server.mjs"]
