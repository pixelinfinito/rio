{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/journey-v1.json",
  "title": "Rio journey v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "covers": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "paths"
          ],
          "properties": {
            "paths": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "routes"
          ],
          "properties": {
            "routes": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "do": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "hint": {
            "type": "string",
            "minLength": 1
          },
          "expect": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "do"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "success": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "after": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resets": {
      "type": "boolean"
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "desktop_only": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "geolocation": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "accuracy": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        "network": {
          "enum": [
            "online",
            "slow-3g",
            "offline"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "sync_reason": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "guidance_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "hash",
          "start_line",
          "end_line"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "ux_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(ui|mobile|ux|project)/[a-z][a-z0-9-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "version",
    "name",
    "title",
    "persona",
    "tags",
    "covers",
    "preconditions",
    "steps",
    "success"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "resets"
        ],
        "properties": {
          "resets": {
            "const": true
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "after"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "desktop_only"
        ],
        "properties": {
          "desktop_only": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
