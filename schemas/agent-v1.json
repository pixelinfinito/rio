{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rio built-in agent manifest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "enum": [
        "correctness",
        "contracts",
        "tests",
        "performance",
        "verifier",
        "security"
      ]
    },
    "run": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "independent": {
      "const": true
    },
    "contracts": {
      "description": "Selected by triage's public_contracts signal and given the contract inventory.",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "name",
    "run",
    "available",
    "independent"
  ],
  "additionalProperties": false
}
