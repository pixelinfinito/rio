{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rio built-in agent manifest",
  "type": "object",
  "properties": {
    "version": {
      "description": "Raised with every change to the agent's prompt.",
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "enum": [
        "correctness",
        "contracts",
        "tests",
        "performance",
        "verifier",
        "security"
      ]
    },
    "run": {
      "type": "boolean"
    },
    "available": {
      "type": "boolean"
    },
    "independent": {
      "const": true
    },
    "contracts": {
      "description": "Selected by triage's public_contracts signal and given the contract inventory.",
      "type": "boolean"
    },
    "second_look": {
      "description": "After its result, the agent is asked once, in the same conversation, for what its first pass over the change left out.",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "name",
    "run",
    "available",
    "independent"
  ],
  "additionalProperties": false
}
