{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rio_version": {
      "type": "string"
    },
    "rio_commit": {
      "type": "string"
    },
    "docs_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "index",
        "topic",
        "section",
        "search",
        "error"
      ]
    },
    "data": {}
  },
  "required": [
    "schema_version",
    "rio_version",
    "rio_commit",
    "docs_revision",
    "kind",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/docs-v1.json",
  "title": "Rio embedded documentation v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "index"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "usage": {
                "type": "string"
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "summary": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "summary"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "usage",
              "topics"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "topic"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "title": {
                "type": "string"
              },
              "prerequisites": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "body"
                  ],
                  "additionalProperties": false
                }
              },
              "available_sections": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "related": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "id",
              "title",
              "prerequisites",
              "sections",
              "available_sections",
              "related"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "section"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "title": {
                "type": "string"
              },
              "prerequisites": {
                "type": "string"
              },
              "sections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "body"
                  ],
                  "additionalProperties": false
                }
              },
              "available_sections": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              },
              "related": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "id",
              "title",
              "prerequisites",
              "sections",
              "available_sections",
              "related"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "search"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "topic": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "section": {
                      "type": "string",
                      "pattern": "^([a-z][a-z0-9-]{0,63})?$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "match": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "topic",
                    "section",
                    "title",
                    "match"
                  ],
                  "additionalProperties": false
                }
              },
              "more": {
                "type": "boolean"
              }
            },
            "required": [
              "results",
              "more"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "invalid_arguments",
                  "invalid_query",
                  "invalid_limit",
                  "unknown_topic",
                  "unknown_section"
                ]
              },
              "message": {
                "type": "string"
              },
              "suggestions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                }
              }
            },
            "required": [
              "code",
              "message",
              "suggestions"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
