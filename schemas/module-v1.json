{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/module-v1.json",
  "title": "Rio module v1",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "adapter",
        "step",
        "catalog",
        "member"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^rio/[a-z][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "object"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "parse",
          "typecheck",
          "lint",
          "test",
          "coverage",
          "scan"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "parse",
          "typecheck",
          "lint",
          "test",
          "coverage",
          "scan"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "network": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exit_codes": {
              "type": "object",
              "properties": {
                "clean": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true
                },
                "failed": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[0-9]+$"
                  },
                  "additionalProperties": {
                    "enum": [
                      "spawn_failed",
                      "tool_crashed",
                      "tool_config_error",
                      "unparseable_output",
                      "output_limit",
                      "disk_full",
                      "tests_failed",
                      "network_error",
                      "partial_data"
                    ]
                  }
                },
                "skipped": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[0-9]+$"
                  },
                  "additionalProperties": {
                    "enum": [
                      "tool_missing",
                      "no_project_config",
                      "not_supported_by_adapter",
                      "disabled",
                      "offline",
                      "dependency_mismatch",
                      "no_tests",
                      "nothing_to_audit"
                    ]
                  }
                }
              },
              "required": [
                "clean",
                "diagnostics"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "command",
            "network",
            "exit_codes"
          ],
          "additionalProperties": false
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "local": {
      "type": "boolean"
    },
    "attribution": {
      "description": "Source and license notice that the catalog's source requires.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "notice": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "url",
        "license",
        "notice"
      ],
      "additionalProperties": false
    },
    "items": {
      "description": "Catalog items: official id, Rio-written summary, applicability predicates and taint trace hints.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "applies_when": {
            "description": "The item applies when every `all` predicate and at least one `any` predicate match (an absent list matches). `sink` matches when a trace sink of that kind occurs in the changed code.",
            "type": "object",
            "properties": {
              "all": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "language": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "typescript",
                              "python",
                              "rust"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "language"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "framework": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "framework"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "node_kind": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "endpoint",
                              "table",
                              "event",
                              "config",
                              "export"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "node_kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sensitive_path": {
                          "const": true
                        }
                      },
                      "required": [
                        "sensitive_path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sink": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "sql_query",
                              "shell_command",
                              "filesystem_path",
                              "html_output",
                              "redirect",
                              "deserialization",
                              "crypto_operation",
                              "authorization_check",
                              "authentication_check",
                              "log_output",
                              "outbound_request",
                              "template_render",
                              "unsafe_memory",
                              "error_response",
                              "session_state",
                              "secret_value",
                              "token_handling",
                              "dependency_manifest",
                              "file_upload"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "sink"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "always": {
                          "const": true
                        }
                      },
                      "required": [
                        "always"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1
              },
              "any": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "language": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "typescript",
                              "python",
                              "rust"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "language"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "framework": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]*$"
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "framework"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "node_kind": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "endpoint",
                              "table",
                              "event",
                              "config",
                              "export"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "node_kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sensitive_path": {
                          "const": true
                        }
                      },
                      "required": [
                        "sensitive_path"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sink": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "sql_query",
                              "shell_command",
                              "filesystem_path",
                              "html_output",
                              "redirect",
                              "deserialization",
                              "crypto_operation",
                              "authorization_check",
                              "authentication_check",
                              "log_output",
                              "outbound_request",
                              "template_render",
                              "unsafe_memory",
                              "error_response",
                              "session_state",
                              "secret_value",
                              "token_handling",
                              "dependency_manifest",
                              "file_upload"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "sink"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "always": {
                          "const": true
                        }
                      },
                      "required": [
                        "always"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "minItems": 1
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          },
          "trace": {
            "type": "object",
            "properties": {
              "sources": {
                "type": "array",
                "items": {
                  "enum": [
                    "http_request",
                    "cli_args",
                    "environment",
                    "file_content",
                    "message",
                    "database_read",
                    "session",
                    "external_response"
                  ]
                },
                "uniqueItems": true
              },
              "sinks": {
                "type": "array",
                "items": {
                  "enum": [
                    "sql_query",
                    "shell_command",
                    "filesystem_path",
                    "html_output",
                    "redirect",
                    "deserialization",
                    "crypto_operation",
                    "authorization_check",
                    "authentication_check",
                    "log_output",
                    "outbound_request",
                    "template_render",
                    "unsafe_memory",
                    "error_response",
                    "session_state",
                    "secret_value",
                    "token_handling",
                    "dependency_manifest",
                    "file_upload"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "sources",
              "sinks"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "url",
          "applies_when",
          "trace"
        ],
        "additionalProperties": false
      }
    },
    "provider": {
      "description": "Model provider; the member's vendor for the allowlist and audit. `placeholder` until `rio init` configures the council.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "model": {
      "description": "Model identifier at the provider, `placeholder` until configured.",
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "description": "Prompt file relative to the manifest.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.md$"
    },
    "context_pack": {
      "enum": [
        "diff-only",
        "graph-heavy",
        "execution"
      ]
    },
    "role": {
      "enum": [
        "skeptic",
        "exploit-author",
        "code-owner",
        "maintainer",
        "tester"
      ]
    },
    "weight": {
      "description": "Initial weight; a learned weight with at least 30 cases replaces it. Orders experiments and the council note only.",
      "type": "number",
      "exclusiveMinimum": 0
    },
    "family": {
      "description": "Model family, for council diversity and the author-family rule.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "self_hosted": {
      "description": "Served through a self-hosted runner's model endpoint; the pack never leaves the account.",
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "kind",
    "name",
    "version",
    "description"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "adapter"
          }
        }
      },
      "then": {
        "required": [
          "schema",
          "languages",
          "files",
          "capabilities",
          "tools"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "local"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            },
            {
              "required": [
                "attribution"
              ]
            },
            {
              "required": [
                "items"
              ]
            },
            {
              "required": [
                "provider"
              ]
            },
            {
              "required": [
                "model"
              ]
            },
            {
              "required": [
                "prompt"
              ]
            },
            {
              "required": [
                "context_pack"
              ]
            },
            {
              "required": [
                "role"
              ]
            },
            {
              "required": [
                "weight"
              ]
            },
            {
              "required": [
                "family"
              ]
            },
            {
              "required": [
                "self_hosted"
              ]
            }
          ]
        },
        "properties": {
          "name": {
            "pattern": "^rio/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step"
          }
        }
      },
      "then": {
        "required": [
          "schema",
          "inputs",
          "outputs",
          "local"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "languages"
              ]
            },
            {
              "required": [
                "files"
              ]
            },
            {
              "required": [
                "capabilities"
              ]
            },
            {
              "required": [
                "tools"
              ]
            },
            {
              "required": [
                "attribution"
              ]
            },
            {
              "required": [
                "items"
              ]
            },
            {
              "required": [
                "provider"
              ]
            },
            {
              "required": [
                "model"
              ]
            },
            {
              "required": [
                "prompt"
              ]
            },
            {
              "required": [
                "context_pack"
              ]
            },
            {
              "required": [
                "role"
              ]
            },
            {
              "required": [
                "weight"
              ]
            },
            {
              "required": [
                "family"
              ]
            },
            {
              "required": [
                "self_hosted"
              ]
            }
          ]
        },
        "properties": {
          "name": {
            "pattern": "^rio/[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "catalog"
          }
        }
      },
      "then": {
        "required": [
          "attribution",
          "items"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "schema"
              ]
            },
            {
              "required": [
                "languages"
              ]
            },
            {
              "required": [
                "files"
              ]
            },
            {
              "required": [
                "capabilities"
              ]
            },
            {
              "required": [
                "tools"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            },
            {
              "required": [
                "local"
              ]
            },
            {
              "required": [
                "provider"
              ]
            },
            {
              "required": [
                "model"
              ]
            },
            {
              "required": [
                "prompt"
              ]
            },
            {
              "required": [
                "context_pack"
              ]
            },
            {
              "required": [
                "role"
              ]
            },
            {
              "required": [
                "weight"
              ]
            },
            {
              "required": [
                "family"
              ]
            },
            {
              "required": [
                "self_hosted"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "member"
          }
        }
      },
      "then": {
        "required": [
          "provider",
          "model",
          "prompt",
          "context_pack",
          "role",
          "weight",
          "family"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "schema"
              ]
            },
            {
              "required": [
                "languages"
              ]
            },
            {
              "required": [
                "files"
              ]
            },
            {
              "required": [
                "capabilities"
              ]
            },
            {
              "required": [
                "tools"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            },
            {
              "required": [
                "local"
              ]
            },
            {
              "required": [
                "attribution"
              ]
            },
            {
              "required": [
                "items"
              ]
            }
          ]
        },
        "properties": {
          "name": {
            "pattern": "^rio/[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  ]
}
