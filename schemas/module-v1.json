{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/module-v1.json",
  "title": "Rio module v1",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "adapter",
        "step"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^rio/[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "object"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "parse",
          "typecheck",
          "lint",
          "test",
          "coverage",
          "scan"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tools": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "parse",
          "typecheck",
          "lint",
          "test",
          "coverage",
          "scan"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "network": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exit_codes": {
              "type": "object",
              "properties": {
                "clean": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "diagnostics": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "uniqueItems": true
                },
                "failed": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[0-9]+$"
                  },
                  "additionalProperties": {
                    "enum": [
                      "spawn_failed",
                      "tool_crashed",
                      "tool_config_error",
                      "unparseable_output",
                      "output_limit",
                      "disk_full",
                      "tests_failed",
                      "network_error",
                      "partial_data"
                    ]
                  }
                },
                "skipped": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[0-9]+$"
                  },
                  "additionalProperties": {
                    "enum": [
                      "tool_missing",
                      "no_project_config",
                      "not_supported_by_adapter",
                      "disabled",
                      "offline",
                      "dependency_mismatch",
                      "no_tests",
                      "nothing_to_audit"
                    ]
                  }
                }
              },
              "required": [
                "clean",
                "diagnostics"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "name",
            "command",
            "network",
            "exit_codes"
          ],
          "additionalProperties": false
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "local": {
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "name",
    "version",
    "description",
    "schema"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "adapter"
          }
        }
      },
      "then": {
        "required": [
          "languages",
          "files",
          "capabilities",
          "tools"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "local"
              ]
            },
            {
              "required": [
                "inputs"
              ]
            },
            {
              "required": [
                "outputs"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "step"
          }
        }
      },
      "then": {
        "required": [
          "inputs",
          "outputs",
          "local"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "languages"
              ]
            },
            {
              "required": [
                "files"
              ]
            },
            {
              "required": [
                "capabilities"
              ]
            },
            {
              "required": [
                "tools"
              ]
            }
          ]
        }
      }
    }
  ]
}
