{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/profile-v1.json",
  "title": "Rio profile v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "extends": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "fast": {
          "type": "object",
          "properties": {
            "wall_time": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?)(ms|s|m|h|d)$"
            },
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "agents_max": {
              "type": "integer",
              "minimum": 1
            },
            "verify_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "qa": {
              "type": "object",
              "properties": {
                "wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "cell_wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidence_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "replay_wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "deep": {
          "type": "object",
          "properties": {
            "wall_time": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?)(ms|s|m|h|d)$"
            },
            "tokens": {
              "type": "integer",
              "minimum": 1
            },
            "agents_max": {
              "type": "integer",
              "minimum": 1
            },
            "verify_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "qa": {
              "type": "object",
              "properties": {
                "wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "cell_wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                },
                "tokens": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidence_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "replay_wall": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uses": {
            "type": "string",
            "minLength": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "parallel": {
            "type": "boolean"
          },
          "with": {
            "type": "object"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "when"
              ],
              "additionalProperties": false,
              "description": "Council step rules select findings and carry only `when`; every other step's rules carry `then`."
            }
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "run": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "model"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "uses"
        ],
        "additionalProperties": false
      }
    },
    "suppress": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "rule"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "finding": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "finding"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "publish": {
      "enum": [
        "never",
        "ask",
        "auto"
      ]
    },
    "fail_on": {
      "type": "object",
      "properties": {
        "evidence": {
          "enum": [
            "reproduced",
            "static_proven",
            "plausible",
            "refuted"
          ]
        },
        "categories": {
          "type": "array",
          "items": {
            "enum": [
              "defect",
              "risk",
              "security",
              "ux"
            ]
          },
          "uniqueItems": true
        },
        "states": {
          "type": "array",
          "items": {
            "enum": [
              "new",
              "worsened",
              "pre-existing",
              "fixed",
              "unclassified"
            ]
          },
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "incomplete": {
          "type": "boolean"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "enum": [
              "typecheck",
              "lint",
              "secrets",
              "coverage",
              "dependencies"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "min_evidence": {
      "enum": [
        "reproduced",
        "static_proven",
        "plausible",
        "refuted"
      ]
    },
    "max_lines": {
      "type": "integer",
      "minimum": 1
    },
    "posture": {
      "enum": [
        "critical-only",
        "balanced",
        "thorough"
      ],
      "default": "balanced"
    },
    "max_defects": {
      "type": "integer",
      "minimum": 1,
      "default": 10
    },
    "rounds": {
      "type": "object",
      "properties": {
        "cap": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "diff_only_after": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      },
      "additionalProperties": false,
      "default": {
        "cap": 3,
        "diff_only_after": 1
      }
    },
    "always_human": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "verify": {
      "type": "object",
      "properties": {
        "voters": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "quorum": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "risk_voters": {
          "description": "Voters for a hypothesis its agent classed as a risk. Defaults to voters.",
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "council": {
      "description": "Council settings, used when the profile enables the rio/council step.",
      "type": "object",
      "properties": {
        "members": {
          "description": "Member modules with optional provider, model and family overrides; defaults to the five built-in members.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uses": {
                "type": "string",
                "pattern": "^rio/[a-z][a-z0-9-]*(@[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?)?$"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "self_hosted": {
                "type": "boolean"
              }
            },
            "required": [
              "uses"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 9
        },
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "default": 5
        },
        "max_experiments": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "default": 2
        },
        "min_members": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?)(ms|s|m|h|d)$",
          "default": "90s"
        },
        "vendors_allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "name"
  ],
  "additionalProperties": false
}
