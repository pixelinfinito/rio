{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rio vote answer v1",
  "type": "object",
  "properties": {
    "evidence_level": {
      "enum": [
        "refuted",
        "plausible",
        "static_proven",
        "reproduced"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "execution",
              "code"
            ]
          },
          "version": {
            "enum": [
              "base",
              "head"
            ]
          },
          "job_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          },
          "demonstrates": {
            "enum": [
              "regression",
              "protection"
            ]
          }
        },
        "required": [
          "kind",
          "version",
          "demonstrates"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "category": {
      "enum": [
        "defect",
        "risk",
        "security",
        "style",
        "diagnostic"
      ]
    },
    "reclassification_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16000
    }
  },
  "required": [
    "evidence_level",
    "evidence"
  ],
  "additionalProperties": false
}
