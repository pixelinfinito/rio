{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/finding-v1.json",
  "title": "Rio finding v1",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "defect",
        "risk",
        "security",
        "ux"
      ]
    },
    "evidence_level": {
      "enum": [
        "reproduced",
        "static_proven",
        "plausible",
        "refuted"
      ]
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "state": {
      "enum": [
        "new",
        "worsened",
        "pre-existing",
        "fixed",
        "unclassified"
      ]
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "symbol_path": {
          "type": "string"
        },
        "occurrence_state": {
          "enum": [
            "new",
            "pre-existing",
            "fixed",
            "unclassified"
          ]
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end",
        "symbol_path",
        "occurrence_state"
      ],
      "additionalProperties": false
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string"
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "suggested_fix": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tool",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "minLength": 1
            },
            "cached": {
              "type": "boolean",
              "description": "True when the hypotheses were replayed from the agent result cache."
            }
          },
          "required": [
            "agent"
          ],
          "additionalProperties": false
        }
      ]
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "symbol_path": {
            "type": "string"
          },
          "occurrence_state": {
            "enum": [
              "new",
              "pre-existing",
              "fixed",
              "unclassified"
            ]
          },
          "id": {
            "description": "Identity of the instance finding when this location belongs to a class-level finding.",
            "type": "string",
            "minLength": 1
          },
          "cell": {
            "type": "object",
            "properties": {
              "viewport": {
                "type": "string",
                "minLength": 1
              },
              "color_scheme": {
                "enum": [
                  "light",
                  "dark"
                ]
              }
            },
            "required": [
              "viewport",
              "color_scheme"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "path",
          "line_start",
          "line_end",
          "symbol_path",
          "occurrence_state"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "advisory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "moderate",
            "low",
            "unknown"
          ]
        },
        "fixed_version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      },
      "required": [
        "id",
        "aliases",
        "severity",
        "fixed_version",
        "url"
      ],
      "additionalProperties": false
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "first_posted_in": {
      "type": "string",
      "minLength": 1
    },
    "author_response": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "fixed",
            "wrong",
            "intentional",
            "irrelevant",
            "style"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "actor",
        "at"
      ],
      "additionalProperties": false
    },
    "status": {
      "description": "Lifecycle of a posted lineage finding, independent of regression state.",
      "enum": [
        "open",
        "fixed",
        "dismissed"
      ]
    },
    "resolution": {
      "description": "How the lifecycle status was reached: the head that fixed the finding, or why it stayed open.",
      "type": "object",
      "properties": {
        "fixed_in": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "voters": {
          "type": "integer",
          "minimum": 1
        },
        "agreeing": {
          "type": "integer",
          "minimum": 0
        },
        "blind_match": {
          "type": "array",
          "items": {
            "enum": [
              "same",
              "related",
              "none"
            ]
          }
        },
        "split": {
          "type": "boolean"
        }
      },
      "required": [
        "voters",
        "agreeing",
        "blind_match",
        "split"
      ],
      "additionalProperties": false,
      "description": "Semantic invariant: agreeing <= voters and blind_match contains one entry per configured voter; enforced by Rio deserialization and runtime validation."
    },
    "history": {
      "description": "Earlier record of this identity in the repository's finding registry; present only when one exists. Never consulted by state, status or fail policies.",
      "type": "object",
      "properties": {
        "first_seen": {
          "type": "string",
          "minLength": 1,
          "description": "Review id that first produced the identity in the repository."
        },
        "last_seen": {
          "type": "string",
          "minLength": 1,
          "description": "Review id that last produced the identity before this review."
        },
        "seen_count": {
          "type": "integer",
          "minimum": 1
        },
        "previous_status": {
          "enum": [
            "open",
            "fixed",
            "dismissed"
          ]
        },
        "previous_response": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "fixed",
                "wrong",
                "intentional",
                "irrelevant",
                "style"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "actor",
            "at"
          ],
          "additionalProperties": false
        },
        "dismissed_in": {
          "type": "string",
          "minLength": 1,
          "description": "Review id or pull request reference where the identity was dismissed."
        },
        "fixed_in": {
          "type": "string",
          "minLength": 1,
          "description": "Review id that recorded the identity fixed; present when previous_status is fixed, so a recurrence reads as a regression of that fix."
        }
      },
      "required": [
        "first_seen",
        "last_seen",
        "seen_count",
        "previous_status"
      ],
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "properties": {
        "journey": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "functional",
            "ux",
            "style",
            "accessibility"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "element_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "attribution": {
          "enum": [
            "source",
            "journey"
          ]
        },
        "measurements": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            ]
          }
        }
      },
      "required": [
        "journey",
        "step",
        "kind",
        "route",
        "element_paths",
        "attribution"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "rule_id",
    "category",
    "evidence_level",
    "severity",
    "state",
    "location",
    "message",
    "trigger",
    "evidence",
    "source",
    "locations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "rule_id": {
            "pattern": "^dependency/"
          }
        }
      },
      "then": {
        "required": [
          "advisory"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "const": "ux"
          }
        }
      },
      "then": {
        "required": [
          "qa"
        ],
        "properties": {
          "locations": {
            "items": {
              "required": [
                "cell",
                "evidence"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "qa"
          ]
        }
      }
    }
  ]
}
