{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/report-v1.json",
  "title": "Rio report v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rio-report-v1"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "partial",
        "no_changes",
        "error"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "working-tree",
            "staged",
            "branch"
          ]
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rio_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rio_version"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol_path": {
                "type": "string"
              },
              "references_per_hop": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "test_referenced": {
                "type": "boolean"
              },
              "unresolved": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "symbol_path",
              "references_per_hop",
              "test_referenced",
              "unresolved"
            ],
            "additionalProperties": false
          }
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "symbols",
        "unresolved",
        "truncated"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "incomplete": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "const": "no_endpoint"
          }
        },
        "required": [
          "step",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "pre_existing": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pre_existing",
        "fixed",
        "suppressed"
      ],
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry": {
                "type": "integer",
                "minimum": 0
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "entry",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "notes",
        "suppressions",
        "tool_versions"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "typecheck",
                  "lint",
                  "secrets",
                  "coverage",
                  "dependencies"
                ]
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "enum": [
                  "base",
                  "head"
                ]
              },
              "wall_time_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "root",
              "version",
              "wall_time_ms"
            ],
            "additionalProperties": false
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "wall_time_ms",
        "checks",
        "tool_versions"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "risk_tier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "tier": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "enum": [
                "always_human",
                "triage"
              ]
            }
          },
          "required": [
            "tier",
            "reasons",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "agent_audit": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "description": "Present only for reviews that belong to a review lineage (PR or --since-last branch).",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "pr",
            "branch"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "cap": {
          "type": "integer",
          "minimum": 1
        },
        "capped": {
          "type": "boolean"
        },
        "diff_only": {
          "type": "boolean"
        },
        "previous_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "held_back": {
          "type": "integer",
          "minimum": 0
        },
        "rounds_to_pass": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "author_response_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reconsider": {
          "type": "object",
          "properties": {
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "top": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "title",
                  "path",
                  "line_start"
                ],
                "additionalProperties": false
              }
            },
            "split": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "unresolved",
            "top"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "kind",
        "ref",
        "generation",
        "round",
        "cap",
        "capped",
        "diff_only",
        "previous_head",
        "held_back",
        "rounds_to_pass",
        "author_response_ratio"
      ],
      "additionalProperties": false
    },
    "publication": {
      "description": "Present when a publication step ran.",
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "never",
            "ask",
            "auto"
          ]
        },
        "posted": {
          "type": "integer",
          "minimum": 0
        },
        "edited": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unanchored": {
          "type": "integer",
          "minimum": 0
        },
        "check_run_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_comment_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "policy",
        "posted",
        "edited",
        "resolved",
        "failed",
        "unanchored",
        "check_run_url",
        "summary_comment_url"
      ],
      "additionalProperties": false
    },
    "cache": {
      "description": "Agent result cache use; present when the agents step ran.",
      "type": "object",
      "properties": {
        "lookups": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "tokens_saved_estimate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "lookups",
        "hits",
        "hit_rate",
        "tokens_saved_estimate"
      ],
      "additionalProperties": false
    },
    "suppression_proposals": {
      "description": "Open suppression proposals for the repository.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1
          },
          "since": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "entry",
          "evidence_count",
          "since"
        ],
        "additionalProperties": false
      }
    },
    "security_coverage": {
      "description": "Catalog coverage of the security step; present when the security step ran.",
      "type": "object",
      "properties": {
        "catalog": {
          "enum": [
            "owasp-top10-2025",
            "asvs-5.0"
          ]
        },
        "assessed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "item",
              "title",
              "findings"
            ],
            "additionalProperties": false
          }
        },
        "unassessed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "budget",
                  "no_evidence",
                  "tools_unavailable"
                ]
              }
            },
            "required": [
              "item",
              "title",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "item",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "catalog",
        "assessed",
        "unassessed",
        "not_applicable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "status",
    "review",
    "checks",
    "impact",
    "findings",
    "risks",
    "incomplete",
    "deferred",
    "excluded",
    "metrics",
    "summary",
    "footer"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "defect",
            "risk",
            "security"
          ]
        },
        "evidence_level": {
          "enum": [
            "reproduced",
            "static_proven",
            "plausible",
            "refuted"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "state": {
          "enum": [
            "new",
            "worsened",
            "pre-existing",
            "fixed",
            "unclassified"
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "symbol_path": {
              "type": "string"
            },
            "occurrence_state": {
              "enum": [
                "new",
                "pre-existing",
                "fixed",
                "unclassified"
              ]
            }
          },
          "required": [
            "path",
            "line_start",
            "line_end",
            "symbol_path",
            "occurrence_state"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string"
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tool",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "agent": {
                  "type": "string",
                  "minLength": 1
                },
                "cached": {
                  "type": "boolean",
                  "description": "True when the hypotheses were replayed from the agent result cache."
                }
              },
              "required": [
                "agent"
              ],
              "additionalProperties": false
            }
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "symbol_path": {
                "type": "string"
              },
              "occurrence_state": {
                "enum": [
                  "new",
                  "pre-existing",
                  "fixed",
                  "unclassified"
                ]
              },
              "id": {
                "description": "Identity of the instance finding when this location belongs to a class-level finding.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "line_start",
              "line_end",
              "symbol_path",
              "occurrence_state"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "advisory": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "severity": {
              "enum": [
                "critical",
                "high",
                "moderate",
                "low",
                "unknown"
              ]
            },
            "fixed_version": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "required": [
            "id",
            "aliases",
            "severity",
            "fixed_version",
            "url"
          ],
          "additionalProperties": false
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "first_posted_in": {
          "type": "string",
          "minLength": 1
        },
        "author_response": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "fixed",
                "wrong",
                "intentional",
                "irrelevant",
                "style"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "actor",
            "at"
          ],
          "additionalProperties": false
        },
        "status": {
          "description": "Lifecycle of a posted lineage finding, independent of regression state.",
          "enum": [
            "open",
            "fixed",
            "dismissed"
          ]
        },
        "resolution": {
          "description": "How the lifecycle status was reached: the head that fixed the finding, or why it stayed open.",
          "type": "object",
          "properties": {
            "fixed_in": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "voters": {
              "type": "integer",
              "minimum": 1
            },
            "agreeing": {
              "type": "integer",
              "minimum": 0
            },
            "blind_match": {
              "type": "array",
              "items": {
                "enum": [
                  "same",
                  "related",
                  "none"
                ]
              }
            },
            "split": {
              "type": "boolean"
            }
          },
          "required": [
            "voters",
            "agreeing",
            "blind_match",
            "split"
          ],
          "additionalProperties": false,
          "description": "Semantic invariant: agreeing <= voters and blind_match contains one entry per configured voter; enforced by Rio deserialization and runtime validation."
        },
        "history": {
          "description": "Earlier record of this identity in the repository's finding registry; present only when one exists. Never consulted by state, status or fail policies.",
          "type": "object",
          "properties": {
            "first_seen": {
              "type": "string",
              "minLength": 1,
              "description": "Review id that first produced the identity in the repository."
            },
            "last_seen": {
              "type": "string",
              "minLength": 1,
              "description": "Review id that last produced the identity before this review."
            },
            "seen_count": {
              "type": "integer",
              "minimum": 1
            },
            "previous_status": {
              "enum": [
                "open",
                "fixed",
                "dismissed"
              ]
            },
            "previous_response": {
              "type": "object",
              "properties": {
                "reason": {
                  "enum": [
                    "fixed",
                    "wrong",
                    "intentional",
                    "irrelevant",
                    "style"
                  ]
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "actor",
                "at"
              ],
              "additionalProperties": false
            },
            "dismissed_in": {
              "type": "string",
              "minLength": 1,
              "description": "Review id or pull request reference where the identity was dismissed."
            }
          },
          "required": [
            "first_seen",
            "last_seen",
            "seen_count",
            "previous_status"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "rule_id",
        "category",
        "evidence_level",
        "severity",
        "state",
        "location",
        "message",
        "trigger",
        "evidence",
        "source",
        "locations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_id": {
                "pattern": "^dependency/"
              }
            }
          },
          "then": {
            "required": [
              "advisory"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "typecheck",
            "lint",
            "secrets",
            "coverage",
            "dependencies"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            "base",
            "head"
          ]
        },
        "scheduled_as": {
          "enum": [
            "changed",
            "dependent"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "findings",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "dependency_state": {
          "enum": [
            "verified",
            "trusted"
          ]
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "cached": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "language",
        "root",
        "version",
        "scheduled_as",
        "outcome",
        "wall_time_ms",
        "findings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "spawn_failed",
                  "tool_crashed",
                  "tool_config_error",
                  "unparseable_output",
                  "output_limit",
                  "disk_full",
                  "tests_failed",
                  "network_error",
                  "partial_data"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "tool_missing",
                  "no_project_config",
                  "not_supported_by_adapter",
                  "disabled",
                  "offline",
                  "dependency_mismatch",
                  "no_tests",
                  "nothing_to_audit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "timeout",
                  "interrupted"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "passed",
                  "findings"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
