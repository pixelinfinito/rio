{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rio.dev/schemas/report-v1.json",
  "title": "Rio report v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rio-report-v1"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "partial",
        "no_changes",
        "error"
      ]
    },
    "review": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "working-tree",
            "staged",
            "branch"
          ]
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rio_version": {
          "type": "string",
          "minLength": 1
        },
        "pull_request": {
          "description": "Pull request metadata recorded by the endpoint for PR-mode reviews.",
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "author": {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "user",
                    "bot"
                  ]
                }
              },
              "required": [
                "login",
                "type"
              ],
              "additionalProperties": false
            },
            "fork": {
              "type": "boolean"
            },
            "agent": {
              "description": "Agent attribution the host exposes: a bot author or a recognized commit trailer.",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "bot_author",
                    "commit_trailer"
                  ]
                }
              },
              "required": [
                "name",
                "source"
              ],
              "additionalProperties": false
            },
            "trigger": {
              "enum": [
                "webhook",
                "cli",
                "command"
              ]
            }
          },
          "required": [
            "repository",
            "number",
            "base_sha",
            "head_sha",
            "author",
            "fork",
            "trigger"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rio_version"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "symbol_path": {
                "type": "string"
              },
              "references_per_hop": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "test_referenced": {
                "type": "boolean"
              },
              "unresolved": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "symbol_path",
              "references_per_hop",
              "test_referenced",
              "unresolved"
            ],
            "additionalProperties": false
          }
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "symbols",
        "unresolved",
        "truncated"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "incomplete": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "const": "no_endpoint"
          }
        },
        "required": [
          "step",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "pre_existing": {
          "type": "integer",
          "minimum": 0
        },
        "fixed": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pre_existing",
        "fixed",
        "suppressed"
      ],
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suppressions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry": {
                "type": "integer",
                "minimum": 0
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "entry",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "notes",
        "suppressions",
        "tool_versions"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "typecheck",
                  "lint",
                  "secrets",
                  "coverage",
                  "dependencies"
                ]
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "enum": [
                  "base",
                  "head"
                ]
              },
              "wall_time_ms": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "kind",
              "root",
              "version",
              "wall_time_ms"
            ],
            "additionalProperties": false
          }
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "wall_time_ms",
        "checks",
        "tool_versions"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "risk_tier": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "tier": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "source": {
              "enum": [
                "always_human",
                "triage"
              ]
            }
          },
          "required": [
            "tier",
            "reasons",
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "agent_audit": {
      "type": "object",
      "additionalProperties": true
    },
    "lineage": {
      "description": "Present only for reviews that belong to a review lineage (PR or --since-last branch).",
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "pr",
            "branch"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "cap": {
          "type": "integer",
          "minimum": 1
        },
        "capped": {
          "type": "boolean"
        },
        "diff_only": {
          "type": "boolean"
        },
        "previous_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "held_back": {
          "type": "integer",
          "minimum": 0
        },
        "rounds_to_pass": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "author_response_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reconsider": {
          "type": "object",
          "properties": {
            "unresolved": {
              "type": "integer",
              "minimum": 0
            },
            "top": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "title",
                  "path",
                  "line_start"
                ],
                "additionalProperties": false
              }
            },
            "split": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "unresolved",
            "top"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repository",
        "kind",
        "ref",
        "generation",
        "round",
        "cap",
        "capped",
        "diff_only",
        "previous_head",
        "held_back",
        "rounds_to_pass",
        "author_response_ratio"
      ],
      "additionalProperties": false
    },
    "publication": {
      "description": "Present when a publication step ran.",
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "never",
            "ask",
            "auto"
          ]
        },
        "posted": {
          "type": "integer",
          "minimum": 0
        },
        "edited": {
          "type": "integer",
          "minimum": 0
        },
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unanchored": {
          "type": "integer",
          "minimum": 0
        },
        "check_run_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary_comment_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Why nothing, or only the check run, was published.",
          "enum": [
            "policy_never",
            "ask_without_consent",
            "fork_not_escalated",
            "no_installation"
          ]
        },
        "failures": {
          "description": "Items the host rejected; each is retried on the next round of the lineage.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "finding",
                  "summary",
                  "check_run"
                ]
              },
              "error": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "policy",
        "posted",
        "edited",
        "resolved",
        "failed",
        "unanchored",
        "check_run_url",
        "summary_comment_url"
      ],
      "additionalProperties": false
    },
    "cache": {
      "description": "Agent result cache use; present when the agents step ran.",
      "type": "object",
      "properties": {
        "lookups": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "type": "integer",
          "minimum": 0
        },
        "hit_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "tokens_saved_estimate": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "lookups",
        "hits",
        "hit_rate",
        "tokens_saved_estimate"
      ],
      "additionalProperties": false
    },
    "suppression_proposals": {
      "description": "Open suppression proposals for the repository.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "evidence_count": {
            "type": "integer",
            "minimum": 1
          },
          "since": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "entry",
          "evidence_count",
          "since"
        ],
        "additionalProperties": false
      }
    },
    "remembered": {
      "description": "Findings removed from the main sections as remembered dismissals: the repository registry records them dismissed intentional, irrelevant or style on an unchanged enclosing symbol. Each carries its history block; never consulted by fail policies.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "security_coverage": {
      "description": "Catalog coverage of the security step; present when the security step ran.",
      "type": "object",
      "properties": {
        "catalog": {
          "enum": [
            "owasp-top10-2025",
            "asvs-5.0"
          ]
        },
        "assessed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "item",
              "title",
              "findings"
            ],
            "additionalProperties": false
          }
        },
        "unassessed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "budget",
                  "no_evidence",
                  "tools_unavailable"
                ]
              }
            },
            "required": [
              "item",
              "title",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "not_applicable": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "item",
              "title"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "catalog",
        "assessed",
        "unassessed",
        "not_applicable"
      ],
      "additionalProperties": false
    },
    "council": {
      "description": "Council coverage and cost; present only when the council step ran.",
      "type": "object",
      "properties": {
        "councilled": {
          "type": "integer",
          "minimum": 0
        },
        "not_councilled": {
          "description": "Selected findings not councilled because of max_findings.",
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "complete",
                  "partial",
                  "skipped"
                ]
              },
              "answered": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 1
              },
              "cost": {
                "type": "object",
                "properties": {
                  "members": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rounds": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "experiments": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "tokens": {
                    "description": "Model tokens by vendor.",
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "runner_seconds": {
                    "description": "Whole runner seconds, rounded up.",
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "members",
                  "rounds",
                  "experiments",
                  "tokens",
                  "runner_seconds"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "status",
              "answered",
              "total",
              "cost"
            ],
            "additionalProperties": false
          }
        },
        "total": {
          "type": "object",
          "properties": {
            "members": {
              "type": "integer",
              "minimum": 0
            },
            "rounds": {
              "type": "integer",
              "minimum": 0
            },
            "experiments": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "description": "Model tokens by vendor.",
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "runner_seconds": {
              "description": "Whole runner seconds, rounded up.",
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "members",
            "rounds",
            "experiments",
            "tokens",
            "runner_seconds"
          ],
          "additionalProperties": false
        },
        "refuted": {
          "description": "Councilled findings the council refuted; they are not open findings and are listed here with the cited protection.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "held": {
          "description": "Councilled findings that presentation floors or caps keep out of the findings lists; listed with their council result and never evaluated by fail policies.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "required": [
        "councilled",
        "not_councilled",
        "findings",
        "total"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "status",
    "review",
    "checks",
    "impact",
    "findings",
    "risks",
    "incomplete",
    "deferred",
    "excluded",
    "metrics",
    "summary",
    "footer"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "defect",
            "risk",
            "security"
          ]
        },
        "evidence_level": {
          "enum": [
            "reproduced",
            "static_proven",
            "plausible",
            "refuted"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "state": {
          "enum": [
            "new",
            "worsened",
            "pre-existing",
            "fixed",
            "unclassified"
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "line_start": {
              "type": "integer",
              "minimum": 1
            },
            "line_end": {
              "type": "integer",
              "minimum": 1
            },
            "column": {
              "type": "integer",
              "minimum": 1
            },
            "symbol_path": {
              "type": "string"
            },
            "occurrence_state": {
              "enum": [
                "new",
                "pre-existing",
                "fixed",
                "unclassified"
              ]
            }
          },
          "required": [
            "path",
            "line_start",
            "line_end",
            "symbol_path",
            "occurrence_state"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string"
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "suggested_fix": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "tool",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "agent": {
                  "type": "string",
                  "minLength": 1
                },
                "cached": {
                  "type": "boolean",
                  "description": "True when the hypotheses were replayed from the agent result cache."
                }
              },
              "required": [
                "agent"
              ],
              "additionalProperties": false
            }
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              },
              "line_start": {
                "type": "integer",
                "minimum": 1
              },
              "line_end": {
                "type": "integer",
                "minimum": 1
              },
              "column": {
                "type": "integer",
                "minimum": 1
              },
              "symbol_path": {
                "type": "string"
              },
              "occurrence_state": {
                "enum": [
                  "new",
                  "pre-existing",
                  "fixed",
                  "unclassified"
                ]
              },
              "id": {
                "description": "Identity of the instance finding when this location belongs to a class-level finding.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "line_start",
              "line_end",
              "symbol_path",
              "occurrence_state"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "advisory": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "aliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "severity": {
              "enum": [
                "critical",
                "high",
                "moderate",
                "low",
                "unknown"
              ]
            },
            "fixed_version": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "required": [
            "id",
            "aliases",
            "severity",
            "fixed_version",
            "url"
          ],
          "additionalProperties": false
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "first_posted_in": {
          "type": "string",
          "minLength": 1
        },
        "author_response": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "fixed",
                "wrong",
                "intentional",
                "irrelevant",
                "style"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "reason",
            "actor",
            "at"
          ],
          "additionalProperties": false
        },
        "status": {
          "description": "Lifecycle of a posted lineage finding, independent of regression state.",
          "enum": [
            "open",
            "fixed",
            "dismissed"
          ]
        },
        "resolution": {
          "description": "How the lifecycle status was reached: the head that fixed the finding, or why it stayed open.",
          "type": "object",
          "properties": {
            "fixed_in": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "voters": {
              "type": "integer",
              "minimum": 1
            },
            "agreeing": {
              "type": "integer",
              "minimum": 0
            },
            "blind_match": {
              "type": "array",
              "items": {
                "enum": [
                  "same",
                  "related",
                  "none"
                ]
              }
            },
            "split": {
              "type": "boolean"
            }
          },
          "required": [
            "voters",
            "agreeing",
            "blind_match",
            "split"
          ],
          "additionalProperties": false,
          "description": "Semantic invariant: agreeing <= voters and blind_match contains one entry per configured voter; enforced by Rio deserialization and runtime validation."
        },
        "history": {
          "description": "Earlier record of this identity in the repository's finding registry; present only when one exists. Never consulted by state, status or fail policies.",
          "type": "object",
          "properties": {
            "first_seen": {
              "type": "string",
              "minLength": 1,
              "description": "Review id that first produced the identity in the repository."
            },
            "last_seen": {
              "type": "string",
              "minLength": 1,
              "description": "Review id that last produced the identity before this review."
            },
            "seen_count": {
              "type": "integer",
              "minimum": 1
            },
            "previous_status": {
              "enum": [
                "open",
                "fixed",
                "dismissed"
              ]
            },
            "previous_response": {
              "type": "object",
              "properties": {
                "reason": {
                  "enum": [
                    "fixed",
                    "wrong",
                    "intentional",
                    "irrelevant",
                    "style"
                  ]
                },
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "actor",
                "at"
              ],
              "additionalProperties": false
            },
            "dismissed_in": {
              "type": "string",
              "minLength": 1,
              "description": "Review id or pull request reference where the identity was dismissed."
            },
            "fixed_in": {
              "type": "string",
              "minLength": 1,
              "description": "Review id that recorded the identity fixed; present when previous_status is fixed, so a recurrence reads as a regression of that fix."
            }
          },
          "required": [
            "first_seen",
            "last_seen",
            "seen_count",
            "previous_status"
          ],
          "additionalProperties": false
        },
        "council": {
          "description": "Council review of the finding; present only when the council reviewed it. Never carries a numeric confidence.",
          "type": "object",
          "properties": {
            "decision": {
              "enum": [
                "reproduced",
                "refuted",
                "plausible"
              ]
            },
            "tier": {
              "enum": [
                "experiment",
                "protection",
                "judgment"
              ]
            },
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "skeptic",
                      "exploit-author",
                      "code-owner",
                      "maintainer",
                      "tester"
                    ]
                  },
                  "abstained": {
                    "type": "boolean"
                  },
                  "cause": {
                    "description": "Why the member abstained or did not take part.",
                    "enum": [
                      "invalid",
                      "no_evidence_refs",
                      "timeout",
                      "vendor_error",
                      "budget",
                      "excluded",
                      "unavailable"
                    ]
                  }
                },
                "required": [
                  "role",
                  "abstained"
                ],
                "additionalProperties": false
              }
            },
            "experiments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "version": {
                    "enum": [
                      "base",
                      "head",
                      "both"
                    ]
                  },
                  "expect": {
                    "enum": [
                      "fails",
                      "passes",
                      "output_contains"
                    ]
                  },
                  "run": {
                    "type": "boolean"
                  },
                  "reason": {
                    "description": "Why the experiment did not run.",
                    "enum": [
                      "fork",
                      "cap",
                      "runner_unavailable"
                    ]
                  },
                  "outcome": {
                    "description": "Exit outcome per version that ran.",
                    "type": "object",
                    "properties": {
                      "base": {
                        "enum": [
                          "passed",
                          "failed"
                        ]
                      },
                      "head": {
                        "enum": [
                          "passed",
                          "failed"
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "artifact": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "command",
                  "version",
                  "expect",
                  "run"
                ],
                "additionalProperties": false
              }
            },
            "note": {
              "description": "Positions by basis and dissent, in words; never percentages.",
              "type": "string",
              "minLength": 1
            },
            "protection": {
              "description": "Artifact reference of the protection a `refuted` decision cites.",
              "type": "string",
              "minLength": 1
            },
            "partial": {
              "type": "boolean"
            },
            "skipped": {
              "description": "Fewer than min_members answered; the finding keeps its verifier result.",
              "type": "boolean"
            },
            "answered": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "static_only": {
              "description": "Fork pull request: no runnable artifacts and no experiments.",
              "type": "boolean"
            },
            "weight_category": {
              "description": "The category member weights were looked up under; evaluation estimates them under the same.",
              "enum": [
                "defect",
                "risk",
                "security"
              ]
            },
            "author_family": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "applied",
                    "not_applicable"
                  ]
                },
                "family": {
                  "type": "string",
                  "minLength": 1
                },
                "substituted": {
                  "description": "Members of the author's family replaced by an allowlisted vendor of another family.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "enum": [
                          "skeptic",
                          "exploit-author",
                          "code-owner",
                          "maintainer",
                          "tester"
                        ]
                      },
                      "vendor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "family": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "role",
                      "vendor",
                      "family"
                    ],
                    "additionalProperties": false
                  }
                },
                "dropped": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "skeptic",
                      "exploit-author",
                      "code-owner",
                      "maintainer",
                      "tester"
                    ]
                  }
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "skeptic",
                      "exploit-author",
                      "code-owner",
                      "maintainer",
                      "tester"
                    ]
                  },
                  "vendor": {
                    "type": "string",
                    "minLength": 1
                  },
                  "denied_by": {
                    "enum": [
                      "profile",
                      "repository",
                      "runner"
                    ]
                  }
                },
                "required": [
                  "role",
                  "vendor",
                  "denied_by"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "members",
            "experiments",
            "partial",
            "answered",
            "total"
          ],
          "additionalProperties": false,
          "if": {
            "properties": {
              "skipped": {
                "const": true
              }
            },
            "required": [
              "skipped"
            ]
          },
          "else": {
            "required": [
              "decision",
              "tier",
              "note"
            ]
          }
        }
      },
      "required": [
        "id",
        "rule_id",
        "category",
        "evidence_level",
        "severity",
        "state",
        "location",
        "message",
        "trigger",
        "evidence",
        "source",
        "locations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "rule_id": {
                "pattern": "^dependency/"
              }
            }
          },
          "then": {
            "required": [
              "advisory"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "typecheck",
            "lint",
            "secrets",
            "coverage",
            "dependencies"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "enum": [
            "base",
            "head"
          ]
        },
        "scheduled_as": {
          "enum": [
            "changed",
            "dependent"
          ]
        },
        "outcome": {
          "enum": [
            "passed",
            "findings",
            "failed",
            "skipped",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "dependency_state": {
          "enum": [
            "verified",
            "trusted"
          ]
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "cached": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "language",
        "root",
        "version",
        "scheduled_as",
        "outcome",
        "wall_time_ms",
        "findings"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "spawn_failed",
                  "tool_crashed",
                  "tool_config_error",
                  "unparseable_output",
                  "output_limit",
                  "disk_full",
                  "tests_failed",
                  "network_error",
                  "partial_data"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "skipped"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "tool_missing",
                  "no_project_config",
                  "not_supported_by_adapter",
                  "disabled",
                  "offline",
                  "dependency_mismatch",
                  "no_tests",
                  "nothing_to_audit"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "enum": [
                  "timeout",
                  "interrupted"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "passed",
                  "findings"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
