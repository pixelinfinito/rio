; Type-only declarations deliberately have no captures.
[
  (expression_statement)
  (return_statement)
  (throw_statement)
  (if_statement)
  (for_statement)
  (for_in_statement)
  (while_statement)
  (do_statement)
  (switch_statement)
  (try_statement)
  (variable_declarator value: (_))
] @executable
