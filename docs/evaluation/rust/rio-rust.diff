+    for (_, value, _) in &values {
+        assert!(!stored.contains(value));
+    }
+    let padded = format!("{}\n{}\n{}", "あ".repeat(100), raw, "え".repeat(100));
+    let stored = retained_raw(padded.as_bytes(), 128);
