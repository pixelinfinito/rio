+pub(super) fn normalize_relative(base: &str, relative: &str) -> String {
+    let mut parts = Vec::new();
+    for part in base.split('/').chain(relative.split('/')) {
+        match part {
+            "" | "." => {}
+            ".." => {
+                parts.pop();
+            }
+            _ => parts.push(part),
+        }
+    }
+    if parts.is_empty() {
+        ".".into()
+    } else {
+        parts.join("/")
+    }
+}
+
+fn marker(value: &Value) -> Option<String> {
+    value["marker"]
+        .as_str()
+        .or_else(|| value["markers"].as_str())
+        .map(str::to_owned)
+}
+
+/// Poetry's caret/tilde ranges are converted to PEP 440 bounds before matching
+/// lockfile alternatives. Ordinary PEP 440 clauses and unions are preserved.
+pub(super) fn poetry_specifiers(input: &str) -> Result<Vec<pep440_rs::VersionSpecifiers>> {
+    input
+        .split("||")
+        .map(|branch| {
+            let branch = branch.trim();
+            let converted = if branch == "*" {
+                String::new()
+            } else if branch.starts_with(['^', '~']) && !branch.starts_with("~=") {
+                let parts: Vec<u64> = branch[1..]
+                    .split('.')
+                    .map(str::parse)
+                    .collect::<std::result::Result<_, _>>()?;
+                let mut upper = parts.clone();
+                let index = if branch.starts_with('^') {
+                    parts
+                        .iter()
+                        .position(|&part| part != 0)
+                        .unwrap_or(parts.len().saturating_sub(1))
+                } else {
+                    if parts.len() > 1 { 1 } else { 0 }
+                };
+                upper[index] = upper[index]
+                    .checked_add(1)
+                    .context("Poetry version bound is out of range")?;
+                for part in &mut upper[index + 1..] {
+                    *part = 0;
+                }
+                format!(
+                    ">={},<{}",
+                    &branch[1..],
+                    upper
+                        .iter()
+                        .map(ToString::to_string)
+                        .collect::<Vec<_>>()
+                        .join(".")
+                )
+            } else if branch.starts_with(|c: char| c.is_ascii_digit()) {
+                format!("=={branch}")
+            } else {
+                branch.into()
+            };
+            Ok(pep440_rs::VersionSpecifiers::from_str(&converted)?)
+        })
+        .collect()
+}
+
+fn location(name: &str, version: &str, count: usize) -> String {
+    if count > 1 {
+        format!("{name}=={version}")
+    } else {
+        name.into()
+    }
+}
+
+fn find_targets(graph: &DependencyGraph, name: &str, exact: Option<&str>) -> Vec<String> {
+    let name = normalize_python_name(name);
+    graph
+        .nodes
+        .values()
+        .filter(|node| node.name == name && exact.is_none_or(|version| version == node.version))
+        .map(|node| node.location.clone())
+        .collect()
+}
+
+fn uv_edges(
+    graph: &mut DependencyGraph,
+    dependencies: &Value,
+    group: Option<&str>,
+    extra: Option<&str>,
+) -> Vec<DependencyEdge> {
+    let mut edges = Vec::new();
+    if let Some(dependencies) = dependencies.as_array() {
+        for dependency in dependencies {
+            let Some(name) = dependency["name"].as_str() else {
+                graph.unverified("uv dependency has no name");
+                continue;
+            };
+            let targets = find_targets(graph, name, dependency["version"].as_str());
+            if targets.is_empty() {
+                graph.unverified(format!("unresolved uv dependency {name}"));
+            }
+            for target in targets {
+                edges.push(DependencyEdge {
+                    name: normalize_python_name(name),
+                    target,
+                    marker: marker(dependency),
+                    requested_extras: strings(&dependency["extra"]).into_iter().collect(),
+                    group: group.map(str::to_owned),
+                    extra: extra.map(str::to_owned),
+                    dev: group == Some("dev"),
+                    optional: extra.is_some(),
+                    ..Default::default()
+                });
+            }
+        }
+    }
+    edges
+}
+
+fn uv(value: &Value) -> Result<DependencyGraph> {
+    let packages = value["package"]
+        .as_array()
+        .context("uv.lock has no package entries")?;
+    let mut graph = DependencyGraph::new("uv");
+    for package in packages {
+        let name =
+            normalize_python_name(package["name"].as_str().context("uv package has no name")?);
+        let version = package["version"].as_str().unwrap_or_default();
+        let count = packages
+            .iter()
+            .filter(|other| {
+                other["name"]
+                    .as_str()
+                    .is_some_and(|other| normalize_python_name(other) == name)
+            })
+            .count();
+        let key = location(&name, version, count);
+        let mut entry = node(key.clone(), name, version.into(), Ecosystem::PyPi);
+        entry.flags.markers = match package["resolution-markers"].as_array() {
+            Some(markers) => Some(
+                markers
+                    .iter()
+                    .filter_map(Value::as_str)
+                    .map(|marker| format!("({marker})"))
+                    .collect::<Vec<_>>()
+                    .join(" or "),
+            ),
+            None => marker(package),
+        };
+        entry.link = package["source"]["editable"]
+            .as_str()
+            .or_else(|| package["source"]["virtual"].as_str())
+            .or_else(|| package["source"]["directory"].as_str())
+            .map(str::to_owned);
+        graph.nodes.insert(key, entry);
+    }
+    for package in packages {
+        let name = normalize_python_name(package["name"].as_str().unwrap());
+        let key = find_targets(&graph, &name, package["version"].as_str())[0].clone();
+        let mut edges = uv_edges(&mut graph, &package["dependencies"], None, None);
+        for (field, extras) in [("dev-dependencies", false), ("optional-dependencies", true)] {
+            if let Some(groups) = package[field].as_object() {
+                for (group, dependencies) in groups {
+                    edges.extend(uv_edges(
+                        &mut graph,
+                        dependencies,
+                        (!extras).then_some(group.as_str()),
+                        extras.then_some(group.as_str()),
+                    ));
+                }
+            }
+        }
+        let entry = graph.nodes.get_mut(&key).unwrap();
+        entry.dependencies = edges
+            .iter()
+            .filter(|edge| edge.group.is_none())
+            .cloned()
+            .collect();
+        if let Some(root) = &entry.link {
+            graph.importers.insert(
+                root.clone(),
+                Importer {
+                    dependencies: edges,
+                },
+            );
+        }
+    }
+    // Without a project package (an environment lock), every package is a root.
+    if graph.importers.is_empty() {
+        graph.importers.insert(
+            ".".into(),
+            Importer {
+                dependencies: graph
+                    .nodes
+                    .values()
+                    .map(|node| DependencyEdge {
+                        name: node.name.clone(),
+                        target: node.location.clone(),
+                        ..Default::default()
+                    })
+                    .collect(),
+            },
+        );
+    }
+    Ok(graph)
+}
+
+fn poetry(value: &Value) -> Result<DependencyGraph> {
+    let packages = value["package"]
+        .as_array()
+        .context("poetry.lock has no packages")?;
+    let mut graph = DependencyGraph::new("poetry");
+    for package in packages {
+        let name = normalize_python_name(
+            package["name"]
+                .as_str()
+                .context("poetry package has no name")?,
+        );
+        let version = package["version"]
+            .as_str()
+            .context("poetry package has no version")?;
+        let count = packages
+            .iter()
+            .filter(|other| {
+                other["name"]
+                    .as_str()
+                    .is_some_and(|other| normalize_python_name(other) == name)
+            })
+            .count();
+        let key = location(&name, version, count);
+        let mut entry = node(key.clone(), name, version.into(), Ecosystem::PyPi);
+        entry.flags.optional = package["optional"].as_bool().unwrap_or(false);
+        entry.flags.groups = strings(&package["groups"]).into_iter().collect();
+        if entry.flags.groups.is_empty() {
+            entry
+                .flags
+                .groups
+                .insert(package["category"].as_str().unwrap_or("main").into());
+        }
+        entry.flags.dev = entry.flags.groups.len() == 1 && entry.flags.groups.contains("dev");
+        entry.flags.markers = marker(package);
+        if let Some(markers) = package["markers"].as_object() {
+            for (group, marker) in markers {
+                entry.flags.group_markers.insert(
+                    group.clone(),
+                    marker
+                        .as_str()
+                        .context("Poetry group marker is not a string")?
+                        .into(),
+                );
+            }
+        }
+        entry.flags.python = package["python-versions"]
+            .as_str()
+            .filter(|&version| version != "*")
+            .map(str::to_owned);
+        if package["source"]["type"].as_str() == Some("directory") {
+            entry.link = package["source"]["url"].as_str().map(str::to_owned);
+        }
+        graph.nodes.insert(key, entry);
+    }
+    for package in packages {
+        let key = find_targets(
+            &graph,
+            package["name"].as_str().unwrap(),
+            package["version"].as_str(),
+        )[0]
+        .clone();
+        let mut edges = Vec::new();
+        if let Some(dependencies) = package["dependencies"].as_object() {
+            for (name, requirement) in dependencies {
+                let variants = requirement
+                    .as_array()
+                    .cloned()
+                    .unwrap_or_else(|| vec![requirement.clone()]);
+                for variant in variants {
+                    let version = variant
+                        .as_str()
+                        .or_else(|| variant["version"].as_str())
+                        .unwrap_or("*");
+                    let constraints = poetry_specifiers(version)?;
+                    let targets = find_targets(&graph, name, None)
+                        .into_iter()
+                        .filter(|location| {
+                            pep440_rs::Version::from_str(&graph.nodes[location].version).is_ok_and(
+                                |version| {
+                                    constraints
+                                        .iter()
+                                        .any(|specifiers| specifiers.contains(&version))
+                                },
+                            )
+                        })
+                        .collect::<Vec<_>>();
+                    if targets.is_empty() {
+                        graph.unverified(format!("unresolved poetry dependency {name}"));
+                    }
+                    for target in targets {
+                        edges.push(DependencyEdge {
+                            name: normalize_python_name(name),
+                            target,
+                            optional: variant["optional"].as_bool().unwrap_or(false),
+                            marker: marker(&variant),
+                            requested_extras: strings(&variant["extras"]).into_iter().collect(),
+                            ..Default::default()
+                        });
+                    }
+                }
+            }
+        }
+        graph.nodes.get_mut(&key).unwrap().dependencies = edges;
+    }
+    if let Some(extras) = value["extras"].as_object() {
+        for (extra, names) in extras {
+            for name in strings(names) {
+                let name = name.split_whitespace().next().unwrap_or_default();
+                for target in find_targets(&graph, name, None) {
+                    graph
+                        .nodes
+                        .get_mut(&target)
+                        .unwrap()
+                        .flags
+                        .extras
+                        .insert(extra.clone());
+                }
+            }
+        }
+    }
+    graph.importers.insert(
+        ".".into(),
+        Importer {
+            dependencies: graph
+                .nodes
+                .values()
+                .map(|node| DependencyEdge {
+                    name: node.name.clone(),
+                    target: node.location.clone(),
+                    optional: node.flags.optional,
+                    dev: node.flags.dev,
+                    ..Default::default()
+                })
+                .collect(),
+        },
+    );
+    Ok(graph)
+}
+
+fn pipfile(value: &Value) -> Result<DependencyGraph> {
+    let mut graph = DependencyGraph::new("pipfile");
+    let mut edges = Vec::new();
+    for (section, dev) in [("default", false), ("develop", true)] {
+        if let Some(packages) = value[section].as_object() {
+            for (name, package) in packages {
+                let name = normalize_python_name(name);
+                let mut entry = node(name.clone(), name.clone(), String::new(), Ecosystem::PyPi);
+                if let Some(version) = package["version"]
+                    .as_str()
+                    .and_then(|value| value.strip_prefix("=="))
+                {
+                    if version.contains('*') {
+                        graph.unverified(format!("{name} has no exact pin"));
+                    } else {
+                        entry.version = version.into();
+                    }
+                } else {
+                    graph.unverified(format!("{name} has no exact pin"));
+                }
+                entry.flags.dev = dev;
+                entry
+                    .flags
+                    .groups
+                    .insert(if dev { "dev".into() } else { "main".into() });
+                entry.flags.markers = marker(package);
+
+                entry.link = package["path"].as_str().map(str::to_owned);
+                edges.push(DependencyEdge {
+                    name: name.clone(),
+                    target: name.clone(),
+                    dev,
+                    requested_extras: strings(&package["extras"]).into_iter().collect(),
+                    ..Default::default()
+                });
+                graph.nodes.insert(name, entry);
+            }
+        }
+    }
+    graph.importers.insert(
+        ".".into(),
+        Importer {
+            dependencies: edges,
+        },
+    );
+    Ok(graph)
+}
+
+pub(super) fn requirements(content: &str) -> Result<DependencyGraph> {
+    let mut graph = DependencyGraph::new("requirements");
+    let mut edges = Vec::new();
+    let content = content.replace("\\\r\n", " ").replace("\\\n", " ");
+    for line in content.lines() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        // Hashes and comments are not part of a PEP 508 requirement.
+        let text = line
+            .split(" --hash=")
+            .next()
+            .unwrap()
+            .split(" #")
+            .next()
+            .unwrap()
+            .trim();
+        if text.starts_with('-') {
+            graph.unverified(format!("unsupported requirements directive {text}"));
+            continue;
+        }
+        let requirement: Requirement =
+            Requirement::from_str(text).with_context(|| format!("invalid requirement {text}"))?;
+        let name = requirement.name.to_string();
+        let version = match &requirement.version_or_url {
+            Some(VersionOrUrl::VersionSpecifier(specifiers)) => {
+                let specifiers = specifiers.to_string();
+                specifiers
+                    .strip_prefix("==")
+                    .filter(|version| !version.contains(['*', ',']))
+                    .map(str::to_owned)
+            }
+            _ => None,
+        };
+        let Some(version) = version else {
+            graph.unverified(format!("{name} has no exact pin"));
+            continue;
+        };
+        let mut entry = node(name.clone(), name.clone(), version, Ecosystem::PyPi);
+        entry.flags.markers = requirement.marker.contents().map(|value| value.to_string());
+        let requested_extras = requirement
+            .extras
+            .iter()
+            .map(ToString::to_string)
+            .collect::<BTreeSet<_>>();
+        graph.nodes.insert(name.clone(), entry);
+        edges.push(DependencyEdge {
+            name: name.clone(),
+            target: name,
+            requested_extras,
+            ..Default::default()
+        });
+    }
+    graph.importers.insert(
+        ".".into(),
+        Importer {
+            dependencies: edges,
+        },
+    );
+    Ok(graph)
+}
+
+pub(super) fn parse(name: &str, content: &str) -> Result<DependencyGraph> {
+    let value: Value = if name == "Pipfile.lock" {
+        serde_json::from_str(content)?
+    } else {
+        serde_json::to_value(toml::from_str::<toml::Value>(content)?)?
+    };
+    match name {
+        "uv.lock" => uv(&value),
+        "poetry.lock" => poetry(&value),
+        "Pipfile.lock" => pipfile(&value),
+        _ => unreachable!(),
+    }
+}
+
+/// Poetry lockfiles record all resolved packages, while the project's manifest
+/// determines which packages are direct requests and how alternatives are used.
+pub(super) fn poetry_importer(graph: &mut DependencyGraph, manifest: &Value) -> Result<()> {
+    let mut edges = Vec::new();
+    let mut has_declarations = false;
+    let mut add_requirement = |text: &str,
+                               group: Option<&str>,
+                               extra: Option<&str>|
+     -> Result<()> {
+        let requirement: Requirement = Requirement::from_str(text)?;
+        let targets = find_targets(graph, requirement.name.as_ref(), None);
+        for target in targets {
+            let matches = match &requirement.version_or_url {
+                Some(VersionOrUrl::VersionSpecifier(specifiers)) => {
+                    pep440_rs::Version::from_str(&graph.nodes[&target].version)
+                        .is_ok_and(|version| specifiers.contains(&version))
+                }
+                _ => true,
+            };
+            if matches {
+                edges.push(DependencyEdge {
+                    name: requirement.name.to_string(),
+                    target,
+                    dev: group == Some("dev"),
+                    group: group.map(str::to_owned),
+                    extra: extra.map(str::to_owned),
+                    optional: extra.is_some(),
+                    marker: requirement
+                        .marker
+                        .contents()
+                        .map(|marker| marker.to_string()),
+                    requested_extras: requirement.extras.iter().map(ToString::to_string).collect(),
+                    ..Default::default()
+                });
+            }
+        }
+        Ok(())
+    };
+    if let Some(dependencies) = manifest["project"]["dependencies"].as_array() {
+        has_declarations = true;
+        for requirement in dependencies {
+            add_requirement(
+                requirement
+                    .as_str()
+                    .context("project dependency must be a string")?,
+                None,
+                None,
+            )?;
+        }
+    }
+    if let Some(extras) = manifest["project"]["optional-dependencies"].as_object() {
+        for (extra, requirements) in extras {
+            for requirement in requirements
+                .as_array()
+                .context("optional dependencies must be a list")?
+            {
+                add_requirement(
+                    requirement
+                        .as_str()
+                        .context("optional dependency must be a string")?,
+                    None,
+                    Some(extra),
+                )?;
+            }
+        }
+    }
+    if let Some(groups) = manifest["dependency-groups"].as_object() {
+        has_declarations = true;
+        for (group, requirements) in groups {
+            for requirement in requirements
+                .as_array()
+                .context("dependency group must be a list")?
+            {
+                if let Some(text) = requirement.as_str() {
+                    add_requirement(text, Some(group), None)?;
+                }
+            }
+        }
+    }
+    // Legacy Poetry syntax is a mapping with Poetry version constraints.
+    let mut maps = Vec::new();
+    if let Some(dependencies) = manifest["tool"]["poetry"]["dependencies"].as_object() {
+        has_declarations = true;
+        maps.push((None, dependencies));
+    }
+    if let Some(dependencies) = manifest["tool"]["poetry"]["dev-dependencies"].as_object() {
+        maps.push((Some("dev"), dependencies));
+    }
+    if let Some(groups) = manifest["tool"]["poetry"]["group"].as_object() {
+        for (group, value) in groups {
+            if let Some(dependencies) = value["dependencies"].as_object() {
+                maps.push((Some(group.as_str()), dependencies));
+            }
+        }
+    }
+    for (group, dependencies) in maps {
+        for (name, requirement) in dependencies {
+            if name == "python" {
+                continue;
+            }
+            let range = requirement
+                .as_str()
+                .or_else(|| requirement["version"].as_str())
+                .unwrap_or("*");
+            let specifiers = poetry_specifiers(range)?;
+            for target in find_targets(graph, name, None) {
+                if graph.nodes[&target].link.is_some()
+                    || pep440_rs::Version::from_str(&graph.nodes[&target].version).is_ok_and(
+                        |version| {
+                            specifiers
+                                .iter()
+                                .any(|specifier| specifier.contains(&version))
+                        },
+                    )
+                {
+                    edges.push(DependencyEdge {
+                        name: normalize_python_name(name),
+                        target,
+                        group: group.map(str::to_owned),
+                        dev: group == Some("dev"),
+                        optional: requirement["optional"].as_bool() == Some(true),
+                        marker: marker(requirement),
+                        requested_extras: strings(&requirement["extras"]).into_iter().collect(),
+                        ..Default::default()
+                    });
+                }
+            }
+        }
+    }
+    if has_declarations {
+        graph.importers.insert(
+            ".".into(),
+            Importer {
+                dependencies: edges,
+            },
+        );
+    }
+    Ok(())
+}
diff --git a/crates/rio-adapters/src/dependencies/remap.rs b/crates/rio-adapters/src/dependencies/remap.rs
new file mode 100644
index 0000000..49a1a13
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/remap.rs
@@ -0,0 +1,437 @@
+//! Private dependency overlays for base runs. Never write through an installation link.
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs,
+    path::{Path, PathBuf},
+};
+
+use anyhow::{Context, Result, bail, ensure};
+use rio_git::{DependencyLink, Tree, changed_paths};
+
+use crate::ToolCommand;
+
+/// Resolution changes owned by one disposable base tree.
+#[derive(Debug, Default)]
+pub struct BaseDependencyRemap {
+    pub packages: usize,
+    pub source_paths: BTreeMap<String, Vec<String>>,
+    pub unavailable: Vec<String>,
+    source_root: PathBuf,
+}
+
+impl BaseDependencyRemap {
+    /// Source aliases affect TypeScript only. Linters retain their normal
+    /// configuration and never execute a source file in place of built JS.
+    pub fn configure_typescript(&self, command: &mut ToolCommand) -> Result<()> {
+        ensure!(
+            self.unavailable.is_empty(),
+            "{}",
+            self.unavailable.join("; ")
+        );
+        super::source_entries::configure_typescript(command, &self.source_paths, &self.source_root)
+    }
+}
+
+/// Overlay installation directories inside an already disposable source tree.
+/// The installation's files remain shared, but directory entries and editable
+/// metadata belong exclusively to this invocation.
+pub fn remap_base_dependencies(
+    worktree: &Path,
+    destination: &Path,
+    links: &[DependencyLink],
+    working: &Tree,
+    base: &Tree,
+    stop: &dyn Fn() -> bool,
+) -> Result<BaseDependencyRemap> {
+    let worktree = worktree.canonicalize()?;
+    let changed = changed_paths(working, base);
+    let mut overlay = Overlay {
+        worktree: &worktree,
+        destination,
+        links,
+        changed: &changed,
+        remapped: BTreeSet::new(),
+        prepared: BTreeSet::new(),
+        mapped_sources: BTreeSet::new(),
+        required_editables: BTreeSet::new(),
+        base,
+        working,
+        resolution: BaseDependencyRemap {
+            source_root: destination.canonicalize()?,
+            ..Default::default()
+        },
+        stop,
+    };
+    for link in links {
+        let path = destination.join(&link.path);
+        // Tracked dependency directories take precedence, as in ToolTree.
+        if !fs::symlink_metadata(&path)?.file_type().is_symlink() {
+            continue;
+        }
+        remove_link(&path)?;
+        overlay.directory(&link.target, &path)?;
+    }
+    for target in &overlay.required_editables {
+        ensure!(
+            overlay
+                .mapped_sources
+                .iter()
+                .any(|mapped| mapped.starts_with(target) || target.starts_with(mapped)),
+            "linked dependency points at changed source {}; editable finder cannot be remapped",
+            target.display()
+        );
+    }
+    overlay.resolution.packages = overlay.remapped.len();
+    Ok(overlay.resolution)
+}
+
+struct Overlay<'a> {
+    worktree: &'a Path,
+    destination: &'a Path,
+    links: &'a [DependencyLink],
+    changed: &'a [String],
+    remapped: BTreeSet<PathBuf>,
+    prepared: BTreeSet<PathBuf>,
+    mapped_sources: BTreeSet<PathBuf>,
+    required_editables: BTreeSet<PathBuf>,
+    base: &'a Tree,
+    working: &'a Tree,
+    resolution: BaseDependencyRemap,
+    stop: &'a dyn Fn() -> bool,
+}
+
+impl Overlay<'_> {
+    fn target(&mut self, target: &Path) -> Result<PathBuf> {
+        if !target.starts_with(self.worktree) {
+            return Ok(target.into());
+        }
+        // Links within the installation (pnpm virtual store, .bin) must resolve
+        // through the overlay as well, including nested node_modules entries.
+        for link in self.links {
+            if let Ok(relative) = target.strip_prefix(&link.target) {
+                return Ok(self.destination.join(&link.path).join(relative));
+            }
+        }
+        let Ok(relative) = target.strip_prefix(self.worktree) else {
+            return Ok(target.into());
+        };
+        // editables.map_module can name __init__.py rather than its
+        // package directory. Any sibling module change affects that package.
+        let scope = if target.is_file() {
+            relative.parent().unwrap_or(relative)
+        } else {
+            relative
+        };
+        self.mapped_sources.insert(scope.into());
+        let prefix = scope.to_string_lossy().replace('\\', "/");
+        let prefix = if prefix.is_empty() {
+            prefix
+        } else {
+            format!("{prefix}/")
+        };
+        if self.changed.iter().any(|path| path.starts_with(&prefix)) {
+            ensure!(
+                self.destination.join(relative).exists(),
+                "linked dependency points at changed source {} that is absent from the base tree; cannot remap",
+                relative.display()
+            );
+            self.remapped.insert(scope.into());
+        }
+        if target.is_dir() && self.prepared.insert(relative.into()) {
+            self.remapped.insert(relative.into());
+            super::source_entries::prepare_package(
+                self.worktree,
+                self.destination,
+                relative,
+                self.working,
+                self.base,
+                &mut self.resolution,
+                self.stop,
+            )?;
+        }
+        Ok(self.destination.join(relative))
+    }
+
+    fn metadata(&mut self, source: &Path, destination: &Path) -> Result<bool> {
+        let name = source.file_name().unwrap_or_default().to_string_lossy();
+        let editable = name.ends_with(".pth")
+            || name.ends_with(".egg-link")
+            || ((name.starts_with("__editable__") || name.starts_with("_editable_impl_"))
+                && name.ends_with(".py"));
+        if name == "direct_url.json" {
+            let direct: serde_json::Value = serde_json::from_slice(&fs::read(source)?)?;
+            if direct["dir_info"]["editable"].as_bool() == Some(true)
+                && let Some(url) = direct["url"]
+                    .as_str()
+                    .filter(|url| url.starts_with("file:"))
+            {
+                let target = pep508_rs::VerbatimUrl::parse_url(url)?
+                    .to_url()
+                    .to_file_path()
+                    .map_err(|_| anyhow::anyhow!("invalid editable file URL"))?
+                    .canonicalize()?;
+                if let Ok(relative) = target.strip_prefix(self.worktree) {
+                    let prefix = relative.to_string_lossy().replace('\\', "/");
+                    let prefix = if prefix.is_empty() {
+                        prefix
+                    } else {
+                        format!("{prefix}/")
+                    };
+                    if self.changed.iter().any(|path| path.starts_with(&prefix)) {
+                        self.required_editables.insert(relative.into());
+                    }
+                }
+            }
+        }
+        if !editable && name != "pyvenv.cfg" {
+            return Ok(false);
+        }
+        let text = fs::read_to_string(source)?;
+        let mut rewritten = text.clone();
+        if name.ends_with(".pth") || name.ends_with(".egg-link") {
+            let editable_modules =
+                regex::Regex::new(r"\b(?:__editable__|_editable_impl_)[A-Za-z0-9_]*\b")?;
+            let mut lines = Vec::new();
+            for (line_number, line) in text.lines().enumerate() {
+                if name.ends_with(".egg-link") && line_number > 0 {
+                    lines.push(line.to_owned());
+                    continue;
+                }
+                let trimmed = line.trim();
+                if trimmed.starts_with("import ") || trimmed.starts_with("import\t") {
+                    // A compiled or missing finder cannot be rewritten. Do not
+                    // let missing direct_url.json turn that into a silent pass.
+                    for module in editable_modules.find_iter(trimmed) {
+                        ensure!(
+                            source
+                                .parent()
+                                .unwrap()
+                                .join(format!("{}.py", module.as_str()))
+                                .is_file(),
+                            "linked dependency points at changed source; editable finder cannot be remapped: {}",
+                            module.as_str()
+                        );
+                    }
+                }
+                if trimmed.is_empty()
+                    || trimmed.starts_with('#')
+                    || trimmed.starts_with("import ")
+                    || trimmed.starts_with("import\t")
+                {
+                    lines.push(line.to_owned());
+                } else {
+                    let target = source.parent().unwrap().join(trimmed);
+                    if target.exists() {
+                        lines.push(
+                            self.target(&target.canonicalize()?)?
+                                .to_string_lossy()
+                                .into_owned(),
+                        );
+                    } else {
+                        lines.push(line.to_owned());
+                    }
+                }
+            }
+            rewritten = format!("{}\n", lines.join("\n"));
+            if name.ends_with(".egg-link")
+                && let Some(path) = lines.first()
+            {
+                fs::write(
+                    destination.with_extension("rio-base.pth"),
+                    format!("{path}\n"),
+                )?;
+            }
+        } else if editable {
+            // Supported PEP 660 finders store absolute paths as ordinary string
+            // literals (setuptools MAPPING/NAMESPACES and editables map_module).
+            // Rewrite literals only; never execute or interpret finder code.
+            let literals = regex::Regex::new(r#"['\"]([^'\"\r\n]+)['\"]"#)?;
+            let mut supported = false;
+            for capture in literals.captures_iter(&text) {
+                let literal = &capture[1];
+                let path = Path::new(literal);
+                if path.is_absolute() && path.exists() {
+                    supported = true;
+                    let mapped = self.target(&path.canonicalize()?)?;
+                    rewritten =
+                        rewritten.replace(&capture[0], &format!("{:?}", mapped.to_string_lossy()));
+                }
+            }
+            ensure!(
+                supported || self.changed.is_empty(),
+                "linked dependency points at changed source; editable finder cannot be remapped: {}",
+                source.display()
+            );
+            if rewritten
+                .replace(self.destination.to_string_lossy().as_ref(), "<base>")
+                .contains(self.worktree.to_string_lossy().as_ref())
+            {
+                bail!(
+                    "linked dependency points at changed source; editable finder {} cannot be remapped",
+                    source.display()
+                );
+            }
+        }
+        fs::write(destination, rewritten)?;
+        Ok(true)
+    }
+
+    fn directory(&mut self, source: &Path, destination: &Path) -> Result<()> {
+        fs::create_dir_all(destination)?;
+        for entry in fs::read_dir(source)? {
+            ensure!(!(self.stop)(), "timeout: dependency remapping stopped");
+            let entry = entry?;
+            let from = entry.path();
+            let to = destination.join(entry.file_name());
+            let kind = entry.file_type()?;
+            if kind.is_symlink() && from.is_file() && self.metadata(&from, &to)? {
+                continue;
+            }
+            if kind.is_symlink() {
+                let raw = fs::read_link(&from)?;
+                let target = match from.canonicalize() {
+                    Ok(target) => self.target(&target)?,
+                    Err(_) => {
+                        if raw.is_absolute() {
+                            raw
+                        } else {
+                            source.join(raw)
+                        }
+                    }
+                };
+                symlink(&target, &to)?;
+            } else if kind.is_dir() {
+                if entry.file_name() == "__pycache__" {
+                    continue;
+                }
+                self.directory(&from, &to)?;
+            } else if kind.is_file() && !self.metadata(&from, &to)? {
+                symlink(&from, &to)?;
+            }
+        }
+        Ok(())
+    }
+}
+
+/// Console scripts have an absolute shebang pointing to the original venv.
+/// Execute them with the private venv's interpreter so site processing reads
+/// only its rewritten editable metadata. Node keeps overlay module paths.
+pub fn configure_base_command(
+    command: &mut ToolCommand,
+    worktree: &Path,
+    destination: &Path,
+    links: &[DependencyLink],
+    tool_name: &str,
+) -> Result<()> {
+    let worktree = worktree.canonicalize()?;
+    let python_checker = matches!(tool_name, "mypy" | "pyright");
+    let environment_link = links
+        .iter()
+        .filter(|link| !link.path.ends_with("node_modules"))
+        .find(|link| command.program.starts_with(worktree.join(&link.path)))
+        .or_else(|| {
+            python_checker
+                .then(|| {
+                    links
+                        .iter()
+                        .filter(|link| !link.path.ends_with("node_modules"))
+                        .filter(|link| {
+                            destination
+                                .join(&link.path)
+                                .parent()
+                                .is_some_and(|parent| command.cwd.starts_with(parent))
+                        })
+                        .max_by_key(|link| link.path.len())
+                })
+                .flatten()
+        });
+    if let Some(link) = environment_link {
+        let original = worktree.join(&link.path);
+        let environment = destination.join(&link.path);
+        let interpreter = environment.join(if cfg!(windows) {
+            "Scripts/python.exe"
+        } else {
+            "bin/python"
+        });
+        command
+            .env
+            .insert("VIRTUAL_ENV".into(), environment.clone().into_os_string());
+        let paths =
+            std::iter::once(environment.join(if cfg!(windows) { "Scripts" } else { "bin" })).chain(
+                std::env::split_paths(&std::env::var_os("PATH").unwrap_or_default())
+                    .collect::<Vec<_>>(),
+            );
+        command
+            .env
+            .insert("PATH".into(), std::env::join_paths(paths)?);
+        if let Some(paths) = std::env::var_os("PYTHONPATH") {
+            let paths = std::env::split_paths(&paths).map(|path| {
+                let resolved = path.canonicalize().unwrap_or_else(|_| path.clone());
+                resolved
+                    .strip_prefix(&worktree)
+                    .map_or(path, |relative| destination.join(relative))
+            });
+            command
+                .env
+                .insert("PYTHONPATH".into(), std::env::join_paths(paths)?);
+        }
+        if let Ok(relative) = command.program.strip_prefix(&original) {
+            let program = environment.join(relative);
+            if fs::read(&command.program).is_ok_and(|bytes| bytes.starts_with(b"#!")) {
+                ensure!(
+                    interpreter.exists(),
+                    "editable installation interpreter cannot be remapped"
+                );
+                command.args.insert(0, program.into_os_string());
+                command.program = interpreter.clone();
+            } else {
+                command.program = program;
+            }
+        }
+        if python_checker {
+            ensure!(
+                interpreter.exists(),
+                "editable installation interpreter cannot be remapped"
+            );
+            command.args.extend([
+                if tool_name == "mypy" {
+                    "--python-executable"
+                } else {
+                    "--pythonpath"
+                }
+                .into(),
+                interpreter.into_os_string(),
+            ]);
+        }
+    } else {
+        ensure!(
+            !python_checker,
+            "linked dependency points at changed source; Python checker has no private environment for editable remapping"
+        );
+    }
+    let options = std::env::var("NODE_OPTIONS").unwrap_or_default();
+    command.env.insert(
+        "NODE_OPTIONS".into(),
+        format!("{options} --preserve-symlinks").into(),
+    );
+    Ok(())
+}
+
+fn symlink(target: &Path, destination: &Path) -> Result<()> {
+    #[cfg(unix)]
+    std::os::unix::fs::symlink(target, destination)?;
+    #[cfg(windows)]
+    if target.is_dir() {
+        std::os::windows::fs::symlink_dir(target, destination)?;
+    } else {
+        std::os::windows::fs::symlink_file(target, destination)?;
+    }
+    Ok(())
+}
+fn remove_link(path: &Path) -> Result<()> {
+    #[cfg(windows)]
+    if path.is_dir() {
+        return fs::remove_dir(path).context("remove dependency link");
+    }
+    fs::remove_file(path).context("remove dependency link")
+}
diff --git a/crates/rio-adapters/src/dependencies/scope.rs b/crates/rio-adapters/src/dependencies/scope.rs
new file mode 100644
index 0000000..348c5b4
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/scope.rs
@@ -0,0 +1,79 @@
+use super::{DependencyGraph, Installation};
+use std::{
+    collections::{BTreeSet, VecDeque},
+    path::Path,
+};
+
+/// Filtered pnpm installs can omit unrelated importers and their snapshots.
+/// Ignore only unresolved importer requests with no installed node_modules,
+/// outside all scheduled roots and the workspace packages they depend on.
+/// Unresolved package edges, installed importers and scheduled roots stay strict.
+pub fn scope_pnpm_importers(
+    graph: &mut DependencyGraph,
+    installation: Option<&mut Installation>,
+    worktree: &Path,
+    installation_root: &str,
+    scheduled_roots: &[String],
+) {
+    if graph.format != "pnpm" {
+        return;
+    }
+    let required: BTreeSet<_> = scheduled_roots
+        .iter()
+        .filter_map(|root| {
+            if installation_root == "." || installation_root.is_empty() {
+                Some(root.clone())
+            } else if root == installation_root {
+                Some(".".into())
+            } else {
+                root.strip_prefix(&format!("{installation_root}/"))
+                    .map(str::to_owned)
+            }
+        })
+        .collect();
+    let mut required = required;
+    let mut queue: VecDeque<_> = required
+        .iter()
+        .filter_map(|root| graph.importers.get(root))
+        .flat_map(|importer| importer.dependencies.iter().map(|edge| edge.target.clone()))
+        .collect();
+    let mut seen = BTreeSet::new();
+    while let Some(key) = queue.pop_front() {
+        if !seen.insert(key.clone()) {
+            continue;
+        }
+        if let Some(node) = graph.nodes.get(&key) {
+            if let Some(source) = &node.link {
+                required.insert(source.clone());
+            }
+            queue.extend(node.dependencies.iter().map(|edge| edge.target.clone()));
+        }
+    }
+    let keep = |note: &String| {
+        let Some(importer) = note
+            .strip_prefix("unresolved pnpm importer ")
+            .and_then(|note| note.split_once(": "))
+            .map(|(importer, _)| importer)
+        else {
+            return true;
+        };
+        required.contains(importer)
+            || worktree
+                .join(installation_root)
+                .join(importer)
+                .join("node_modules")
+                .exists()
+    };
+    let previous = graph.notes.len();
+    graph.notes.retain(keep);
+    if graph.notes.len() < previous && graph.notes.is_empty() {
+        graph.complete = true;
+    }
+    if let Some(installation) = installation {
+        let previous = installation.notes.len();
+        installation.notes.retain(keep);
+        if installation.notes.len() < previous && installation.notes.is_empty() {
+            installation.complete = true;
+        }
+    }
+}
diff --git a/crates/rio-adapters/src/dependencies/source_entries.rs b/crates/rio-adapters/src/dependencies/source_entries.rs
new file mode 100644
index 0000000..440fa59
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/source_entries.rs
@@ -0,0 +1,493 @@
+//! Source resolution and conservative artifact reuse for linked Node packages.
+use std::{
+    collections::BTreeMap,
+    fs,
+    path::{Component, Path, PathBuf},
+};
+
+use anyhow::{Context, Result, bail, ensure};
+use rio_git::{Tree, dependency_state_hash};
+use serde_json::Value;
+
+use super::remap::BaseDependencyRemap;
+use crate::ToolCommand;
+
+fn strings<'a>(value: &'a Value, result: &mut Vec<&'a str>) {
+    match value {
+        Value::String(value) => result.push(value),
+        Value::Array(values) => values.iter().for_each(|value| strings(value, result)),
+        Value::Object(values) => values.values().for_each(|value| strings(value, result)),
+        _ => {}
+    }
+}
+
+fn local(entry: &str) -> Option<&str> {
+    let entry = entry.strip_prefix("./").unwrap_or(entry);
+    (!entry.is_empty()
+        && Path::new(entry)
+            .components()
+            .all(|part| matches!(part, Component::Normal(_))))
+    .then_some(entry)
+}
+
+fn present(tree: &Tree, root: &str, entry: &str) -> bool {
+    let path = format!("{root}{entry}");
+    if path.contains('*') {
+        globset::Glob::new(&path).ok().is_some_and(|glob| {
+            let matcher = glob.compile_matcher();
+            tree.keys().any(|path| matcher.is_match(path))
+        })
+    } else {
+        tree.get(&path)
+            .is_some_and(|entry| entry.mode == 0o100644 || entry.mode == 0o100755)
+    }
+}
+
+fn source(tree: &Tree, root: &str, value: &Value) -> Option<String> {
+    let mut candidates = Vec::new();
+    // Prefer explicit source/development conditions, including custom conditions
+    // such as @tanstack/custom-condition when their value names tracked source.
+    for key in ["source", "development"] {
+        strings(&value[key], &mut candidates);
+    }
+    strings(value, &mut candidates);
+    candidates
+        .into_iter()
+        .filter_map(local)
+        .find(|entry| {
+            (entry.starts_with("src/") || crate::language_for_path(entry) == Some("typescript"))
+                && ![".d.ts", ".d.mts", ".d.cts"]
+                    .iter()
+                    .any(|suffix| entry.ends_with(suffix))
+                && present(tree, root, entry)
+        })
+        .map(str::to_owned)
+}
+
+fn conventional_source(tree: &Tree, root: &str, name: &str) -> Option<String> {
+    [format!("src/{name}.ts"), format!("src/{name}/index.ts")]
+        .into_iter()
+        .find(|entry| present(tree, root, entry))
+}
+
+fn root_export(exports: &Value) -> &Value {
+    if exports.get(".").is_some() {
+        &exports["."]
+    } else if exports
+        .as_object()
+        .is_some_and(|entries| entries.keys().any(|key| key.starts_with('.')))
+    {
+        &Value::Null
+    } else {
+        exports
+    }
+}
+
+fn unresolved_entries<'a>(tree: &Tree, prefix: &str, value: &'a Value) -> Vec<&'a str> {
+    let mut entries = Vec::new();
+    strings(value, &mut entries);
+    let entries: Vec<_> = entries.into_iter().filter_map(local).collect();
+    if entries.iter().any(|entry| present(tree, prefix, entry)) {
+        Vec::new()
+    } else {
+        entries
+    }
+}
+
+/// Hash all tracked package inputs, including manifests, config and deletions.
+/// This is deliberately stricter than comparing only files under src/.
+fn package_hash(tree: &Tree, prefix: &str) -> String {
+    dependency_state_hash(
+        &tree
+            .iter()
+            .filter(|(path, _)| path.starts_with(prefix))
+            .map(|(path, entry)| {
+                let mut bytes = entry.mode.to_le_bytes().to_vec();
+                bytes.extend(&entry.content);
+                (path.clone(), bytes)
+            })
+            .collect(),
+    )
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn prepare_package(
+    worktree: &Path,
+    destination: &Path,
+    relative: &Path,
+    working: &Tree,
+    base: &Tree,
+    resolution: &mut BaseDependencyRemap,
+    stop: &dyn Fn() -> bool,
+) -> Result<()> {
+    let prefix = relative.to_string_lossy().replace('\\', "/");
+    let prefix = if prefix.is_empty() {
+        prefix
+    } else {
+        format!("{prefix}/")
+    };
+    let Some(manifest) = base.get(&format!("{prefix}package.json")) else {
+        return Ok(());
+    };
+    let manifest: Value = serde_json::from_slice(&manifest.content)?;
+    let Some(name) = manifest["name"].as_str() else {
+        return Ok(());
+    };
+    let mut entries = Vec::new();
+    for key in [
+        "main",
+        "module",
+        "types",
+        "typings",
+        "exports",
+        "typesVersions",
+    ] {
+        strings(&manifest[key], &mut entries);
+    }
+    let missing: Vec<_> = entries
+        .into_iter()
+        .filter_map(local)
+        .filter(|entry| !present(base, &prefix, entry))
+        .collect();
+    if missing.is_empty() {
+        return Ok(());
+    }
+
+    let mut aliases = BTreeMap::new();
+    let exports = &manifest["exports"];
+    let published = &manifest["publishConfig"];
+    let root_allowed = !exports.as_object().is_some_and(|entries| {
+        entries.keys().any(|key| key.starts_with('.'))
+            && entries.get(".").is_none_or(Value::is_null)
+    });
+    let root_source = source(base, &prefix, &manifest["source"])
+        .or_else(|| source(base, &prefix, &manifest["development"]))
+        .or_else(|| source(base, &prefix, root_export(exports)))
+        .or_else(|| source(base, &prefix, &published["source"]))
+        .or_else(|| source(base, &prefix, &published["development"]))
+        .or_else(|| source(base, &prefix, root_export(&published["exports"])))
+        .or_else(|| conventional_source(base, &prefix, "index"));
+    if root_allowed && let Some(entry) = root_source {
+        aliases.insert(name.to_owned(), entry);
+    }
+    for exports in [exports, &published["exports"]]
+        .into_iter()
+        .filter_map(Value::as_object)
+    {
+        for (subpath, conditions) in exports {
+            if let Some(subpath) = subpath.strip_prefix("./")
+                && !conditions.is_null()
+                && let Some(entry) = source(base, &prefix, conditions)
+                    .or_else(|| conventional_source(base, &prefix, subpath))
+            {
+                aliases.insert(format!("{name}/{subpath}"), entry);
+            }
+        }
+    }
+    // A root alias does not satisfy a separate public subpath. Reuse artifacts
+    // or refuse that subpath when no tracked source can represent it.
+    let mut required = Vec::new();
+    if root_allowed && !aliases.contains_key(name) {
+        let root = root_export(exports);
+        if root.is_null() {
+            for key in ["types", "typings", "main", "module", "typesVersions"] {
+                required.extend(unresolved_entries(base, &prefix, &manifest[key]));
+            }
+        } else {
+            required.extend(unresolved_entries(base, &prefix, root));
+        }
+    }
+    if let Some(exports) = exports.as_object() {
+        for (subpath, conditions) in exports {
+            if let Some(subpath) = subpath.strip_prefix("./")
+                && !aliases.contains_key(&format!("{name}/{subpath}"))
+            {
+                required.extend(unresolved_entries(base, &prefix, conditions));
+            }
+        }
+    }
+    for (name, entry) in aliases {
+        resolution.source_paths.insert(
+            name,
+            vec![
+                destination
+                    .join(relative)
+                    .join(entry)
+                    .to_string_lossy()
+                    .into_owned(),
+            ],
+        );
+    }
+    required.sort_unstable();
+    required.dedup();
+    if required.is_empty() {
+        return Ok(());
+    }
+
+    let unchanged = package_hash(working, &prefix) == package_hash(base, &prefix);
+    let package_root = if relative.as_os_str().is_empty() {
+        ".".into()
+    } else {
+        relative.display().to_string()
+    };
+    let mut outputs = std::collections::BTreeSet::new();
+    for entry in &required {
+        // Copy a whole output directory: declarations/JS can import siblings.
+        let output = entry.split('/').next().unwrap();
+        if unchanged
+            && output != "src"
+            && !output.contains('*')
+            && worktree.join(relative).join(output).exists()
+        {
+            outputs.insert(output.to_owned());
+        } else {
+            resolution.unavailable.push(format!(
+                "linked package {}::{name} cannot resolve base entry {entry}: no tracked source entry (source/development export or src/index.ts); HEAD build output {}. Configure a source entry point or commit base build output; an external base build is not read by Rio",
+                package_root, if unchanged { "is unavailable" } else { "cannot be reused because tracked package inputs changed" }
+            ));
+        }
+    }
+    let mut artifacts = Vec::new();
+    for output in outputs {
+        copy_output(
+            &worktree.join(relative).join(&output),
+            &destination.join(relative).join(&output),
+            stop,
+            &mut artifacts,
+        )?;
+    }
+    // An existing but empty output directory is not a usable build. In
+    // particular, never classify TS2307 from an incomplete copy as a baseline.
+    for entry in required {
+        let path = destination.join(relative).join(entry);
+        let present = if entry.contains('*') {
+            globset::Glob::new(&path.to_string_lossy()).is_ok_and(|glob| {
+                let matcher = glob.compile_matcher();
+                artifacts.iter().any(|path| matcher.is_match(path))
+            })
+        } else {
+            path.is_file()
+        };
+        if resolution.unavailable.is_empty() && !present {
+            resolution.unavailable.push(format!("linked package {package_root}::{name} base build entry {entry} is missing from HEAD output; build the package with unchanged tracked inputs or configure source entry points"));
+        }
+    }
+    Ok(())
+}
+
+// Never link writable artifacts back into HEAD, overwrite tracked base files,
+// follow output symlinks, or copy a dependency installation recursively.
+fn copy_output(
+    source: &Path,
+    destination: &Path,
+    stop: &dyn Fn() -> bool,
+    artifacts: &mut Vec<PathBuf>,
+) -> Result<()> {
+    ensure!(!stop(), "timeout: copying linked build output stopped");
+    let metadata = fs::symlink_metadata(source)?;
+    if let Ok(metadata) = fs::symlink_metadata(destination) {
+        ensure!(
+            !metadata.file_type().is_symlink(),
+            "base build output {} is a symlink; cannot copy artifacts through it",
+            destination.display()
+        );
+    }
+    ensure!(
+        !metadata.file_type().is_symlink(),
+        "linked build output {} is a symlink; configure source entry points",
+        source.display()
+    );
+    if metadata.is_dir() {
+        if destination.exists() {
+            ensure!(
+                fs::symlink_metadata(destination)?.is_dir(),
+                "base output directory is not a private directory"
+            );
+        } else {
+            fs::create_dir_all(destination)?;
+        }
+        for entry in fs::read_dir(source)? {
+            let entry = entry?;
+            ensure!(
+                entry.file_name() != "node_modules",
+                "linked build output contains node_modules; configure source entry points"
+            );
+            copy_output(
+                &entry.path(),
+                &destination.join(entry.file_name()),
+                stop,
+                artifacts,
+            )?;
+        }
+    } else if !destination.try_exists()? {
+        ensure!(
+            metadata.is_file(),
+            "linked build output is not a regular file"
+        );
+        fs::copy(source, destination)?;
+    }
+    if metadata.is_file() {
+        artifacts.push(destination.into());
+    }
+    Ok(())
+}
+
+/// Read only the inherited options needed to merge paths. Everything else is
+/// inherited by TypeScript itself from the generated config's `extends`.
+#[derive(Default)]
+struct InheritedOptions {
+    base_url: Option<PathBuf>,
+    paths: Option<(PathBuf, Value)>,
+    composite: Option<bool>,
+    declaration: Option<bool>,
+}
+
+fn inherited_options(config: &Path, seen: &mut Vec<PathBuf>) -> Result<InheritedOptions> {
+    let config = config
+        .canonicalize()
+        .context("resolve base TypeScript config")?;
+    ensure!(!seen.contains(&config), "cyclic TypeScript config extends");
+    seen.push(config.clone());
+    let value: Value = json5::from_str(&fs::read_to_string(&config)?)?;
+    let directory = config.parent().unwrap();
+    let mut result = InheritedOptions::default();
+    let parents: Vec<_> = match &value["extends"] {
+        Value::String(parent) => vec![parent.as_str()],
+        Value::Array(parents) => parents.iter().filter_map(Value::as_str).collect(),
+        _ => Vec::new(),
+    };
+    for parent in parents {
+        let path = resolve_config(directory, parent)?;
+        let parent = inherited_options(&path, seen)?;
+        if parent.base_url.is_some() {
+            result.base_url = parent.base_url;
+        }
+        if parent.paths.is_some() {
+            result.paths = parent.paths;
+        }
+        if parent.composite.is_some() {
+            result.composite = parent.composite;
+        }
+        if parent.declaration.is_some() {
+            result.declaration = parent.declaration;
+        }
+    }
+    if let Some(base_url) = value["compilerOptions"]["baseUrl"].as_str() {
+        result.base_url = Some(directory.join(base_url));
+    }
+    if value["compilerOptions"]["paths"].is_object() {
+        result.paths = Some((directory.into(), value["compilerOptions"]["paths"].clone()));
+    }
+    if let Some(composite) = value["compilerOptions"]["composite"].as_bool() {
+        result.composite = Some(composite);
+    }
+    if let Some(declaration) = value["compilerOptions"]["declaration"].as_bool() {
+        result.declaration = Some(declaration);
+    }
+    seen.pop();
+    Ok(result)
+}
+
+fn resolve_config(directory: &Path, name: &str) -> Result<PathBuf> {
+    let candidates: Vec<_> = if name.starts_with('.') || Path::new(name).is_absolute() {
+        vec![directory.join(name)]
+    } else {
+        directory
+            .ancestors()
+            .map(|parent| parent.join("node_modules").join(name))
+            .collect()
+    };
+    for candidate in candidates {
+        let mut json = candidate.as_os_str().to_owned();
+        json.push(".json");
+        for path in [
+            candidate.clone(),
+            PathBuf::from(json),
+            candidate.join("tsconfig.json"),
+        ] {
+            if path.is_file() {
+                return Ok(path);
+            }
+        }
+        if let Ok(manifest) = fs::read(candidate.join("package.json"))
+            && let Ok(manifest) = serde_json::from_slice::<Value>(&manifest)
+            && let Some(config) = manifest["tsconfig"].as_str()
+        {
+            return Ok(candidate.join(config));
+        }
+    }
+    bail!(
+        "cannot resolve TypeScript config extends {name}; configure source entry points in the project paths"
+    )
+}
+
+pub(super) fn configure_typescript(
+    command: &mut ToolCommand,
+    aliases: &BTreeMap<String, Vec<String>>,
+    source_root: &Path,
+) -> Result<()> {
+    if aliases.is_empty() {
+        return Ok(());
+    }
+    let index = command
+        .args
+        .iter()
+        .position(|arg| arg == "-p")
+        .context("TypeScript command has no project config")?
+        + 1;
+    let config = PathBuf::from(&command.args[index]);
+    let inherited = inherited_options(&config, &mut Vec::new())?;
+    let mut paths = serde_json::Map::new();
+    if let Some((directory, inherited_paths)) = inherited.paths {
+        let origin = inherited.base_url.as_deref().unwrap_or(&directory);
+        for (name, entries) in inherited_paths.as_object().unwrap() {
+            let entries = entries
+                .as_array()
+                .context("TypeScript paths entry must be an array")?;
+            let absolute: Vec<_> = entries
+                .iter()
+                .map(|entry| {
+                    entry
+                        .as_str()
+                        .context("TypeScript paths target must be a string")
+                        .map(|entry| origin.join(entry))
+                })
+                .collect::<Result<_>>()?;
+            paths.insert(name.clone(), serde_json::to_value(absolute)?);
+        }
+    }
+    // Keep unrelated project aliases; these linked package entries must resolve
+    // to base sources even if an inherited alias names ignored build output.
+    for (name, entries) in aliases {
+        paths.insert(name.clone(), serde_json::to_value(entries)?);
+    }
+    // Imported package source now belongs to this no-emit check. Project-local
+    // rootDir/composite file-list restrictions describe its published build,
+    // and must not reject sibling source merely because it replaces a .d.ts.
+    let mut value = serde_json::json!({"extends": config, "compilerOptions": {"paths": paths, "rootDir": source_root, "composite": false}});
+    if inherited.composite == Some(true) && inherited.declaration.is_none() {
+        // Preserve composite's implicit declaration setting, notably when a
+        // project enables declarationMap without spelling out declaration.
+        value["compilerOptions"]["declaration"] = true.into();
+    }
+    // TypeScript does not inherit references via extends. Preserve explicit
+    // references using the original config directory as their path origin.
+    let original: Value = json5::from_str(&fs::read_to_string(&config)?)?;
+    if let Some(references) = original["references"].as_array() {
+        let mut references = references.clone();
+        for reference in &mut references {
+            let path = reference["path"]
+                .as_str()
+                .context("TypeScript reference has no path")?;
+            reference["path"] = serde_json::to_value(config.parent().unwrap().join(path))?;
+        }
+        value["references"] = Value::Array(references);
+    }
+    let file = tempfile::Builder::new()
+        .prefix(".rio-base-tsconfig-")
+        .suffix(".json")
+        .tempfile_in(&command.cwd)?;
+    serde_json::to_writer(&file, &value)?;
+    command.args[index] = file.keep()?.1.into_os_string();
+    Ok(())
+}
diff --git a/crates/rio-adapters/src/dependencies/yarn.rs b/crates/rio-adapters/src/dependencies/yarn.rs
new file mode 100644
index 0000000..4a2ba95
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/yarn.rs
@@ -0,0 +1,198 @@
+use std::collections::BTreeMap;
+
+use super::{DependencyEdge, DependencyGraph, Ecosystem, Importer, lockfiles::node};
+use anyhow::{Context, Result};
+use regex::Regex;
+use serde_json::{Value, json};
+
+fn unquote(value: &str) -> String {
+    let value = value.trim();
+    if value.starts_with('"') {
+        serde_json::from_str(value).unwrap_or_else(|_| value.trim_matches('"').into())
+    } else {
+        value.trim_matches('\'').into()
+    }
+}
+
+fn descriptors(header: &str) -> Vec<String> {
+    // Descriptor commas inside a quoted selector are not separators in classic.
+    let mut parts = Vec::new();
+    let mut start = 0;
+    let mut quoted = false;
+    let mut escaped = false;
+    for (at, c) in header.char_indices() {
+        if c == '"' && !escaped {
+            quoted = !quoted;
+        }
+        if c == ',' && !quoted {
+            parts.push(unquote(&header[start..at]));
+            start = at + 1;
+        }
+        escaped = c == '\\' && !escaped;
+    }
+    parts.push(unquote(&header[start..]));
+    parts
+}
+
+fn classic(content: &str) -> Result<Value> {
+    let field = Regex::new(r#"^\s+(?:"([^"]+)"|([^\s]+))\s+(.+)$"#)?;
+    let mut result = serde_json::Map::new();
+    let mut header = None::<String>;
+    let mut record = json!({});
+    let mut section = None::<String>;
+    for line in content.lines() {
+        if line.trim().is_empty() || line.trim_start().starts_with('#') {
+            continue;
+        }
+        if !line.starts_with(char::is_whitespace) && line.ends_with(':') {
+            if let Some(previous) = header.take() {
+                result.insert(previous, record);
+            }
+            header = Some(line.trim_end_matches(':').to_owned());
+            record = json!({});
+            section = None;
+        } else if line.starts_with("  ") && !line.starts_with("    ") && line.ends_with(':') {
+            let key = line.trim().trim_end_matches(':');
+            record[key] = json!({});
+            section = Some(key.into());
+        } else if let Some(captures) = field.captures(line) {
+            let name = captures
+                .get(1)
+                .or_else(|| captures.get(2))
+                .unwrap()
+                .as_str();
+            let value = unquote(&captures[3]);
+            if line.starts_with("    ") {
+                if let Some(section) = &section {
+                    record[section][name] = Value::String(value);
+                }
+            } else {
+                record[name] = Value::String(value);
+                section = None;
+            }
+        } else {
+            anyhow::bail!("unrecognized yarn classic lockfile line: {line}");
+        }
+    }
+    if let Some(header) = header {
+        result.insert(header, record);
+    }
+    Ok(Value::Object(result))
+}
+
+pub(super) fn parse(content: &str) -> Result<DependencyGraph> {
+    let berry = content.lines().any(|line| line.starts_with("__metadata:"));
+    let value: Value = if berry {
+        serde_yaml::from_str(content)?
+    } else {
+        classic(content)?
+    };
+    let records = value
+        .as_object()
+        .context("yarn lockfile must be a mapping")?;
+    let mut graph = DependencyGraph::new(if berry { "yarn-berry" } else { "yarn-classic" });
+    let mut selectors = BTreeMap::new();
+    for (header, record) in records {
+        if header == "__metadata" {
+            continue;
+        }
+        let names = if berry {
+            unquote(header)
+                .split(", ")
+                .map(str::to_owned)
+                .collect::<Vec<_>>()
+        } else {
+            descriptors(header)
+        };
+        let first = names.first().context("empty yarn descriptor")?;
+        let at = first[1..]
+            .find('@')
+            .map(|at| at + 1)
+            .context("yarn descriptor has no selector")?;
+        let name = &first[..at];
+        let version = record["version"]
+            .as_str()
+            .context("yarn package has no version")?;
+        let key = record["resolution"]
+            .as_str()
+            .map(str::to_owned)
+            .unwrap_or_else(|| format!("{name}@{version}"));
+        let mut entry = node(key.clone(), name.into(), version.into(), Ecosystem::Npm);
+        if let Some((_, target)) = key.split_once("@workspace:") {
+            entry.link = Some(target.into());
+        }
+        if let Some(conditions) = record["conditions"].as_str() {
+            for condition in conditions.split(" & ") {
+                if let Some((kind, value)) = condition.split_once('=') {
+                    match kind {
+                        "os" => entry.flags.os.push(value.into()),
+                        "cpu" => entry.flags.cpu.push(value.into()),
+                        "libc" => entry.flags.libc.push(value.into()),
+                        _ => graph.unverified(format!("unknown yarn condition: {condition}")),
+                    }
+                }
+            }
+        }
+        graph.nodes.insert(key.clone(), entry);
+        for selector in names {
+            selectors.insert(selector, key.clone());
+        }
+    }
+    for (header, record) in records {
+        if header == "__metadata" {
+            continue;
+        }
+        let first = if berry {
+            unquote(header).split(", ").next().unwrap().to_owned()
+        } else {
+            descriptors(header)[0].clone()
+        };
+        let key = selectors[&first].clone();
+        let mut edges = Vec::new();
+        for (kind, optional) in [
+            ("dependencies", false),
+            ("optionalDependencies", true),
+            ("peerDependencies", true),
+        ] {
+            if let Some(dependencies) = record[kind].as_object() {
+                for (name, range) in dependencies {
+                    let range = range
+                        .as_str()
+                        .context("yarn dependency selector must be a string")?;
+                    let selector = format!("{name}@{range}");
+                    let alternate = format!("{name}@npm:{range}");
+                    let target = selectors
+                        .get(&selector)
+                        .or_else(|| selectors.get(&alternate));
+                    let optional = optional
+                        || record["dependenciesMeta"][name]["optional"].as_bool() == Some(true);
+                    if let Some(target) = target {
+                        edges.push(DependencyEdge {
+                            name: name.clone(),
+                            target: target.clone(),
+                            optional,
+                            peer: kind == "peerDependencies",
+                            ..Default::default()
+                        });
+                    } else if !optional {
+                        graph.unverified(format!("unresolved yarn selector: {selector}"));
+                    }
+                }
+            }
+        }
+        let entry = graph.nodes.get_mut(&key).unwrap();
+        entry.dependencies = edges.clone();
+        if let Some(link) = &entry.link {
+            graph.importers.insert(
+                link.clone(),
+                Importer {
+                    dependencies: edges,
+                },
+            );
+        }
+    }
+    // Classic lockfiles don't encode workspace importers or physical locations;
+    // manifests supply the importers before checking the installed resolution.
+    graph.selectors = selectors;
+    Ok(graph)
+}
