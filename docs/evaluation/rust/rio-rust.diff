index 0000000..9cf8521
--- /dev/null
+++ b/crates/rio-adapters/src/process/mod.rs
@@ -0,0 +1,307 @@
+//! All executable checks and version probes use the same bounded supervisor.
+#[cfg(unix)]
+mod unix;
+#[cfg(unix)]
+use unix as platform;
+#[cfg(windows)]
+mod windows;
+#[cfg(windows)]
+use windows as platform;
+
+use std::{
+    collections::BTreeMap,
+    ffi::OsString,
+    io,
+    path::PathBuf,
+    process::Stdio,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use rio_core::{CancellationReason, FailureReason};
+use tokio::{
+    io::{AsyncRead, AsyncReadExt},
+    process::{Child, Command},
+    sync::mpsc,
+    time::{Instant, sleep, timeout},
+};
+use tokio_util::sync::CancellationToken;
+
+use crate::retained_raw;
+
+#[derive(Debug, Clone)]
+pub struct ToolCommand {
+    pub program: PathBuf,
+    pub args: Vec<OsString>,
+    pub cwd: PathBuf,
+    pub env: BTreeMap<OsString, OsString>,
+    pub timeout: Duration,
+    /// Maximum parsed bytes per stream, independently for stdout and stderr.
+    pub output_limit: usize,
+}
+
+impl ToolCommand {
+    pub fn new(program: PathBuf, cwd: PathBuf) -> Self {
+        Self {
+            program,
+            args: Vec::new(),
+            cwd,
+            env: BTreeMap::new(),
+            timeout: Duration::from_secs(240),
+            output_limit: 256 * 1024 * 1024,
+        }
+    }
+}
+
+#[derive(Debug, Clone)]
+pub enum Termination {
+    Exited { code: Option<i32> },
+    Failed { reason: FailureReason, hint: String },
+    Cancelled { reason: CancellationReason },
+}
+
+pub struct ProcessResult {
+    pub termination: Termination,
+    /// Unredacted bytes are private parser input; persist only `raw_*` fields.
+    pub stdout: Vec<u8>,
+    pub stderr: Vec<u8>,
+    pub raw_stdout: Vec<u8>,
+    pub raw_stderr: Vec<u8>,
+    pub wall_time: Duration,
+    pub cleanup_confirmed: bool,
+    pub survivors: Vec<String>,
+}
+
+#[derive(Default)]
+struct Captured {
+    bytes: Vec<u8>,
+    error: Option<String>,
+}
+
+async fn collect(
+    mut stream: impl AsyncRead + Unpin,
+    captured: Arc<Mutex<Captured>>,
+    limit: usize,
+    exceeded: mpsc::Sender<()>,
+) {
+    let mut buffer = [0u8; 8192];
+    let mut notified = false;
+    loop {
+        match stream.read(&mut buffer).await {
+            Ok(0) => return,
+            Ok(count) => {
+                let over_limit = {
+                    let mut captured = captured.lock().unwrap();
+                    let available = limit.saturating_sub(captured.bytes.len());
+                    captured
+                        .bytes
+                        .extend_from_slice(&buffer[..count.min(available)]);
+                    count > available
+                };
+                if over_limit && !notified {
+                    let _ = exceeded.send(()).await;
+                    notified = true;
+                }
+            }
+            Err(error) => {
+                captured.lock().unwrap().error = Some(error.to_string());
+                return;
+            }
+        }
+    }
+}
+
+#[derive(Clone, Default)]
+pub struct ProcessSupervisor {
+    active: Arc<Mutex<BTreeMap<u32, Arc<platform::ProcessTree>>>>,
+}
+
+struct Registration {
+    supervisor: ProcessSupervisor,
+    pid: u32,
+}
+impl Drop for Registration {
+    fn drop(&mut self) {
+        if let Some(tree) = self.supervisor.active.lock().unwrap().remove(&self.pid) {
+            tree.kill();
+        }
+    }
+}
+
+impl ProcessSupervisor {
+    /// Used on the second interrupt. Every group/job is killed immediately;
+    /// ordinary cancellation still awaits group/job exit before tree cleanup.
+    pub fn kill_all(&self) {
+        for tree in self.active.lock().unwrap().values() {
+            tree.kill();
+        }
+    }
+
+    pub async fn run(
+        &self,
+        request: ToolCommand,
+        cancellation: CancellationToken,
+    ) -> ProcessResult {
+        let started = Instant::now();
+        let empty_failure = |error: io::Error| ProcessResult {
+            termination: Termination::Failed {
+                reason: FailureReason::SpawnFailed,
+                hint: format!("{}: {error}", request.program.display()),
+            },
+            stdout: Vec::new(),
+            stderr: Vec::new(),
+            raw_stdout: Vec::new(),
+            raw_stderr: Vec::new(),
+            wall_time: started.elapsed(),
+            cleanup_confirmed: true,
+            survivors: Vec::new(),
+        };
+        if cancellation.is_cancelled() {
+            let mut result = empty_failure(io::Error::other("cancelled before spawn"));
+            result.termination = Termination::Cancelled {
+                reason: CancellationReason::Interrupted,
+            };
+            return result;
+        }
+        let tree = match platform::ProcessTree::new() {
+            Ok(tree) => Arc::new(tree),
+            Err(error) => return empty_failure(error),
+        };
+        let mut command = Command::new(&request.program);
+        command
+            .args(&request.args)
+            .current_dir(&request.cwd)
+            .envs(&request.env)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .kill_on_drop(true);
+        tree.configure(&mut command);
+        let mut child = match command.spawn() {
+            Ok(child) => child,
+            Err(error) => return empty_failure(error),
+        };
+        if let Err(error) = tree.attach(&child) {
+            tree.kill();
+            let _ = child.kill().await;
+            let _ = child.wait().await;
+            return empty_failure(error);
+        }
+        let pid = child.id().expect("a newly spawned child has a process id");
+        self.active.lock().unwrap().insert(pid, tree.clone());
+        let _registration = Registration {
+            supervisor: self.clone(),
+            pid,
+        };
+        let stdout = Arc::new(Mutex::new(Captured::default()));
+        let stderr = Arc::new(Mutex::new(Captured::default()));
+        let (exceeded, mut exceeded_rx) = mpsc::channel(2);
+        let stdout_reader = tokio::spawn(collect(
+            child.stdout.take().unwrap(),
+            stdout.clone(),
+            request.output_limit,
+            exceeded.clone(),
+        ));
+        let stderr_reader = tokio::spawn(collect(
+            child.stderr.take().unwrap(),
+            stderr.clone(),
+            request.output_limit,
+            exceeded,
+        ));
+        let deadline = sleep(request.timeout);
+        tokio::pin!(deadline);
+        let mut observation = tokio::time::interval(Duration::from_millis(100));
+        let mut termination = loop {
+            tokio::select! {
+                biased;
+                _ = cancellation.cancelled() => break Termination::Cancelled {reason:CancellationReason::Interrupted},
+                Some(()) = exceeded_rx.recv() => break Termination::Failed {reason:FailureReason::OutputLimit,hint:format!("tool output exceeded {} bytes per stream",request.output_limit)},
+                _ = &mut deadline => break Termination::Cancelled {reason:CancellationReason::Timeout},
+                result = child.wait() => break match result {
+                    Ok(status) => Termination::Exited {code:status.code()},
+                    Err(error) => Termination::Failed {reason:FailureReason::ToolCrashed,hint:error.to_string()},
+                },
+                _ = observation.tick() => tree.observe(),
+            }
+        };
+        tree.observe();
+        let cleanup_confirmed = cleanup(&tree, &mut child).await;
+        // A descendant that escaped its group may still hold an output handle.
+        // Reader deadlines cannot keep a cancelled check alive indefinitely.
+        for reader in [stdout_reader, stderr_reader] {
+            let abort = reader.abort_handle();
+            if timeout(Duration::from_millis(500), reader).await.is_err() {
+                abort.abort();
+            }
+        }
+        if exceeded_rx.try_recv().is_ok() && matches!(termination, Termination::Exited { .. }) {
+            termination = Termination::Failed {
+                reason: FailureReason::OutputLimit,
+                hint: format!(
+                    "tool output exceeded {} bytes per stream",
+                    request.output_limit
+                ),
+            };
+        }
+        let take = |capture: &Arc<Mutex<Captured>>| {
+            let mut captured = capture.lock().unwrap();
+            (std::mem::take(&mut captured.bytes), captured.error.take())
+        };
+        let (stdout, stdout_error) = take(&stdout);
+        let (stderr, stderr_error) = take(&stderr);
+        if let Some(error) = stdout_error.or(stderr_error)
+            && matches!(termination, Termination::Exited { .. })
+        {
+            termination = Termination::Failed {
+                reason: FailureReason::ToolCrashed,
+                hint: format!("could not read tool output: {error}"),
+            };
+        }
+        let survivors = tree.survivors();
+        if cleanup_confirmed && survivors.is_empty() {
+            tree.disarm();
+        }
+        ProcessResult {
+            termination,
+            raw_stdout: retained_raw(&stdout, 16 * 1024 * 1024),
+            raw_stderr: retained_raw(&stderr, 16 * 1024 * 1024),
+            stdout,
+            stderr,
+            wall_time: started.elapsed(),
+            cleanup_confirmed: cleanup_confirmed && survivors.is_empty(),
+            survivors,
+        }
+    }
+}
+
+async fn cleanup(tree: &platform::ProcessTree, child: &mut Child) -> bool {
+    tree.terminate();
+    let grace = Instant::now() + Duration::from_secs(5);
+    // Reap the leader before adopted children so Tokio owns its wait status.
+    if timeout(Duration::from_secs(5), child.wait()).await.is_err() {
+        tree.kill();
+    }
+    loop {
+        tree.reap();
+        if !tree.alive() {
+            return true;
+        }
+        if Instant::now() >= grace {
+            break;
+        }
+        sleep(Duration::from_millis(20)).await;
+    }
+    tree.kill();
+    let _ = timeout(Duration::from_secs(5), child.wait()).await;
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        tree.reap();
+        if !tree.alive() {
+            return true;
+        }
+        if Instant::now() >= deadline {
+            return false;
+        }
+        sleep(Duration::from_millis(20)).await;
+    }
+}
diff --git a/crates/rio-adapters/src/process/unix.rs b/crates/rio-adapters/src/process/unix.rs
new file mode 100644
index 0000000..015c647
--- /dev/null
+++ b/crates/rio-adapters/src/process/unix.rs
@@ -0,0 +1,156 @@
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    io,
+    sync::{
+        Mutex,
+        atomic::{AtomicU32, Ordering},
+    },
+};
+use sysinfo::{Pid, ProcessRefreshKind, ProcessesToUpdate, System};
+use tokio::process::{Child, Command};
+
+pub struct ProcessTree {
+    pid: AtomicU32,
+    observed: Mutex<BTreeMap<u32, u64>>,
+}
+
+impl ProcessTree {
+    pub fn new() -> io::Result<Self> {
+        #[cfg(target_os = "linux")]
+        {
+            static SUBREAPER: std::sync::OnceLock<Result<(), i32>> = std::sync::OnceLock::new();
+            let result = SUBREAPER.get_or_init(|| {
+                // SAFETY: this changes only the caller's subreaper flag; no pointers.
+                if unsafe { libc::prctl(libc::PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) } == 0 {
+                    Ok(())
+                } else {
+                    Err(io::Error::last_os_error()
+                        .raw_os_error()
+                        .unwrap_or(libc::EINVAL))
+                }
+            });
+            if let Err(code) = result {
+                return Err(io::Error::from_raw_os_error(*code));
+            }
+        }
+        Ok(Self {
+            pid: AtomicU32::new(0),
+            observed: Mutex::new(BTreeMap::new()),
+        })
+    }
+    pub fn configure(&self, command: &mut Command) {
+        command.process_group(0);
+    }
+    pub fn attach(&self, child: &Child) -> io::Result<()> {
+        self.pid.store(
+            child
+                .id()
+                .ok_or_else(|| io::Error::other("child exited before attachment"))?,
+            Ordering::Release,
+        );
+        self.observe();
+        Ok(())
+    }
+    fn signal(&self, signal: i32) {
+        let pid = self.pid.load(Ordering::Acquire);
+        if pid != 0 {
+            // SAFETY: a negative pid names only the freshly created child group.
+            unsafe { libc::kill(-(pid as i32), signal) };
+        }
+    }
+    pub fn disarm(&self) {
+        self.pid.store(0, Ordering::Release);
+    }
+    pub fn terminate(&self) {
+        self.signal(libc::SIGTERM);
+    }
+    pub fn kill(&self) {
+        self.signal(libc::SIGKILL);
+    }
+    pub fn alive(&self) -> bool {
+        let pid = self.pid.load(Ordering::Acquire);
+        // SAFETY: signal 0 probes the existence of our child group without mutation.
+        pid != 0
+            && (unsafe { libc::kill(-(pid as i32), 0) } == 0
+                || io::Error::last_os_error().raw_os_error() == Some(libc::EPERM))
+    }
+    pub fn reap(&self) {
+        #[cfg(target_os = "linux")]
+        {
+            let pid = self.pid.load(Ordering::Acquire);
+            if pid == 0 {
+                return;
+            }
+            loop {
+                // SAFETY: only non-blocking waits for our own adopted group members.
+                let reaped =
+                    unsafe { libc::waitpid(-(pid as i32), std::ptr::null_mut(), libc::WNOHANG) };
+                if reaped <= 0 {
+                    break;
+                }
+            }
+        }
+    }
+    fn snapshot() -> System {
+        let mut system = System::new();
+        // Only PID, parent and start identity are needed for supervision.
+        // Avoid refreshing executable paths, memory, CPU and every OS thread
+        // twice per observation, especially with many concurrent reviews.
+        system.refresh_processes_specifics(
+            ProcessesToUpdate::All,
+            true,
+            ProcessRefreshKind::nothing().without_tasks(),
+        );
+        system
+    }
+    pub fn observe(&self) {
+        let root = self.pid.load(Ordering::Acquire);
+        if root == 0 {
+            return;
+        }
+        let system = Self::snapshot();
+        let mut descendants = BTreeSet::from([root]);
+        loop {
+            let before = descendants.len();
+            for (pid, process) in system.processes() {
+                if process
+                    .parent()
+                    .is_some_and(|parent| descendants.contains(&parent.as_u32()))
+                {
+                    descendants.insert(pid.as_u32());
+                }
+            }
+            if descendants.len() == before {
+                break;
+            }
+        }
+        let mut observed = self.observed.lock().unwrap();
+        for pid in descendants {
+            if let Some(process) = system.process(Pid::from_u32(pid)) {
+                observed.insert(pid, process.start_time());
+            }
+        }
+    }
+    pub fn survivors(&self) -> Vec<String> {
+        let system = Self::snapshot();
+        self.observed
+            .lock()
+            .unwrap()
+            .iter()
+            .filter_map(|(pid, start)| {
+                let process = system.process(Pid::from_u32(*pid))?;
+                (process.start_time() == *start).then(|| {
+                    format!(
+                        "pid {pid} ({}) survived its process group",
+                        process.name().to_string_lossy()
+                    )
+                })
+            })
+            .collect()
+    }
+}
+impl Drop for ProcessTree {
+    fn drop(&mut self) {
+        self.kill();
+    }
+}
diff --git a/crates/rio-adapters/src/process/windows.rs b/crates/rio-adapters/src/process/windows.rs
new file mode 100644
index 0000000..cf011ed
--- /dev/null
+++ b/crates/rio-adapters/src/process/windows.rs
@@ -0,0 +1,120 @@
+use std::{
+    io,
+    mem::{size_of, zeroed},
+    sync::atomic::{AtomicU32, Ordering},
+};
+use tokio::process::{Child, Command};
+use windows_sys::Win32::{
+    Foundation::{CloseHandle, HANDLE},
+    System::{
+        JobObjects::{
+            AssignProcessToJobObject, CreateJobObjectW, JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE,
+            JOBOBJECT_BASIC_ACCOUNTING_INFORMATION, JOBOBJECT_EXTENDED_LIMIT_INFORMATION,
+            JobObjectBasicAccountingInformation, JobObjectExtendedLimitInformation,
+            QueryInformationJobObject, SetInformationJobObject, TerminateJobObject,
+        },
+        Threading::{CREATE_NEW_PROCESS_GROUP, CREATE_SUSPENDED},
+    },
+};
+
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn NtResumeProcess(process: HANDLE) -> i32;
+}
+
+pub struct ProcessTree {
+    job: HANDLE,
+    pid: AtomicU32,
+}
+// SAFETY: job handles support concurrent Job Object APIs. The owned handle is
+// closed only after all Arc owners have released the tree.
+unsafe impl Send for ProcessTree {}
+unsafe impl Sync for ProcessTree {}
+
+impl ProcessTree {
+    pub fn new() -> io::Result<Self> {
+        // SAFETY: null security/name pointers use documented default attributes.
+        let job = unsafe { CreateJobObjectW(std::ptr::null(), std::ptr::null()) };
+        if job.is_null() {
+            return Err(io::Error::last_os_error());
+        }
+        // SAFETY: the POD structure is valid when zero-initialized.
+        let mut limits: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = unsafe { zeroed() };
+        limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+        // SAFETY: buffer and size describe the matching job information class.
+        if unsafe {
+            SetInformationJobObject(
+                job,
+                JobObjectExtendedLimitInformation,
+                &limits as *const _ as *const _,
+                size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32,
+            )
+        } == 0
+        {
+            let error = io::Error::last_os_error();
+            unsafe { CloseHandle(job) };
+            return Err(error);
+        }
+        Ok(Self {
+            job,
+            pid: AtomicU32::new(0),
+        })
+    }
+    pub fn configure(&self, command: &mut Command) {
+        command.creation_flags(CREATE_SUSPENDED | CREATE_NEW_PROCESS_GROUP);
+    }
+    pub fn attach(&self, child: &Child) -> io::Result<()> {
+        let handle = child
+            .raw_handle()
+            .ok_or_else(|| io::Error::other("missing suspended process handle"))?
+            as HANDLE;
+        // SAFETY: handle is a live suspended child; it cannot execute before
+        // successful job assignment and the following resume call.
+        if unsafe { AssignProcessToJobObject(self.job, handle) } == 0 {
+            return Err(io::Error::last_os_error());
+        }
+        self.pid.store(child.id().unwrap_or(0), Ordering::Release);
+        if unsafe { NtResumeProcess(handle) } < 0 {
+            return Err(io::Error::other("could not resume assigned process"));
+        }
+        Ok(())
+    }
+    pub fn disarm(&self) {}
+    pub fn terminate(&self) {
+        self.kill();
+    }
+    pub fn kill(&self) {
+        unsafe { TerminateJobObject(self.job, 1) };
+    }
+    pub fn alive(&self) -> bool {
+        let mut info: JOBOBJECT_BASIC_ACCOUNTING_INFORMATION = unsafe { zeroed() };
+        let success = unsafe {
+            QueryInformationJobObject(
+                self.job,
+                JobObjectBasicAccountingInformation,
+                &mut info as *mut _ as *mut _,
+                size_of::<JOBOBJECT_BASIC_ACCOUNTING_INFORMATION>() as u32,
+                std::ptr::null_mut(),
+            )
+        };
+        success == 0 || info.ActiveProcesses > 0
+    }
+    pub fn reap(&self) {}
+    pub fn observe(&self) {}
+    pub fn survivors(&self) -> Vec<String> {
+        if self.alive() {
+            vec![format!(
+                "job for pid {} still contains live processes",
+                self.pid.load(Ordering::Acquire)
+            )]
+        } else {
+            Vec::new()
+        }
+    }
+}
+impl Drop for ProcessTree {
+    fn drop(&mut self) {
+        self.kill();
+        unsafe { CloseHandle(self.job) };
+    }
+}
diff --git a/crates/rio-adapters/src/python_targets.rs b/crates/rio-adapters/src/python_targets.rs
new file mode 100644
index 0000000..e3456dd
--- /dev/null
+++ b/crates/rio-adapters/src/python_targets.rs
@@ -0,0 +1,276 @@
+//! Infer mypy's scope only when the project has not configured its own targets.
+use std::collections::BTreeSet;
+
+use rio_git::Tree;
+use toml::Value;
+
+use crate::ancestor_config;
+
+fn text<'a>(tree: &'a Tree, path: &str) -> Option<&'a str> {
+    std::str::from_utf8(&tree.get(path)?.content).ok()
+}
+
+fn at<'a>(value: &'a Value, keys: &[&str]) -> Option<&'a Value> {
+    keys.iter().try_fold(value, |value, key| value.get(key))
+}
+
+fn strings(value: Option<&Value>) -> Vec<String> {
+    match value {
+        Some(Value::String(value)) => vec![value.clone()],
+        Some(Value::Array(values)) => values
+            .iter()
+            .filter_map(Value::as_str)
+            .map(str::to_owned)
+            .collect(),
+        _ => Vec::new(),
+    }
+}
+
+fn ini_has(section_text: &str, key: Option<&str>) -> bool {
+    let mut in_mypy = false;
+    for line in section_text.lines().map(str::trim) {
+        if line.starts_with('[') {
+            in_mypy = line == "[mypy]";
+            if in_mypy && key.is_none() {
+                return true;
+            }
+        } else if in_mypy
+            && !line.starts_with(['#', ';'])
+            && let Some((name, _)) = line.split_once('=')
+            && Some(name.trim()) == key
+        {
+            return true;
+        }
+    }
+    false
+}
+
+/// Use mypy's own parser for explicit files/packages/modules and exclude rules.
+/// Pin the discovered configuration so ancestor config is also used in a tool tree.
+pub(crate) fn mypy_config(tree: &Tree, root: &str) -> Option<(String, bool)> {
+    let mut directory = if root == "." { "" } else { root };
+    loop {
+        for name in ["mypy.ini", ".mypy.ini", "pyproject.toml", "setup.cfg"] {
+            let path = if directory.is_empty() {
+                name.into()
+            } else {
+                format!("{directory}/{name}")
+            };
+            let Some(content) = text(tree, &path) else {
+                continue;
+            };
+            let targets = if name == "pyproject.toml" {
+                let Some(value) = toml::from_str::<Value>(content).ok() else {
+                    continue;
+                };
+                let Some(mypy) = at(&value, &["tool", "mypy"]) else {
+                    continue;
+                };
+                ["files", "packages", "modules"]
+                    .iter()
+                    .any(|key| mypy.get(key).is_some())
+            } else {
+                if !ini_has(content, None) {
+                    continue;
+                }
+                ["files", "packages", "modules"]
+                    .iter()
+                    .any(|key| ini_has(content, Some(key)))
+            };
+            return Some((path, targets));
+        }
+        if directory.is_empty() {
+            return None;
+        }
+        directory = directory.rsplit_once('/').map_or("", |(parent, _)| parent);
+    }
+}
+
+fn matches(pattern: &str, path: &str) -> bool {
+    globset::Glob::new(pattern).is_ok_and(|glob| glob.compile_matcher().is_match(path))
+}
+
+fn join(parent: &str, child: &str) -> String {
+    if parent.is_empty() || parent == "." {
+        child.into()
+    } else {
+        format!("{parent}/{child}")
+    }
+}
+
+pub(crate) fn python_package_targets(tree: &Tree, root: &str) -> Vec<String> {
+    let prefix = if root == "." {
+        String::new()
+    } else {
+        format!("{root}/")
+    };
+    let files: BTreeSet<_> = tree
+        .keys()
+        .filter_map(|path| path.strip_prefix(&prefix))
+        .collect();
+    let mut directories = BTreeSet::new();
+    for file in &files {
+        if !(file.ends_with(".py") || file.ends_with(".pyi")) {
+            continue;
+        }
+        let mut directory = file.rsplit_once('/').map(|(parent, _)| parent);
+        while let Some(path) = directory {
+            directories.insert(path.to_owned());
+            directory = path.rsplit_once('/').map(|(parent, _)| parent);
+        }
+    }
+    let exists = |path: &str| directories.contains(path) || files.contains(path);
+    let module_paths = |name: &str, parent: &str| {
+        let path = join(parent, &name.replace('.', "/"));
+        [path.clone(), format!("{path}.py"), format!("{path}.pyi")]
+            .into_iter()
+            .filter(|path| exists(path))
+            .collect::<Vec<_>>()
+    };
+    let pyproject = ancestor_config(tree, root, &["pyproject.toml"])
+        .filter(|path| path == &format!("{prefix}pyproject.toml"))
+        .and_then(|path| text(tree, &path))
+        .and_then(|content| toml::from_str::<Value>(content).ok());
+    let mut targets = Vec::new();
+    if let Some(project) = pyproject {
+        if let Some(setuptools) = at(&project, &["tool", "setuptools"]) {
+            let package_dirs = setuptools.get("package-dir");
+            for package in strings(setuptools.get("packages")) {
+                if let Some(path) = package_dirs
+                    .and_then(|dirs| dirs.get(&package))
+                    .and_then(Value::as_str)
+                {
+                    if exists(path) {
+                        targets.push(path.into());
+                    }
+                } else {
+                    let parent = package_dirs
+                        .and_then(|dirs| dirs.get(""))
+                        .and_then(Value::as_str)
+                        .unwrap_or("");
+                    targets.extend(module_paths(&package, parent));
+                }
+            }
+            if let Some(find) = at(setuptools, &["packages", "find"]) {
+                let mut wheres = strings(find.get("where"));
+                if wheres.is_empty() {
+                    wheres.push(".".into());
+                }
+                let mut includes = strings(find.get("include"));
+                if includes.is_empty() {
+                    includes.push("*".into());
+                }
+                let excludes = strings(find.get("exclude"));
+                for directory in &directories {
+                    for parent in &wheres {
+                        let name = if parent == "." {
+                            Some(directory.as_str())
+                        } else {
+                            directory.strip_prefix(&format!("{parent}/"))
+                        };
+                        if let Some(name) = name {
+                            let name = name.replace('/', ".");
+                            if includes.iter().any(|pattern| matches(pattern, &name))
+                                && !excludes.iter().any(|pattern| matches(pattern, &name))
+                            {
+                                targets.push(directory.clone());
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        for package in strings(at(
+            &project,
+            &["tool", "hatch", "build", "targets", "wheel", "packages"],
+        )) {
+            if exists(&package) {
+                targets.push(package);
+            }
+        }
+        if let Some(packages) =
+            at(&project, &["tool", "poetry", "packages"]).and_then(Value::as_array)
+        {
+            for package in packages {
+                if let Some(include) = package.get("include").and_then(Value::as_str) {
+                    let parent = package.get("from").and_then(Value::as_str).unwrap_or("");
+                    let pattern = join(parent, include);
+                    targets.extend(
+                        directories
+                            .iter()
+                            .filter(|path| matches(&pattern, path))
+                            .cloned(),
+                    );
+                    targets.extend(
+                        files
+                            .iter()
+                            .filter(|path| matches(&pattern, path))
+                            .map(|path| (*path).to_owned()),
+                    );
+                }
+            }
+        }
+        if let Some(name) =
+            at(&project, &["tool", "flit", "module", "name"]).and_then(Value::as_str)
+        {
+            for parent in ["", "src"] {
+                let paths = module_paths(name, parent);
+                if !paths.is_empty() {
+                    targets.extend(paths);
+                    break;
+                }
+            }
+        }
+        // Backend declarations take precedence over the distribution name.
+        if targets.is_empty()
+            && let Some(name) = at(&project, &["project", "name"]).and_then(Value::as_str)
+        {
+            let name = name.replace(['-', '.'], "_");
+            for parent in ["", "src"] {
+                let paths = module_paths(&name, parent);
+                if !paths.is_empty() {
+                    targets.extend(paths);
+                    break;
+                }
+            }
+        }
+    }
+    if targets.is_empty() {
+        for directory in &directories {
+            if !directory.contains('/')
+                && !directory.starts_with('.')
+                && ![
+                    "tests",
+                    "test",
+                    "docs",
+                    "examples",
+                    "scripts",
+                    "benchmarks",
+                    "build",
+                    "dist",
+                    "vendor",
+                    "venv",
+                    "node_modules",
+                    "target",
+                    "__pycache__",
+                ]
+                .contains(&directory.as_str())
+                && files.contains(format!("{directory}/__init__.py").as_str())
+            {
+                targets.push(directory.clone());
+            }
+        }
+    }
+    targets.sort();
+    targets.dedup();
+    let parents = targets.clone();
+    targets.retain(|target| {
+        !parents
+            .iter()
+            .any(|parent| parent != target && target.starts_with(&format!("{parent}/")))
+    });
+    if targets.is_empty() {
+        targets.push(".".into());
+    }
+    targets
+}
diff --git a/crates/rio-adapters/src/secrets.rs b/crates/rio-adapters/src/secrets.rs
new file mode 100644
index 0000000..920b8f3
--- /dev/null
+++ b/crates/rio-adapters/src/secrets.rs
@@ -0,0 +1,89 @@
+use anyhow::Result;
+use rio_core::{
+    Category, EvidenceLevel, Finding, Location, OccurrenceState, Severity, Source, State,
+    finding_id, secret_matches_for_path,
+};
+pub use rio_core::{redact, redact_value, retained_raw, shannon_entropy};
+use rio_git::{Diff, Tree};
+
+pub fn scan_secrets(diff: &Diff, head: &Tree) -> Result<Vec<Finding>> {
+    let mut findings = Vec::new();
+    for file in &diff.files {
+        if file.binary
+            || file
+                .excluded
+                .as_deref()
+                .is_some_and(|reason| reason != "lockfile")
+        {
+            continue;
+        }
+        let Some(entry) = head.get(&file.path) else {
+            continue;
+        };
+        let Ok(content) = std::str::from_utf8(&entry.content) else {
+            continue;
+        };
+        for found in secret_matches_for_path(content, &file.path) {
+            let line_start = content[..found.start]
+                .bytes()
+                .filter(|&byte| byte == b'\n')
+                .count() as u32
+                + 1;
+            let line_end = line_start
+                + content[found.start..found.end]
+                    .bytes()
+                    .filter(|&byte| byte == b'\n')
+                    .count() as u32;
+            let new = file.hunks.iter().any(|hunk| {
+                hunk.head.count > 0
+                    && hunk.head.start <= line_end
+                    && hunk.head.start.saturating_add(hunk.head.count) > line_start
+            });
+            let occurrence_state = if new {
+                OccurrenceState::New
+            } else {
+                OccurrenceState::PreExisting
+            };
+            let location = Location {
+                path: file.path.clone(),
+                line_start,
+                line_end,
+                column: Some(
+                    content[..found.start]
+                        .rsplit('\n')
+                        .next()
+                        .unwrap()
+                        .chars()
+                        .count() as u32
+                        + 1,
+                ),
+                symbol_path: String::new(),
+                occurrence_state,
+            };
+            let rule_id = format!("secret/{}", found.pattern);
+            let trigger = redact_value(&content[found.start..found.end]);
+            let message = format!("Potential {} credential: {trigger}", found.pattern);
+            findings.push(Finding {
+                id: finding_id(&rule_id, &file.path, "", &message, ""),
+                rule_id,
+                category: Category::Defect,
+                evidence_level: EvidenceLevel::StaticProven,
+                severity: Severity::Error,
+                state: if new { State::New } else { State::PreExisting },
+                location: location.clone(),
+                message,
+                trigger,
+                impact: Some("A credential may be exposed by this change".into()),
+                suggested_fix: Some("Remove the credential and rotate it if it was active".into()),
+                evidence: vec![format!("Built-in credential pattern {}", found.pattern)],
+                source: Source::Tool {
+                    tool: "rio-secrets".into(),
+                    version: env!("CARGO_PKG_VERSION").into(),
+                },
+                locations: vec![location],
+                advisory: None,
+            });
+        }
+    }
+    Ok(findings)
+}
diff --git a/crates/rio-adapters/src/syntax.rs b/crates/rio-adapters/src/syntax.rs
new file mode 100644
index 0000000..12413e3
--- /dev/null
+++ b/crates/rio-adapters/src/syntax.rs
@@ -0,0 +1,497 @@
+use anyhow::{Context, Result, bail};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    sync::Mutex,
+};
+use streaming_iterator::StreamingIterator;
+use tree_sitter::{Language, Node, Parser, Query, QueryCursor};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SymbolKind {
+    File,
+    Function,
+    Method,
+    Class,
+    Interface,
+    TypeAlias,
+    Enum,
+    Variable,
+    Test,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Symbol {
+    pub name: String,
+    pub symbol_path: String,
+    pub kind: SymbolKind,
+    pub line_start: u32,
+    pub line_end: u32,
+    pub byte_start: usize,
+    pub byte_end: usize,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Identifier {
+    pub name: String,
+    pub line: u32,
+    pub byte_start: usize,
+    pub byte_end: usize,
+    pub call: bool,
+    pub shadowed: bool,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Import {
+    pub module: String,
+    /// Local name -> imported name (`*` for a namespace import).
+    pub names: BTreeMap<String, String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SyntaxTable {
+    pub symbols: Vec<Symbol>,
+    pub identifiers: Vec<Identifier>,
+    pub imports: Vec<Import>,
+    pub executable_lines: BTreeSet<u32>,
+    pub parse_errors: bool,
+}
+
+impl SyntaxTable {
+    pub fn enclosing_byte(&self, byte: usize) -> Option<&Symbol> {
+        self.symbols
+            .iter()
+            .filter(|symbol| symbol.byte_start <= byte && byte < symbol.byte_end)
+            .min_by_key(|symbol| symbol.byte_end - symbol.byte_start)
+    }
+    pub fn enclosing(&self, line: u32) -> Option<&Symbol> {
+        self.symbols
+            .iter()
+            .filter(|symbol| symbol.line_start <= line && line <= symbol.line_end)
+            .min_by_key(|symbol| symbol.byte_end - symbol.byte_start)
+    }
+}
+
+pub fn syntax_language(path: &str) -> Result<Language> {
+    Ok(match crate::language_for_path(path) {
+        Some("python") => tree_sitter_python::LANGUAGE.into(),
+        Some("typescript") if path.ends_with(".tsx") || path.ends_with(".jsx") => {
+            tree_sitter_typescript::LANGUAGE_TSX.into()
+        }
+        Some("typescript") => tree_sitter_typescript::LANGUAGE_TYPESCRIPT.into(),
+        _ => bail!("unsupported source file {path}"),
+    })
+}
+
+pub fn parse_source(path: &str, source: &[u8]) -> Result<tree_sitter::Tree> {
+    let mut parser = Parser::new();
+    parser.set_language(&syntax_language(path)?)?;
+    parser
+        .parse(source, None)
+        .context("parser did not return a tree")
+}
+
+fn text<'a>(node: Node<'_>, source: &'a [u8]) -> &'a str {
+    std::str::from_utf8(&source[node.byte_range()]).unwrap_or_default()
+}
+
+fn ignored_type(node: Node<'_>) -> bool {
+    matches!(
+        node.kind(),
+        "ambient_declaration"
+            | "interface_declaration"
+            | "type_alias_declaration"
+            | "type_annotation"
+            | "type_arguments"
+            | "type_parameters"
+    )
+}
+
+fn executable_tokens(node: Node<'_>, source: &[u8], lines: &mut BTreeSet<u32>) {
+    if ignored_type(node) || node.kind().contains("comment") {
+        return;
+    }
+    if node.child_count() == 0 {
+        let value = text(node, source).trim();
+        if !value.is_empty() && !matches!(value, "{" | "}" | ";" | "," | ":" | "(" | ")") {
+            lines.insert(node.start_position().row as u32 + 1);
+        }
+    } else {
+        let mut cursor = node.walk();
+        for child in node.children(&mut cursor) {
+            executable_tokens(child, source, lines);
+        }
+    }
+}
+
+fn inside_type(mut node: Node<'_>) -> bool {
+    loop {
+        if ignored_type(node) {
+            return true;
+        }
+        match node.parent() {
+            Some(parent) => node = parent,
+            None => return false,
+        }
+    }
+}
+
+fn symbol_kind(node: Node<'_>) -> SymbolKind {
+    match node.kind() {
+        "function_declaration" | "generator_function_declaration" | "function_definition" => {
+            if node.parent().is_some_and(|parent| {
+                parent.kind() == "block"
+                    && parent
+                        .parent()
+                        .is_some_and(|parent| parent.kind() == "class_definition")
+            }) {
+                SymbolKind::Method
+            } else {
+                SymbolKind::Function
+            }
+        }
+        "method_definition" => SymbolKind::Method,
+        "class_declaration" | "class_definition" => SymbolKind::Class,
+        "interface_declaration" => SymbolKind::Interface,
+        "type_alias_declaration" => SymbolKind::TypeAlias,
+        "enum_declaration" => SymbolKind::Enum,
+        "variable_declarator" => {
+            if node.child_by_field_name("value").is_some_and(|value| {
+                matches!(value.kind(), "arrow_function" | "function_expression")
+            }) {
+                SymbolKind::Function
+            } else {
+                SymbolKind::Variable
+            }
+        }
+        _ => SymbolKind::Variable,
+    }
+}
+
+fn declaration_ancestor(node: Node<'_>) -> bool {
+    matches!(
+        node.kind(),
+        "function_declaration"
+            | "generator_function_declaration"
+            | "function_definition"
+            | "method_definition"
+            | "class_declaration"
+            | "class_definition"
+            | "interface_declaration"
+            | "enum_declaration"
+    ) || node.kind() == "variable_declarator"
+        && node
+            .child_by_field_name("value")
+            .is_some_and(|value| matches!(value.kind(), "arrow_function" | "function_expression"))
+}
+
+fn unquote(value: &str) -> String {
+    value.trim_matches(['\'', '"']).to_owned()
+}
+
+fn collect_import(node: Node<'_>, source: &[u8], imports: &mut Vec<Import>) {
+    if node.kind() == "import_statement"
+        && let Some(module) = node.child_by_field_name("source")
+    {
+        let mut import = Import {
+            module: unquote(text(module, source)),
+            names: BTreeMap::new(),
+        };
+        fn names(node: Node<'_>, source: &[u8], result: &mut BTreeMap<String, String>) {
+            if node.kind() == "import_specifier" {
+                if let Some(name) = node.child_by_field_name("name") {
+                    let alias = node.child_by_field_name("alias").unwrap_or(name);
+                    result.insert(text(alias, source).into(), text(name, source).into());
+                }
+                return;
+            }
+            if node.kind() == "namespace_import" {
+                let mut cursor = node.walk();
+                if let Some(name) = node
+                    .named_children(&mut cursor)
+                    .find(|child| child.kind() == "identifier")
+                {
+                    result.insert(text(name, source).into(), "*".into());
+                }
+                return;
+            }
+            if node.kind() == "identifier"
+                && node
+                    .parent()
+                    .is_some_and(|parent| parent.kind() == "import_clause")
+            {
+                result.insert(text(node, source).into(), "default".into());
+            }
+            let mut cursor = node.walk();
+            for child in node.named_children(&mut cursor) {
+                names(child, source, result);
+            }
+        }
+        names(node, source, &mut import.names);
+        imports.push(import);
+    } else if node.kind() == "import_from_statement" {
+        let module = node
+            .child_by_field_name("module_name")
+            .map(|module| text(module, source).to_owned())
+            .unwrap_or_default();
+        let mut import = Import {
+            module,
+            names: BTreeMap::new(),
+        };
+        let mut cursor = node.walk();
+        for child in node.named_children(&mut cursor) {
+            if child.kind() == "aliased_import" {
+                if let Some(name) = child.child_by_field_name("name") {
+                    let alias = child.child_by_field_name("alias").unwrap_or(name);
+                    import
+                        .names
+                        .insert(text(alias, source).into(), text(name, source).into());
+                }
+            } else if child.kind() == "dotted_name"
+                && Some(child.id())
+                    != node
+                        .child_by_field_name("module_name")
+                        .map(|node| node.id())
+            {
+                let name = text(child, source);
+                import.names.insert(name.into(), name.into());
+            }
+        }
+        imports.push(import);
+    } else if node.kind() == "import_statement" {
+        let mut cursor = node.walk();
+        for child in node.named_children(&mut cursor) {
+            let name = child.child_by_field_name("name").unwrap_or(child);
+            let module = text(name, source).to_owned();
+            let alias = child
+                .child_by_field_name("alias")
+                .map(|alias| text(alias, source))
+                .unwrap_or_else(|| module.split('.').next().unwrap_or_default());
+            imports.push(Import {
+                module: module.clone(),
+                names: [(alias.into(), "*".into())].into(),
+            });
+        }
+    }
+}
+
+fn identifiers(node: Node<'_>, source: &[u8], result: &mut SyntaxTable) {
+    if matches!(
+        node.kind(),
+        "comment" | "string" | "string_fragment" | "template_string"
+    ) {
+        return;
+    }
+    if matches!(node.kind(), "import_statement" | "import_from_statement") {
+        collect_import(node, source, &mut result.imports);
+        return;
+    }
+    if matches!(
+        node.kind(),
+        "identifier" | "property_identifier" | "type_identifier"
+    ) {
+        let parent = node.parent();
+        let definition = parent.is_some_and(|parent| {
+            (declaration_ancestor(parent)
+                || matches!(
+                    parent.kind(),
+                    "variable_declarator" | "assignment" | "type_alias_declaration"
+                ))
+                && (parent
+                    .child_by_field_name("name")
+                    .or_else(|| parent.child_by_field_name("left")))
+                .is_some_and(|name| name.id() == node.id())
+        });
+        if !definition {
+            result.identifiers.push(Identifier {
+                name: text(node, source).into(),
+                line: node.start_position().row as u32 + 1,
+                byte_start: node.start_byte(),
+                byte_end: node.end_byte(),
+                call: parent.is_some_and(|parent| {
+                    matches!(
+                        parent.kind(),
+                        "call_expression" | "call" | "member_expression" | "attribute"
+                    )
+                }),
+                shadowed: parameter_binding(node, source),
+            });
+        }
+    }
+    let mut cursor = node.walk();
+    for child in node.named_children(&mut cursor) {
+        identifiers(child, source, result);
+    }
+}
+
+fn parameter_binding(node: Node<'_>, source: &[u8]) -> bool {
+    if node.kind() == "property_identifier"
+        || node.parent().is_some_and(|parent| {
+            parent.kind() == "attribute"
+                && parent
+                    .child_by_field_name("attribute")
+                    .is_some_and(|attribute| attribute.id() == node.id())
+        })
+    {
+        return false;
+    }
+    fn contains_name(node: Node<'_>, name: &str, source: &[u8]) -> bool {
+        if node.kind() == "type_annotation" || node.kind() == "type" {
+            return false;
+        }
+        if node.kind() == "identifier" {
+            return text(node, source) == name;
+        }
+        let binding = node
+            .child_by_field_name("pattern")
+            .or_else(|| node.child_by_field_name("name"))
+            .or_else(|| node.child_by_field_name("left"));
+        if let Some(binding) = binding {
+            return contains_name(binding, name, source);
+        }
+        let mut cursor = node.walk();
+        node.named_children(&mut cursor)
+            .any(|child| contains_name(child, name, source))
+    }
+    let mut ancestor = node.parent();
+    while let Some(parent) = ancestor {
+        if let Some(parameters) = parent.child_by_field_name("parameters")
+            && contains_name(parameters, text(node, source), source)
+        {
+            return true;
+        }
+        ancestor = parent.parent();
+    }
+    false
+}
+
+pub fn analyze_source(path: &str, source: &[u8]) -> Result<SyntaxTable> {
+    let tree = parse_source(path, source)?;
+    let language = syntax_language(path)?;
+    let python = crate::language_for_path(path) == Some("python");
+    let symbols_query = if python {
+        include_str!("../../../modules/adapters/python/queries/symbols.scm")
+    } else {
+        include_str!("../../../modules/adapters/typescript/queries/symbols.scm")
+    };
+    let query = Query::new(&language, symbols_query)?;
+    let mut result = SyntaxTable {
+        parse_errors: tree.root_node().has_error(),
+        ..Default::default()
+    };
+    let mut cursor = QueryCursor::new();
+    let mut matches = cursor.matches(&query, tree.root_node(), source);
+    let stem = path
+        .rsplit('/')
+        .next()
+        .unwrap_or(path)
+        .rsplit_once('.')
+        .map_or(path, |(stem, _)| stem);
+    while let Some(matched) = matches.next() {
+        let capture = |name| {
+            matched
+                .captures
+                .iter()
+                .find(|capture| query.capture_names()[capture.index as usize] == name)
+                .map(|capture| capture.node)
+        };
+        let (Some(node), Some(name)) = (capture("symbol"), capture("name")) else {
+            continue;
+        };
+        if node.kind() == "variable_declarator" && symbol_kind(node) == SymbolKind::Variable {
+            let mut ancestor = node.parent();
+            let mut exported = false;
+            while let Some(parent) = ancestor {
+                if parent.kind() == "export_statement" {
+                    exported = true;
+                    break;
+                }
+                if matches!(parent.kind(), "program" | "statement_block") {
+                    break;
+                }
+                ancestor = parent.parent();
+            }
+            if !exported {
+                continue;
+            }
+        }
+        if node.kind() == "assignment"
+            && node.parent().is_some_and(|parent| {
+                parent.kind() != "expression_statement"
+                    || parent
+                        .parent()
+                        .is_none_or(|parent| parent.kind() != "module")
+            })
+        {
+            continue;
+        }
+        let mut names = vec![text(name, source).to_owned()];
+        let mut ancestor = node.parent();
+        while let Some(parent) = ancestor {
+            if declaration_ancestor(parent)
+                && let Some(name) = parent.child_by_field_name("name")
+            {
+                names.push(text(name, source).into());
+            }
+            ancestor = parent.parent();
+        }
+        names.push(stem.into());
+        names.reverse();
+        result.symbols.push(Symbol {
+            name: text(name, source).into(),
+            symbol_path: names.join("."),
+            kind: symbol_kind(node),
+            line_start: node.start_position().row as u32 + 1,
+            line_end: node.end_position().row as u32 + 1,
+            byte_start: node.start_byte(),
+            byte_end: node.end_byte(),
+        });
+    }
+    result
+        .symbols
+        .sort_by_key(|symbol| (symbol.byte_start, symbol.byte_end));
+    identifiers(tree.root_node(), source, &mut result);
+    if !path.ends_with(".d.ts")
+        && !path.ends_with(".d.mts")
+        && !path.ends_with(".d.cts")
+        && !path.ends_with(".pyi")
+    {
+        let query = Query::new(
+            &language,
+            if python {
+                include_str!("../../../modules/adapters/python/queries/executable.scm")
+            } else {
+                include_str!("../../../modules/adapters/typescript/queries/executable.scm")
+            },
+        )?;
+        let mut cursor = QueryCursor::new();
+        let mut matches = cursor.matches(&query, tree.root_node(), source);
+        while let Some(matched) = matches.next() {
+            for capture in matched.captures {
+                if !inside_type(capture.node) {
+                    executable_tokens(capture.node, source, &mut result.executable_lines);
+                }
+            }
+        }
+    }
+    Ok(result)
+}
+
+/// The content hash and grammar select a table; paths contribute only their
+/// module stem, which is part of every symbol path.
+#[derive(Default)]
+pub struct SyntaxCache {
+    tables: Mutex<BTreeMap<String, SyntaxTable>>,
+}
+impl SyntaxCache {
+    pub fn analyze(&self, path: &str, source: &[u8]) -> Result<SyntaxTable> {
+        let key = format!("{path}:{}", blake3::hash(source));
+        if let Some(table) = self.tables.lock().unwrap().get(&key) {
+            return Ok(table.clone());
+        }
+        let table = analyze_source(path, source)?;
+        self.tables.lock().unwrap().insert(key, table.clone());
+        Ok(table)
+    }
+}
diff --git a/crates/rio-adapters/src/tools.rs b/crates/rio-adapters/src/tools.rs
new file mode 100644
index 0000000..7c589ce
--- /dev/null
+++ b/crates/rio-adapters/src/tools.rs
@@ -0,0 +1,369 @@
+use std::{
+    collections::BTreeMap,
+    path::{Path, PathBuf},
+    time::Duration,
+};
+
+use anyhow::{Context, Result};
+use rio_core::{CheckDetails, CheckOutcome, FailureReason, Finding, SkipReason};
+use rio_profile::ModuleManifest;
+use serde::{Deserialize, Serialize};
+use tokio_util::sync::CancellationToken;
+
+use crate::{ProcessResult, ProcessSupervisor, Termination, ToolCommand, redact};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Capability {
+    Parse,
+    Typecheck,
+    Lint,
+    Test,
+    Coverage,
+    Scan,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ExitCodeContract {
+    pub clean: Vec<i32>,
+    pub diagnostics: Vec<i32>,
+    #[serde(default)]
+    pub failed: BTreeMap<i32, FailureReason>,
+    #[serde(default)]
+    pub skipped: BTreeMap<i32, SkipReason>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ToolSpec {
+    pub name: String,
+    pub command: Vec<String>,
+    pub network: Vec<String>,
+    pub exit_codes: ExitCodeContract,
+}
+
+/// Adapters describe and parse tool execution. The engine owns scheduling,
+/// compatibility checks, disposable trees, supervision and baseline comparison.
+pub trait Adapter: Send + Sync {
+    fn manifest(&self) -> &'static ModuleManifest;
+    fn language(&self) -> &'static str;
+    fn parse_output(
+        &self,
+        tool: &str,
+        stdout: &[u8],
+        stderr: &[u8],
+        context: &DiagnosticContext<'_>,
+    ) -> Result<Vec<Finding>>;
+    fn tools(&self, capability: Capability) -> Result<Vec<ToolSpec>> {
+        let key = serde_json::to_value(capability)?
+            .as_str()
+            .unwrap()
+            .to_owned();
+        match self.manifest().tools.get(&key) {
+            Some(value) => Ok(serde_json::from_value(value.clone())?),
+            None => Ok(Vec::new()),
+        }
+    }
+    fn supports(&self, capability: Capability) -> bool {
+        serde_json::to_value(capability)
+            .ok()
+            .and_then(|value| value.as_str().map(str::to_owned))
+            .is_some_and(|name| self.manifest().capabilities.contains(&name))
+    }
+}
+
+pub struct DiagnosticContext<'a> {
+    pub repository_root: &'a Path,
+    pub project_root: &'a str,
+    pub tool_version: &'a str,
+    pub worktree_root: Option<&'a Path>,
+    pub sources: Option<&'a rio_git::Tree>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ResolvedTool {
+    pub name: String,
+    pub path: PathBuf,
+    pub version: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub version_hint: Option<String>,
+}
+
+pub struct ToolResolver {
+    pub repository_root: PathBuf,
+    pub search_path: Vec<PathBuf>,
+    pub virtual_env: Option<PathBuf>,
+}
+
+impl ToolResolver {
+    pub fn from_environment(repository_root: PathBuf) -> Self {
+        Self {
+            repository_root,
+            search_path: std::env::var_os("PATH")
+                .map(|path| std::env::split_paths(&path).collect())
+                .unwrap_or_default(),
+            virtual_env: std::env::var_os("VIRTUAL_ENV").map(PathBuf::from),
+        }
+    }
+    fn candidates(directory: &Path, name: &str) -> Vec<PathBuf> {
+        #[cfg(windows)]
+        {
+            ["exe", "cmd", "bat"]
+                .into_iter()
+                .map(|extension| directory.join(format!("{name}.{extension}")))
+                .chain(std::iter::once(directory.join(name)))
+                .collect()
+        }
+        #[cfg(not(windows))]
+        {
+            vec![directory.join(name)]
+        }
+    }
+    /// Existing local tools win even when they cannot execute, so the run
+    /// reports `spawn_failed` instead of silently invoking an unrelated PATH tool.
+    pub fn locate(&self, name: &str, project_root: &str, language: &str) -> Option<PathBuf> {
+        let root = self.repository_root.join(project_root);
+        let mut directories = Vec::new();
+        for directory in root
+            .ancestors()
+            .take_while(|directory| directory.starts_with(&self.repository_root))
+        {
+            if language == "typescript" {
+                directories.push(directory.join("node_modules/.bin"));
+            } else {
+                let bin = if cfg!(windows) { "Scripts" } else { "bin" };
+                directories.extend([
+                    directory.join(".venv").join(bin),
+                    directory.join("venv").join(bin),
+                ]);
+            }
+        }
+        if language == "python"
+            && let Some(environment) = &self.virtual_env
+        {
+            directories.push(environment.join(if cfg!(windows) { "Scripts" } else { "bin" }));
+        }
+        directories.extend(self.search_path.clone());
+        directories
+            .into_iter()
+            .flat_map(|directory| Self::candidates(&directory, name))
+            .find(|path| path.is_file())
+    }
+    pub async fn resolve(
+        &self,
+        name: &str,
+        project_root: &str,
+        language: &str,
+        supervisor: &ProcessSupervisor,
+        cancellation: CancellationToken,
+    ) -> Option<ResolvedTool> {
+        let path = self.locate(name, project_root, language)?;
+        let probe_tree = match tempfile::tempdir() {
+            Ok(directory) => directory,
+            Err(error) => {
+                return Some(ResolvedTool {
+                    name: name.into(),
+                    path,
+                    version: "unknown".into(),
+                    version_hint: Some(format!(
+                        "could not create disposable version-probe directory: {error}"
+                    )),
+                });
+            }
+        };
+        let mut command = ToolCommand::new(path.clone(), probe_tree.path().into());
+        command.args = vec!["--version".into()];
+        command.timeout = Duration::from_secs(10);
+        command.output_limit = 64 * 1024;
+        let result = supervisor.run(command, cancellation).await;
+        let output = if result.stdout.is_empty() {
+            &result.stderr
+        } else {
+            &result.stdout
+        };
+        let version = String::from_utf8_lossy(output)
+            .lines()
+            .find(|line| !line.trim().is_empty())
+            .map(str::trim)
+            .map(str::to_owned);
+        let (mut version, mut version_hint) = match (&result.termination, version) {
+            (Termination::Exited { code: Some(0) }, Some(version)) if result.cleanup_confirmed => {
+                (redact(&version), None)
+            }
+            _ => (
+                "unknown".into(),
+                Some(format!(
+                    "{} version could not be captured: {:?}",
+                    path.display(),
+                    result.termination
+                )),
+            ),
+        };
+        // Package metadata is authoritative for JS CLIs; launcher output may
+        // include platform text or belong to a workspace shim.
+        if language == "typescript"
+            && let Some(installed) =
+                installed_package_version(&path, &self.repository_root.join(project_root), name)
+        {
+            version = installed;
+        }
+        if !result.cleanup_confirmed {
+            let preserved = probe_tree.keep();
+            version_hint = Some(format!(
+                "{}; version-probe directory retained at {} because cleanup could not be confirmed: {}",
+                version_hint.unwrap_or_default(),
+                preserved.display(),
+                result.survivors.join("; ")
+            ));
+        }
+        Some(ResolvedTool {
+            name: name.into(),
+            path,
+            version,
+            version_hint,
+        })
+    }
+}
+
+pub fn evaluate_exit(
+    result: &ProcessResult,
+    contract: &ExitCodeContract,
+    parsed: Result<Vec<Finding>>,
+) -> CheckOutcome {
+    // The Biome adapter uses a typed signal because an empty target set has
+    // neither findings nor a successful exit code. Keep this distinct from
+    // malformed output and require a normal, fully cleaned-up exit.
+    let biome_no_files = parsed
+        .as_ref()
+        .is_err_and(|error| error.is::<crate::diagnostics::BiomeNoFilesProcessed>());
+    let (findings, parse_error) = match parsed {
+        Ok(findings) => (findings, None),
+        Err(error) => (Vec::new(), Some(redact(&error.to_string()))),
+    };
+    let mut details = CheckDetails {
+        findings,
+        ..Default::default()
+    };
+    if !result.survivors.is_empty() {
+        details.hint = Some(result.survivors.join("; "));
+    }
+    match &result.termination {
+        Termination::Cancelled { reason } => {
+            return CheckOutcome::Cancelled {
+                reason: *reason,
+                details,
+            };
+        }
+        Termination::Failed { reason, hint } => {
+            details.hint = Some(redact(hint));
+            return CheckOutcome::Failed {
+                reason: *reason,
+                details,
+            };
+        }
+        Termination::Exited { .. } => {}
+    }
+    let Termination::Exited { code: Some(code) } = result.termination else {
+        details.hint = Some("tool terminated by a signal".into());
+        return CheckOutcome::Failed {
+            reason: FailureReason::ToolCrashed,
+            details,
+        };
+    };
+    if let Some(reason) = contract.failed.get(&code) {
+        if *reason == FailureReason::ToolConfigError {
+            details.findings.clear();
+        }
+        details.hint = Some(format!("tool exited with code {code}"));
+        return CheckOutcome::Failed {
+            reason: *reason,
+            details,
+        };
+    }
+    if let Some(reason) = contract.skipped.get(&code) {
+        return CheckOutcome::Skipped {
+            reason: *reason,
+            details,
+        };
+    }
+    if biome_no_files && code == 1 && result.cleanup_confirmed {
+        details.hint = parse_error;
+        return CheckOutcome::Skipped {
+            reason: SkipReason::Disabled,
+            details,
+        };
+    }
+    if !contract.clean.contains(&code) && !contract.diagnostics.contains(&code) {
+        details.hint = Some(format!("tool exited with undeclared code {code}"));
+        return CheckOutcome::Failed {
+            reason: FailureReason::ToolCrashed,
+            details,
+        };
+    }
+    if let Some(error) = parse_error {
+        details.hint = Some(error);
+        return CheckOutcome::Failed {
+            reason: FailureReason::UnparseableOutput,
+            details,
+        };
+    }
+    if contract.diagnostics.contains(&code) && details.findings.is_empty() {
+        details.hint = Some(format!(
+            "tool exited with diagnostics code {code} but no diagnostics could be parsed"
+        ));
+        return CheckOutcome::Failed {
+            reason: FailureReason::UnparseableOutput,
+            details,
+        };
+    }
+    if !result.cleanup_confirmed {
+        details.hint.get_or_insert_with(|| {
+            "tool process cleanup could not be confirmed; disposable tree retained".into()
+        });
+        return CheckOutcome::Failed {
+            reason: FailureReason::ToolCrashed,
+            details,
+        };
+    }
+    if details.findings.is_empty() {
+        CheckOutcome::Passed { details }
+    } else {
+        CheckOutcome::Findings { details }
+    }
+}
+
+pub fn tool_contract(module: &str, capability: &str, tool: &str) -> Result<ToolSpec> {
+    let manifest = rio_profile::resolve_module(module)?;
+    let tools: Vec<ToolSpec> = serde_json::from_value(
+        manifest
+            .tools
+            .get(capability)
+            .context("capability has no tool declarations")?
+            .clone(),
+    )?;
+    tools
+        .into_iter()
+        .find(|spec| spec.name == tool)
+        .context("tool is not declared by the adapter")
+}
+
+fn installed_package_version(executable: &Path, project: &Path, name: &str) -> Option<String> {
+    let canonical = executable.canonicalize().ok();
+    let direct = canonical
+        .as_deref()
+        .into_iter()
+        .flat_map(Path::ancestors)
+        .map(|directory| directory.join("package.json"));
+    let local = project.ancestors().map(|directory| {
+        directory
+            .join("node_modules")
+            .join(name)
+            .join("package.json")
+    });
+    direct.chain(local).find_map(|manifest| {
+        let value: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(manifest).ok()?).ok()?;
+        (value["name"].as_str() == Some(name))
+            .then(|| value["version"].as_str().map(str::to_owned))
+            .flatten()
+    })
+}
diff --git a/crates/rio-adapters/tests/audit.rs b/crates/rio-adapters/tests/audit.rs
new file mode 100644
index 0000000..1851dfe
--- /dev/null
+++ b/crates/rio-adapters/tests/audit.rs
@@ -0,0 +1,335 @@
+mod common;
+use common::*;
+use rio_adapters::*;
+use rio_core::{AdvisorySeverity, CheckOutcome, FailureReason, SkipReason};
+use rio_git::{Tree, diff};
+use serde_json::{Value, json};
+use std::{
+    io::{Read, Write},
+    net::TcpListener,
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    time::{Duration, Instant},
+};
+use tokio_util::sync::CancellationToken;
+
+struct Server {
+    base: String,
+    requests: Arc<Mutex<Vec<(String, Value)>>>,
+    running: Arc<AtomicBool>,
+    thread: Option<std::thread::JoinHandle<()>>,
+}
+impl Server {
+    fn new(handler: impl Fn(&str, &Value, usize) -> (u16, Value) + Send + 'static) -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let base = format!("http://{}", listener.local_addr().unwrap());
+        let requests = Arc::new(Mutex::new(Vec::new()));
+        let running = Arc::new(AtomicBool::new(true));
+        let log = requests.clone();
+        let live = running.clone();
+        let thread = std::thread::spawn(move || {
+            while live.load(Ordering::SeqCst) {
+                let (mut stream, _) = match listener.accept() {
+                    Ok(connection) => connection,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        std::thread::sleep(Duration::from_millis(5));
+                        continue;
+                    }
+                    Err(error) => panic!("{error}"),
+                };
+                // macOS inherits the listener's nonblocking mode on accept.
+                // Reads must wait for the client to finish sending the request.
+                stream.set_nonblocking(false).unwrap();
+                stream
+                    .set_read_timeout(Some(Duration::from_secs(2)))
+                    .unwrap();
+                let mut bytes = Vec::new();
+                let header_end;
+                loop {
+                    let mut byte = [0];
+                    stream.read_exact(&mut byte).unwrap();
+                    bytes.push(byte[0]);
+                    if bytes.ends_with(b"\r\n\r\n") {
+                        header_end = bytes.len();
+                        break;
+                    }
+                }
+                let header = String::from_utf8_lossy(&bytes).into_owned();
+                let length = header
+                    .lines()
+                    .find_map(|line| {
+                        line.to_lowercase()
+                            .strip_prefix("content-length:")
+                            .map(|value| value.trim().parse::<usize>().unwrap())
+                    })
+                    .unwrap_or(0);
+                bytes.resize(header_end + length, 0);
+                stream.read_exact(&mut bytes[header_end..]).unwrap();
+                let body = if length == 0 {
+                    Value::Null
+                } else {
+                    serde_json::from_slice(&bytes[header_end..]).unwrap()
+                };
+                let path = header
+                    .lines()
+                    .next()
+                    .unwrap()
+                    .split_whitespace()
+                    .nth(1)
+                    .unwrap();
+                let ordinal = {
+                    let mut requests = log.lock().unwrap();
+                    requests.push((path.to_owned(), body.clone()));
+                    requests.len()
+                };
+                let (status, body) = handler(path, &body, ordinal);
+                let body = serde_json::to_vec(&body).unwrap();
+                write!(stream, "HTTP/1.1 {status} response\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", body.len()).unwrap();
+                stream.write_all(&body).unwrap();
+            }
+        });
+        Self {
+            base,
+            requests,
+            running,
+            thread: Some(thread),
+        }
+    }
+    fn count(&self, path: &str) -> usize {
+        self.requests
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|(request, _)| request == path)
+            .count()
+    }
+}
+impl Drop for Server {
+    fn drop(&mut self) {
+        self.running.store(false, Ordering::SeqCst);
+        self.thread.take().unwrap().join().unwrap();
+    }
+}
+fn package() -> AuditPackage {
+    AuditPackage {
+        ecosystem: Ecosystem::Npm,
+        name: "sample".into(),
+        version: "1.5.0".into(),
+        path: "package-lock.json".into(),
+    }
+}
+fn advisory(id: &str, alias: &str) -> Value {
+    json!({"id":id,"aliases":[alias],"modified":"2026-01-01T00:00:00Z","database_specific":{"severity":"HIGH"},"affected":[{"package":{"ecosystem":"npm","name":"sample"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"1.6.0"},{"introduced":"2.0.0"},{"fixed":"2.1.0"}]}]}]})
+}
+
+#[tokio::test]
+async fn pagination_alias_grouping_and_modified_cache_avoid_duplicate_detail_requests() {
+    let server = Server::new(|path, body, _| match path {
+        "/v1/querybatch" if body["queries"][0]["page_token"].is_null() => {
+            assert_eq!(body["queries"][0]["package"]["ecosystem"], "npm");
+            (
+                200,
+                json!({"results":[{"vulns":[{"id":"GHSA-a","modified":"2026-01-01"}],"next_page_token":"next"}]}),
+            )
+        }
+        "/v1/querybatch" => {
+            assert_eq!(body["queries"][0]["page_token"], "next");
+            (
+                200,
+                json!({"results":[{"vulns":[{"id":"PYSEC-b","modified":"2026-01-01"}]}]}),
+            )
+        }
+        "/v1/vulns/GHSA-a" => (200, advisory("GHSA-a", "PYSEC-b")),
+        "/v1/vulns/PYSEC-b" => (200, advisory("PYSEC-b", "GHSA-a")),
+        _ => (404, json!({})),
+    });
+    let cache = tempfile::tempdir().unwrap();
+    let client = OsvClient::with_base(cache.path().into(), server.base.clone()).unwrap();
+    for _ in 0..2 {
+        let outcome = client
+            .audit(&[package()], false, CancellationToken::new())
+            .await;
+        assert!(
+            matches!(outcome, CheckOutcome::Findings { .. }),
+            "{outcome:?}"
+        );
+        assert_eq!(outcome.details().findings.len(), 1);
+        let finding = &outcome.details().findings[0];
+        let advisory = finding.advisory.as_ref().unwrap();
+        assert_eq!(advisory.id, "GHSA-a");
+        assert_eq!(advisory.aliases, ["PYSEC-b"]);
+        assert_eq!(advisory.severity, AdvisorySeverity::High);
+        assert_eq!(advisory.fixed_version, "1.6.0");
+        assert_eq!(finding.rule_id, "dependency/vulnerable_dependency");
+    }
+    assert_eq!(server.count("/v1/querybatch"), 4);
+    assert_eq!(server.count("/v1/vulns/GHSA-a"), 1);
+    assert_eq!(server.count("/v1/vulns/PYSEC-b"), 1);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        assert_eq!(
+            std::fs::metadata(cache.path().join("osv/GHSA-a.json"))
+                .unwrap()
+                .permissions()
+                .mode()
+                & 0o777,
+            0o600
+        );
+    }
+}
