+use serde::{Deserialize, Serialize};
+
+/// Evidence is ordered from weakest to strongest; no numeric confidence is used.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum EvidenceLevel {
+    Refuted,
+    Plausible,
+    StaticProven,
+    Reproduced,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Category {
+    Defect,
+    Risk,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Severity {
+    Error,
+    Warning,
+    Info,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum State {
+    New,
+    Worsened,
+    PreExisting,
+    Fixed,
+    Unclassified,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum OccurrenceState {
+    New,
+    PreExisting,
+    Fixed,
+    Unclassified,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Location {
+    pub path: String,
+    pub line_start: u32,
+    pub line_end: u32,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub column: Option<u32>,
+    pub symbol_path: String,
+    pub occurrence_state: OccurrenceState,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum AdvisorySeverity {
+    Critical,
+    High,
+    Moderate,
+    Low,
+    Unknown,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Advisory {
+    pub id: String,
+    pub aliases: Vec<String>,
+    pub severity: AdvisorySeverity,
+    /// "unknown" when the advisory has no applicable fixed version.
+    pub fixed_version: String,
+    pub url: String,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum Source {
+    Tool { tool: String, version: String },
+    Agent { agent: String },
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Finding {
+    pub id: String,
+    pub rule_id: String,
+    pub category: Category,
+    pub evidence_level: EvidenceLevel,
+    pub severity: Severity,
+    pub state: State,
+    pub location: Location,
+    pub message: String,
+    pub trigger: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub impact: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub suggested_fix: Option<String>,
+    pub evidence: Vec<String>,
+    pub source: Source,
+    pub locations: Vec<Location>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub advisory: Option<Advisory>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum CheckKind {
+    Typecheck,
+    Lint,
+    Secrets,
+    Coverage,
+    Dependencies,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Version {
+    Base,
+    Head,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ScheduledAs {
+    Changed,
+    Dependent,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum DependencyState {
+    Verified,
+    Trusted,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FailureReason {
+    SpawnFailed,
+    ToolCrashed,
+    ToolConfigError,
+    UnparseableOutput,
+    OutputLimit,
+    DiskFull,
+    TestsFailed,
+    NetworkError,
+    PartialData,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SkipReason {
+    ToolMissing,
+    NoProjectConfig,
+    NotSupportedByAdapter,
+    Disabled,
+    Offline,
+    DependencyMismatch,
+    NoTests,
+    NothingToAudit,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum CancellationReason {
+    Timeout,
+    Interrupted,
+}
+
+/// Results remain available even when a check fails or is cancelled.
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct CheckDetails {
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub hint: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub dependency_state: Option<DependencyState>,
+    pub findings: Vec<Finding>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(tag = "outcome", rename_all = "lowercase")]
+pub enum CheckOutcome {
+    Passed {
+        #[serde(flatten)]
+        details: CheckDetails,
+    },
+    Findings {
+        #[serde(flatten)]
+        details: CheckDetails,
+    },
+    Failed {
+        reason: FailureReason,
+        #[serde(flatten)]
+        details: CheckDetails,
+    },
+    Skipped {
+        reason: SkipReason,
+        #[serde(flatten)]
+        details: CheckDetails,
+    },
+    Cancelled {
+        reason: CancellationReason,
+        #[serde(flatten)]
+        details: CheckDetails,
+    },
+}
+
+impl CheckOutcome {
+    pub fn details(&self) -> &CheckDetails {
+        match self {
+            Self::Passed { details }
+            | Self::Findings { details }
+            | Self::Failed { details, .. }
+            | Self::Skipped { details, .. }
+            | Self::Cancelled { details, .. } => details,
+        }
+    }
+
+    pub fn details_mut(&mut self) -> &mut CheckDetails {
+        match self {
+            Self::Passed { details }
+            | Self::Findings { details }
+            | Self::Failed { details, .. }
+            | Self::Skipped { details, .. }
+            | Self::Cancelled { details, .. } => details,
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct CheckEntry {
+    pub kind: CheckKind,
+    pub language: String,
+    pub root: String,
+    pub version: Version,
+    pub scheduled_as: ScheduledAs,
+    #[serde(flatten)]
+    pub outcome: CheckOutcome,
+    pub wall_time_ms: u64,
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub cached: bool,
+}
diff --git a/crates/rio-core/src/policy.rs b/crates/rio-core/src/policy.rs
new file mode 100644
index 0000000..5b01be8
--- /dev/null
+++ b/crates/rio-core/src/policy.rs
@@ -0,0 +1,224 @@
+use std::collections::BTreeSet;
+
+use globset::{Glob, GlobBuilder, GlobMatcher};
+use serde::{Deserialize, Serialize};
+
+use crate::{
+    Category, CheckKind, CheckOutcome, EvidenceLevel, Finding, Report, ReportStatus, SkipReason,
+    State, SuppressionCount,
+};
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum Suppression {
+    Path { path: String },
+    Rule { rule: String },
+    Finding { finding: String },
+}
+
+pub enum CompiledSuppression {
+    Path(GlobMatcher),
+    Rule(GlobMatcher),
+    Finding(String),
+}
+
+impl Suppression {
+    pub fn compile(&self) -> Result<CompiledSuppression, globset::Error> {
+        Ok(match self {
+            Self::Path { path } => CompiledSuppression::Path(
+                GlobBuilder::new(path)
+                    .literal_separator(true)
+                    .build()?
+                    .compile_matcher(),
+            ),
+            Self::Rule { rule } => CompiledSuppression::Rule(Glob::new(rule)?.compile_matcher()),
+            Self::Finding { finding } => CompiledSuppression::Finding(finding.clone()),
+        })
+    }
+}
+
+impl CompiledSuppression {
+    pub fn matches(&self, finding: &Finding) -> bool {
+        match self {
+            Self::Path(glob) => {
+                glob.is_match(&finding.location.path)
+                    || finding.locations.iter().any(|l| glob.is_match(&l.path))
+            }
+            Self::Rule(glob) => glob.is_match(&finding.rule_id),
+            Self::Finding(id) => finding.id == *id,
+        }
+    }
+}
+
+/// Apply suppressions to every serialized copy of a finding. Attribute a finding
+/// to the first matching entry, so overlapping entries do not inflate totals.
+pub fn apply_suppressions(
+    report: &mut Report,
+    suppressions: &[Suppression],
+) -> Result<(), globset::Error> {
+    let compiled: Vec<_> = suppressions
+        .iter()
+        .map(Suppression::compile)
+        .collect::<Result<_, _>>()?;
+    let mut counts = vec![0; compiled.len()];
+    let mut suppressed = BTreeSet::new();
+    for finding in report.findings.iter().chain(&report.risks) {
+        if let Some(index) = compiled.iter().position(|s| s.matches(finding))
+            && suppressed.insert(finding.id.clone())
+        {
+            counts[index] += 1;
+        }
+    }
+    report.findings.retain(|f| !suppressed.contains(&f.id));
+    report.risks.retain(|f| !suppressed.contains(&f.id));
+    for check in report.checks.iter_mut().chain(&mut report.incomplete) {
+        check
+            .outcome
+            .details_mut()
+            .findings
+            .retain(|f| !suppressed.contains(&f.id));
+    }
+    report.summary.suppressed = suppressed.len();
+    report.footer.suppressions = counts
+        .into_iter()
+        .enumerate()
+        .filter_map(|(entry, count)| (count > 0).then_some(SuppressionCount { entry, count }))
+        .collect();
+    Ok(())
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct FailOn {
+    pub evidence: EvidenceLevel,
+    pub categories: Vec<Category>,
+    pub states: Vec<State>,
+    pub rules: Vec<String>,
+    pub incomplete: bool,
+    pub required_checks: Vec<CheckKind>,
+}
+
+impl Default for FailOn {
+    fn default() -> Self {
+        Self {
+            evidence: EvidenceLevel::StaticProven,
+            categories: vec![Category::Defect],
+            states: vec![State::New, State::Worsened],
+            rules: Vec::new(),
+            incomplete: true,
+            required_checks: Vec::new(),
+        }
+    }
+}
+
+pub struct CompiledFailOn {
+    policy: FailOn,
+    rules: Vec<GlobMatcher>,
+}
+
+impl FailOn {
+    pub fn compile(&self) -> Result<CompiledFailOn, globset::Error> {
+        Ok(CompiledFailOn {
+            policy: self.clone(),
+            rules: self
+                .rules
+                .iter()
+                .map(|rule| Glob::new(rule).map(|g| g.compile_matcher()))
+                .collect::<Result<_, _>>()?,
+        })
+    }
+}
+
+impl CompiledFailOn {
+    pub fn matches(&self, finding: &Finding) -> bool {
+        self.rules
+            .iter()
+            .any(|rule| rule.is_match(&finding.rule_id))
+            || (finding.evidence_level >= self.policy.evidence
+                && self.policy.categories.contains(&finding.category)
+                && self.policy.states.contains(&finding.state))
+    }
+
+    pub fn is_incomplete(&self, report: &Report) -> bool {
+        self.policy.incomplete
+            && report.checks.iter().any(|check| match check.outcome {
+                CheckOutcome::Failed { .. } | CheckOutcome::Cancelled { .. } => true,
+                CheckOutcome::Skipped { .. } => self.policy.required_checks.contains(&check.kind),
+                _ => false,
+            })
+    }
+}
+
+pub fn derive_report_status(report: &mut Report) {
+    report.incomplete = report
+        .checks
+        .iter()
+        .filter(|c| {
+            matches!(
+                c.outcome,
+                CheckOutcome::Failed { .. }
+                    | CheckOutcome::Skipped { .. }
+                    | CheckOutcome::Cancelled { .. }
+            )
+        })
+        .cloned()
+        .collect();
+    if matches!(
+        report.status,
+        ReportStatus::Partial | ReportStatus::NoChanges | ReportStatus::Error
+    ) {
+        return;
+    }
+    report.status = if report.checks.iter().any(|c| match c.outcome {
+        CheckOutcome::Failed { .. } | CheckOutcome::Cancelled { .. } => true,
+        CheckOutcome::Skipped { reason, .. } => {
+            !matches!(reason, SkipReason::Disabled | SkipReason::NothingToAudit)
+        }
+        _ => false,
+    }) {
+        ReportStatus::Incomplete
+    } else {
+        ReportStatus::Complete
+    };
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum StartError {
+    UsageOrConfiguration,
+    RepositoryOrInternal,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+pub struct ExitContext {
+    pub error: Option<StartError>,
+    pub second_interrupt: bool,
+}
+
+/// Precedence: usage/configuration or repository/internal errors, then a second
+/// interrupt, policy-matching findings, incomplete required analysis, success.
+pub fn exit_code(report: &Report, policy: &CompiledFailOn, context: ExitContext) -> u8 {
+    if let Some(error) = context.error {
+        return match error {
+            StartError::UsageOrConfiguration => 2,
+            StartError::RepositoryOrInternal => 3,
+        };
+    }
+    if report.status == ReportStatus::Error {
+        return 3;
+    }
+    if context.second_interrupt {
+        return 130;
+    }
+    if report
+        .findings
+        .iter()
+        .chain(&report.risks)
+        .any(|f| policy.matches(f))
+    {
+        return 1;
+    }
+    if policy.is_incomplete(report) {
+        return 4;
+    }
+    0
+}
diff --git a/crates/rio-core/src/redaction.rs b/crates/rio-core/src/redaction.rs
new file mode 100644
index 0000000..3c652c6
--- /dev/null
+++ b/crates/rio-core/src/redaction.rs
@@ -0,0 +1,295 @@
+use regex::Regex;
+use serde::Deserialize;
+use std::{collections::BTreeMap, sync::LazyLock};
+
+#[derive(Deserialize)]
+struct Pattern {
+    id: String,
+    regex: String,
+}
+#[derive(Deserialize)]
+struct Entropy {
+    threshold: f64,
+    min_length: usize,
+    names: String,
+}
+#[derive(Deserialize)]
+struct Catalog {
+    entropy: Entropy,
+    patterns: Vec<Pattern>,
+}
+struct Scanner {
+    catalog: Catalog,
+    patterns: Vec<Regex>,
+    names: Regex,
+    assignment: Regex,
+}
+
+static SCANNER: LazyLock<Scanner> = LazyLock::new(|| {
+    let catalog: Catalog = toml::from_str(include_str!(
+        "../../../modules/adapters/common/secrets.toml"
+    ))
+    .expect("embedded secret catalog is valid");
+    let patterns = catalog
+        .patterns
+        .iter()
+        .map(|pattern| Regex::new(&pattern.regex).expect("embedded credential expression is valid"))
+        .collect();
+    let names = Regex::new(&catalog.entropy.names).expect("embedded entropy expression is valid");
+    let assignment = Regex::new(
+        r#"(?m)(?P<name>[A-Za-z_][A-Za-z0-9_-]*)["']?[^\S\r\n]*[:=][^\S\r\n]*(?:"(?P<double>(?:[^"\\\r\n]|\\[^\r\n])*)"|'(?P<single>(?:[^'\\\r\n]|\\[^\r\n])*)'|(?P<bare>[A-Za-z0-9/+_=.-]+))"#,
+    )
+    .unwrap();
+    Scanner {
+        catalog,
+        patterns,
+        names,
+        assignment,
+    }
+});
+
+pub struct SecretMatch<'a> {
+    pub pattern: &'a str,
+    pub start: usize,
+    pub end: usize,
+}
+
+pub fn shannon_entropy(value: &str) -> f64 {
+    let mut counts = BTreeMap::<u8, usize>::new();
+    for byte in value.bytes() {
+        *counts.entry(byte).or_default() += 1;
+    }
+    let length = value.len() as f64;
+    counts
+        .values()
+        .map(|&count| {
+            let probability = count as f64 / length;
+            -probability * probability.log2()
+        })
+        .sum()
+}
+
+/// Exact dummy values only: substrings such as `password-actual-credential`
+/// must not hide credentials. Provider-specific tokens bypass this allow-list.
+fn placeholder_value(value: &str) -> bool {
+    let lower = value.to_ascii_lowercase();
+    matches!(
+        lower.as_str(),
+        "user"
+            | "username"
+            | "password"
+            | "pass"
+            | "pwd"
+            | "secret"
+            | "test"
+            | "example"
+            | "changeme"
+            | "dummy"
+            | "placeholder"
+    ) || value.len() >= 3 && lower.bytes().all(|byte| byte == b'x')
+        || value.len() >= 3 && value.bytes().all(|byte| byte == b'*')
+        || [("<", ">"), ("${", "}"), ("{{", "}}")]
+            .iter()
+            .any(|(start, end)| {
+                value
+                    .strip_prefix(start)
+                    .and_then(|inner| inner.strip_suffix(end))
+                    .is_some_and(|inner| {
+                        !inner.is_empty() && !inner.contains(['<', '>', '{', '}', '\r', '\n'])
+                    })
+            })
+}
+
+fn placeholder_connection(value: &str) -> bool {
+    let Some((scheme, rest)) = value.split_once("://") else {
+        return false;
+    };
+    if !matches!(
+        scheme.to_ascii_lowercase().as_str(),
+        "postgres" | "postgresql" | "mysql" | "mongodb" | "mongodb+srv" | "redis"
+    ) {
+        return false;
+    }
+    let Some((credentials, address)) = rest.rsplit_once('@') else {
+        return false;
+    };
+    let Some((username, password)) = credentials.split_once(':') else {
+        return false;
+    };
+    let authority = address.split(['/', '?', '#']).next().unwrap_or_default();
+    let (host, port) = if let Some(rest) = authority.strip_prefix("[::1]") {
+        ("[::1]", rest)
+    } else {
+        authority
+            .find(':')
+            .map_or((authority, ""), |index| authority.split_at(index))
+    };
+    if !port.is_empty()
+        && !port
+            .strip_prefix(':')
+            .is_some_and(|port| !port.is_empty() && port.bytes().all(|byte| byte.is_ascii_digit()))
+    {
+        return false;
+    }
+    placeholder_value(username)
+        && placeholder_value(password)
+        && matches!(
+            host.to_ascii_lowercase().as_str(),
+            "localhost"
+                | "127.0.0.1"
+                | "[::1]"
+                | "example.com"
+                | "example.org"
+                | "example.net"
+                | "db"
+                | "postgres"
+                | "mysql"
+                | "mongodb"
+                | "redis"
+        )
+}
+
+pub fn secret_matches(content: &str) -> Vec<SecretMatch<'_>> {
+    secret_matches_for_path(content, "")
+}
+
+/// Only configuration files have unquoted string values. Source expressions
+/// must never be interpreted as credentials by the assignment entropy rule.
+pub fn secret_matches_for_path<'a>(content: &'a str, path: &str) -> Vec<SecretMatch<'a>> {
+    let name = path.rsplit('/').next().unwrap_or(path);
+    let bare_values = name == ".env"
+        || name.starts_with(".env.")
+        || matches!(
+            name.rsplit('.').next(),
+            Some("env" | "ini" | "cfg" | "conf" | "yaml" | "yml" | "properties")
+        );
+    let mut result = Vec::new();
+    for (pattern, expression) in SCANNER.catalog.patterns.iter().zip(&SCANNER.patterns) {
+        for found in expression.find_iter(content) {
+            if pattern.id == "connection-string" && placeholder_connection(found.as_str()) {
+                continue;
+            }
+            result.push(SecretMatch {
+                pattern: &pattern.id,
+                start: found.start(),
+                end: found.end(),
+            });
+        }
+    }
+    for assignment in SCANNER.assignment.captures_iter(content) {
+        if !SCANNER.names.is_match(&assignment["name"]) {
+            continue;
+        }
+        let value = assignment
+            .name("double")
+            .or_else(|| assignment.name("single"))
+            .or_else(|| assignment.name("bare"))
+            .unwrap();
+        let matched = assignment.get(0).unwrap();
+        let suffix = &content[matched.end()..];
+        let rest = suffix.lines().next().unwrap_or_default().trim_start();
+        if assignment.name("bare").is_some() {
+            let prefix = content[..matched.start()].rsplit('\n').next().unwrap();
+            if !bare_values
+                || !matches!(prefix.trim(), "" | "export" | "-")
+                || !(rest.is_empty() || rest.starts_with(['#', ';']))
+            {
+                continue;
+            }
+        } else if !(rest.is_empty()
+            || rest.starts_with([',', ')', ']', '}', ';', '#'])
+            || rest.starts_with("//"))
+        {
+            // A quoted prefix of a concatenation, call or attribute expression
+            // is not a complete literal value either.
+            continue;
+        }
+        if !placeholder_value(value.as_str())
+            && !placeholder_connection(value.as_str())
+            && value.len() >= SCANNER.catalog.entropy.min_length
+            && shannon_entropy(value.as_str()) >= SCANNER.catalog.entropy.threshold
+            && !result
+                .iter()
+                .any(|found| found.start < value.end() && found.end > value.start())
+        {
+            result.push(SecretMatch {
+                pattern: "high-entropy",
+                start: value.start(),
+                end: value.end(),
+            });
+        }
+    }
+    result.sort_by_key(|found| (found.start, found.end));
+    result
+}
+
+pub fn redact_value(value: &str) -> String {
+    format!("{}[REDACTED]", value.chars().take(4).collect::<String>())
+}
+
+/// Redact before rendering, persisting or truncating. Applying this to a full
+/// captured stream also handles multiline keys and tokens across read chunks.
+pub fn redact(content: &str) -> String {
+    let found = secret_matches(content);
+    let mut ranges = Vec::<(usize, usize)>::new();
+    for found in found {
+        if let Some(previous) = ranges.last_mut()
+            && found.start < previous.1
+        {
+            previous.1 = previous.1.max(found.end);
+        } else {
+            ranges.push((found.start, found.end));
+        }
+    }
+    let mut output = String::new();
+    let mut cursor = 0;
+    for (start, end) in ranges {
+        output.push_str(&content[cursor..start]);
+        output.push_str(&redact_value(&content[start..end]));
+        cursor = end;
+    }
+    output.push_str(&content[cursor..]);
+    output
+}
+
+/// Raw retention is capped per stream, preserving equal-sized head and tail
+/// portions of already-redacted output. The marker counts toward the cap.
+pub fn retained_raw(bytes: &[u8], limit: usize) -> Vec<u8> {
+    // A stream stopped at its output limit may end inside a credential. Scrub
+    // recognizable unfinished tokens and keys before the complete patterns.
+    static PRIVATE_BEGIN: LazyLock<Regex> = LazyLock::new(|| {
+        Regex::new(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----").unwrap()
+    });
+    static PARTIAL_TOKEN: LazyLock<Regex> = LazyLock::new(|| {
+        Regex::new(r"\b(?:(?:AKIA|ASIA)[A-Z0-9]+|gh[pousr]_[A-Za-z0-9]+|github_pat_[A-Za-z0-9_]+|glpat-[A-Za-z0-9_-]+|xox[baprs]-[A-Za-z0-9-]+|sk_live_[A-Za-z0-9]+)\z").unwrap()
+    });
+    let mut captured = String::from_utf8_lossy(bytes).into_owned();
+    if let Some(begin) = PRIVATE_BEGIN.find_iter(&captured).last()
+        && !captured[begin.end()..].contains("PRIVATE KEY-----")
+    {
+        let start = begin.start();
+        captured.replace_range(start.., &redact_value(&captured[start..]));
+    }
+    if let Some(found) = PARTIAL_TOKEN.find(&captured) {
+        let start = found.start();
+        captured.replace_range(start.., &redact_value(&captured[start..]));
+    }
+    let text = redact(&captured);
+    if text.len() <= limit {
+        return text.into_bytes();
+    }
+    let marker = b"\n[... output truncated ...]\n";
+    if limit <= marker.len() {
+        return marker[..limit].to_vec();
+    }
+    let available = limit - marker.len();
+    let mut start = available.div_ceil(2);
+    while !text.is_char_boundary(start) {
+        start -= 1;
+    }
+    let mut end = text.len() - available / 2;
+    while !text.is_char_boundary(end) {
+        end += 1;
+    }
+    [&text.as_bytes()[..start], marker, &text.as_bytes()[end..]].concat()
+}
diff --git a/crates/rio-core/src/render.rs b/crates/rio-core/src/render.rs
new file mode 100644
index 0000000..d9077d9
--- /dev/null
+++ b/crates/rio-core/src/render.rs
@@ -0,0 +1,589 @@
+use std::{cmp::Reverse, sync::LazyLock};
+
+use crate::*;
+use serde::Serialize;
+
+pub struct RenderOptions<'a> {
+    pub width: usize,
+    pub color: bool,
+    pub show_pre_existing: bool,
+    pub policy: Option<&'a CompiledFailOn>,
+}
+impl Default for RenderOptions<'_> {
+    fn default() -> Self {
+        Self {
+            width: 80,
+            color: false,
+            show_pre_existing: false,
+            policy: None,
+        }
+    }
+}
+impl RenderOptions<'_> {
+    pub fn color_enabled(&self) -> bool {
+        self.color && std::env::var_os("NO_COLOR").is_none()
+    }
+}
+pub fn label(value: &impl Serialize) -> String {
+    serde_json::to_value(value)
+        .expect("model serialization")
+        .as_str()
+        .unwrap_or("")
+        .into()
+}
+pub fn outcome_label(outcome: &CheckOutcome) -> String {
+    let value = serde_json::to_value(outcome).expect("outcome serialization");
+    match value["reason"].as_str() {
+        Some(reason) => format!("{} ({reason})", value["outcome"].as_str().unwrap()),
+        None => value["outcome"].as_str().unwrap().into(),
+    }
+}
+fn scrub(value: &mut serde_json::Value) {
+    match value {
+        serde_json::Value::String(text) => *text = redact(text),
+        serde_json::Value::Array(items) => items.iter_mut().for_each(scrub),
+        serde_json::Value::Object(items) => items.values_mut().for_each(scrub),
+        _ => {}
+    }
+}
+/// Validate in memory before returning any bytes to the caller.
+pub fn render_json(report: &Report) -> Result<Vec<u8>, String> {
+    static VALIDATOR: LazyLock<jsonschema::Validator> = LazyLock::new(|| {
+        let schema = serde_json::from_str(include_str!("../../../schemas/report-v1.json")).unwrap();
+        jsonschema::validator_for(&schema).expect("embedded report schema")
+    });
+    let mut document = serde_json::to_value(report).map_err(|error| error.to_string())?;
+    scrub(&mut document);
+    let errors: Vec<_> = VALIDATOR
+        .iter_errors(&document)
+        .map(|error| error.to_string())
+        .collect();
+    if !errors.is_empty() {
+        return Err(errors.join("\n"));
+    }
+    let mut output = serde_json::to_vec_pretty(&document).map_err(|error| error.to_string())?;
+    output.push(b'\n');
+    Ok(output)
+}
+fn safe(text: &str) -> String {
+    redact(text)
+        .chars()
+        .map(|ch| {
+            if ch.is_control() && ch != '\n' {
+                ' '
+            } else {
+                ch
+            }
+        })
+        .collect()
+}
+fn table(text: &str) -> String {
+    safe(text).replace('|', "\\|").replace('\n', "<br>")
+}
+fn code(text: &str) -> String {
+    format!("`{}`", safe(text).replace('`', "\\`"))
+}
+fn ordered(findings: &[Finding]) -> Vec<&Finding> {
+    let mut findings: Vec<_> = findings.iter().collect();
+    findings.sort_by_key(|f| {
+        (
+            f.severity,
+            Reverse(f.evidence_level),
+            &f.location.path,
+            f.location.line_start,
+        )
+    });
+    findings
+}
+fn visible(finding: &Finding) -> bool {
+    !matches!(finding.state, State::PreExisting | State::Fixed)
+}
+fn statement(report: &Report) -> String {
+    let count = report
+        .findings
+        .iter()
+        .filter(|finding| visible(finding))
+        .count();
+    let risks = report
+        .risks
+        .iter()
+        .filter(|finding| visible(finding))
+        .count();
+    let mut text = if count == 0 {
+        "No findings were produced".into()
+    } else {
+        format!("{count} finding(s)")
+    };
+    if risks > 0 {
+        text.push_str(&format!("; {risks} risk(s)"));
+    }
+    if matches!(
+        report.status,
+        ReportStatus::Incomplete | ReportStatus::Partial
+    ) {
+        let checks: Vec<_> = report
+            .incomplete
+            .iter()
+            .filter(|c| {
+                !matches!(
+                    c.outcome,
+                    CheckOutcome::Skipped {
+                        reason: SkipReason::Disabled | SkipReason::NothingToAudit,
+                        ..
+                    }
+                )
+            })
+            .map(|c| {
+                format!(
+                    "{} {}: {}",
+                    label(&c.kind),
+                    c.root,
+                    outcome_label(&c.outcome)
+                )
+            })
+            .collect();
+        text.push_str(&format!(
+            ". Review {}: {} did not complete",
+            label(&report.status),
+            checks.join(", ")
+        ));
+    }
+    text.push('.');
+    text
+}
+fn location(location: &Location) -> String {
+    let mut text = format!("{}:{}", location.path, location.line_start);
+    if !location.symbol_path.is_empty() {
+        text.push_str(&format!(" ({})", location.symbol_path));
+    }
+    text
+}
+fn footer(report: &Report) -> Vec<String> {
+    let mut lines = Vec::new();
+    for check in &report.incomplete {
+        lines.push(format!(
+            "{} {} {}: {}{}",
+            label(&check.kind),
+            check.root,
+            label(&check.version),
+            outcome_label(&check.outcome),
+            check
+                .outcome
+                .details()
+                .hint
+                .as_ref()
+                .map(|hint| format!(" — {hint}"))
+                .unwrap_or_default()
+        ));
+    }
+    for step in &report.deferred {
+        lines.push(format!("{} deferred: no_endpoint", step.step));
+    }
+    for file in &report.excluded {
+        lines.push(format!("{}: {}", file.path, file.reason));
+    }
+    lines.extend(report.footer.notes.iter().cloned());
+    for suppression in &report.footer.suppressions {
+        lines.push(format!(
+            "Suppression {}: {} finding(s)",
+            suppression.entry, suppression.count
+        ));
+    }
+    for (tool, version) in &report.footer.tool_versions {
+        lines.push(format!("{tool}: {version}"));
+    }
+    lines.push(format!("Total: {} ms", report.metrics.wall_time_ms));
+    lines
+}
+fn title(report: &Report) -> String {
+    format!(
+        "Rio {} — {}",
+        report.review.rio_version,
+        label(&report.status)
+    )
+}
+fn classification_summary(report: &Report) -> Option<String> {
+    let count = report
+        .findings
+        .iter()
+        .chain(&report.risks)
+        .filter(|finding| finding.state == State::Unclassified)
+        .count();
+    let mismatches: Vec<_> = report
+        .checks
+        .iter()
+        .chain(&report.incomplete)
+        .filter(|check| {
+            matches!(
+                check.outcome,
+                CheckOutcome::Skipped {
+                    reason: SkipReason::DependencyMismatch,
+                    ..
+                }
+            )
+        })
+        .collect();
+    let baseline_failed = report
+        .footer
+        .notes
+        .iter()
+        .any(|note| note.contains("baseline_failed"));
+    let baseline_disabled = report
+        .footer
+        .notes
+        .iter()
+        .any(|note| note.contains("baseline disabled"));
+    let (reason, action) = if !mismatches.is_empty() {
+        // Trust is appropriate only for unverifiable metadata. Never recommend
+        // bypassing a known mismatch; its remedy is a matching installation.
+        let unverified_only = mismatches.iter().all(|check| {
+            check
+                .outcome
+                .details()
+                .hint
+                .as_deref()
+                .is_some_and(|hint| hint.contains("set trust_installed_dependencies"))
+        });
+        (
+            "dependency_mismatch",
+            if unverified_only {
+                "set trust_installed_dependencies"
+            } else {
+                "install from lockfile"
+            },
+        )
+    } else if baseline_failed {
+        (
+            "baseline_failed",
+            "check base tools; install from base lockfile",
+        )
+    } else if baseline_disabled {
+        ("baseline disabled", "enable baseline in profile")
+    } else if count > 0 {
+        ("baseline unavailable", "check baseline hint in footer")
+    } else {
+        return None;
+    };
+    Some(format!("{count} unclassified: {reason}; {action}."))
+}
+
+fn header(report: &Report) -> Vec<String> {
+    let h = &report.review;
+    let mut lines = vec![format!(
+        "Review: {}  Run: {}",
+        h.id.as_deref().unwrap_or("—"),
+        h.run_id.as_deref().unwrap_or("—")
+    )];
+    if let Some(mode) = h.mode {
+        lines.push(format!(
+            "Mode: {}  Base: {}  Head: {}",
+            label(&mode),
+            h.base.as_deref().unwrap_or("—"),
+            h.head.as_deref().unwrap_or("—")
+        ));
+    }
+    if let Some(profile) = &h.profile {
+        lines.push(format!(
+            "Profile: {profile}  Chain: {}",
+            h.chain.as_deref().unwrap_or_default().join(" -> ")
+        ));
+    }
+    if let Some(summary) = classification_summary(report) {
+        lines.push(summary);
+    }
+    lines
+}
+fn groups<'a>(
+    report: &'a Report,
+    options: &RenderOptions<'_>,
+) -> Vec<(&'static str, Vec<&'a Finding>)> {
+    let mut groups = vec![
+        (
+            "Findings",
+            ordered(&report.findings)
+                .into_iter()
+                .filter(|f| visible(f))
+                .collect(),
+        ),
+        (
+            "Risks",
+            ordered(&report.risks)
+                .into_iter()
+                .filter(|f| visible(f))
+                .collect(),
+        ),
+    ];
+    if options.show_pre_existing {
+        groups.push((
+            "Pre-existing findings",
+            ordered(&report.findings)
+                .into_iter()
+                .chain(ordered(&report.risks))
+                .filter(|f| f.state == State::PreExisting)
+                .collect(),
+        ));
+    }
+    groups
+}
+pub fn render_markdown(report: &Report, options: &RenderOptions<'_>) -> String {
+    if report.status == ReportStatus::NoChanges {
+        return "No changes to review\n".into();
+    }
+    let mut out = format!(
+        "# {}\n\n{}\n",
+        safe(&title(report)),
+        header(report)
+            .iter()
+            .map(|line| format!("{}  \n", safe(line)))
+            .collect::<String>()
+    );
+    if let Some(error) = &report.error {
+        out.push_str(&format!(
+            "\n{}: {}\n",
+            safe(&error.code),
+            safe(&error.message)
+        ));
+    }
+    if !report.checks.is_empty() {
+        out.push_str("\n## Deterministic results\n");
+        for kind in [
+            CheckKind::Typecheck,
+            CheckKind::Lint,
+            CheckKind::Secrets,
+            CheckKind::Coverage,
+            CheckKind::Dependencies,
+        ] {
+            let checks: Vec<_> = report
+                .checks
+                .iter()
+                .filter(|check| check.kind == kind)
+                .collect();
+            if checks.is_empty() {
+                continue;
+            }
+            out.push_str(&format!("\n### {}\n\n| Root | Language | Version | Scheduled as | Outcome | Time (ms) |\n| --- | --- | --- | --- | --- | ---: |\n", label(&kind)));
+            for check in checks {
+                out.push_str(&format!(
+                    "| {} | {} | {} | {} | {}{} | {} |\n",
+                    table(&check.root),
+                    table(&check.language),
+                    label(&check.version),
+                    label(&check.scheduled_as),
+                    table(&outcome_label(&check.outcome)),
+                    if check.cached { " (cached)" } else { "" },
+                    check.wall_time_ms
+                ));
+            }
+        }
+    }
+    if !report.impact.symbols.is_empty() {
+        out.push_str("\n## Impact\n\n");
+        for symbol in &report.impact.symbols {
+            out.push_str(&format!(
+                "- {}: references per hop {:?}; test reference {}; unresolved {}\n",
+                code(&format!("{}:{}", symbol.path, symbol.symbol_path)),
+                symbol.references_per_hop,
+                symbol.test_referenced,
+                symbol.unresolved
+            ));
+        }
+    }
+    for (name, findings) in groups(report, options) {
+        if name != "Findings" && findings.is_empty() {
+            continue;
+        }
+        out.push_str(&format!("\n## {name}\n\n"));
+        if name == "Findings" {
+            out.push_str(&format!("{}\n\n", safe(&statement(report))));
+        }
+        for finding in findings {
+            let failing = options.policy.is_some_and(|policy| policy.matches(finding));
+            out.push_str(&format!(
+                "- **{}** [{}; {}; {}]{} — {}\n",
+                safe(&finding.rule_id),
+                label(&finding.state),
+                label(&finding.severity),
+                label(&finding.evidence_level),
+                if failing { " **FAIL**" } else { "" },
+                safe(&finding.message)
+            ));
+            for loc in finding.locations.iter().filter(|loc| {
+                options.show_pre_existing
+                    || finding.state != State::Unclassified
+                    || loc.occurrence_state != OccurrenceState::PreExisting
+            }) {
+                out.push_str(&format!(
+                    "  - {} [{}]\n",
+                    code(&location(loc)),
+                    label(&loc.occurrence_state)
+                ));
+            }
+            if !finding.trigger.is_empty() {
+                out.push_str(&format!("  - Trigger: {}\n", safe(&finding.trigger)));
+            }
+            if let Some(fix) = &finding.suggested_fix {
+                out.push_str(&format!("  - Suggested fix: {}\n", safe(fix)));
+            }
+        }
+    }
+    if report.summary != Summary::default() {
+        out.push_str(&format!(
+            "\n## Summary\n\nPre-existing: {}; fixed: {}; suppressed: {}.\n",
+            report.summary.pre_existing, report.summary.fixed, report.summary.suppressed
+        ));
+    }
+    out.push_str("\n## Footer\n\n");
+    for line in footer(report) {
+        out.push_str(&format!("- {}\n", safe(&line)));
+    }
+    out
+}
+fn fit(line: &str, width: usize) -> String {
+    if line.chars().count() <= width {
+        line.into()
+    } else {
+        format!(
+            "{}…",
+            line.chars()
+                .take(width.saturating_sub(1))
+                .collect::<String>()
+        )
+    }
+}
+pub fn render_terminal(report: &Report, options: &RenderOptions<'_>) -> String {
+    if report.status == ReportStatus::NoChanges {
+        return "No changes to review\n".into();
+    }
+    let mut lines = vec![title(report)];
+    lines.extend(header(report));
+    if let Some(error) = &report.error {
+        lines.push(format!("{}: {}", error.code, error.message));
+        lines.extend(error.details.iter().cloned());
+    }
+    if !report.checks.is_empty() {
+        lines.push("\nDeterministic results".into());
+        for kind in [
+            CheckKind::Typecheck,
+            CheckKind::Lint,
+            CheckKind::Secrets,
+            CheckKind::Coverage,
+            CheckKind::Dependencies,
+        ] {
+            for check in report.checks.iter().filter(|check| check.kind == kind) {
+                lines.push(format!(
+                    "  {} {} ({}, {}, {}): {}{} — {} ms",
+                    label(&check.kind),
+                    check.root,
+                    check.language,
+                    label(&check.version),
+                    label(&check.scheduled_as),
+                    outcome_label(&check.outcome),
+                    if check.cached { " cached" } else { "" },
+                    check.wall_time_ms
+                ));
+            }
+        }
+    }
+    if !report.impact.symbols.is_empty() {
+        lines.push("\nImpact".into());
+        for symbol in &report.impact.symbols {
+            lines.push(format!(
+                "  {} {}: {:?} references; test {}",
+                symbol.path, symbol.symbol_path, symbol.references_per_hop, symbol.test_referenced
+            ));
+        }
+    }
+    for (name, findings) in groups(report, options) {
+        if name != "Findings" && findings.is_empty() {
+            continue;
+        }
+        lines.push(format!("\n{name}"));
+        if name == "Findings" {
+            lines.push(statement(report));
+        }
+        for finding in findings {
+            lines.push(format!(
+                "  {} [{}; {}; {}]{}",
+                finding.rule_id,
+                label(&finding.state),
+                label(&finding.severity),
+                label(&finding.evidence_level),
+                if options.policy.is_some_and(|p| p.matches(finding)) {
+                    " FAIL"
+                } else {
+                    ""
+                }
+            ));
+            // Locations get their own lines so messages never wrap paths.
+            for loc in finding.locations.iter().filter(|loc| {
+                options.show_pre_existing
+                    || finding.state != State::Unclassified
+                    || loc.occurrence_state != OccurrenceState::PreExisting
+            }) {
+                lines.push(format!(
+                    "    {} [{}]",
+                    location(loc),
+                    label(&loc.occurrence_state)
+                ));
+            }
+            lines.push(format!("    {}", finding.message));
+            if !finding.trigger.is_empty() {
+                lines.push(format!("    Trigger: {}", finding.trigger));
+            }
+            if let Some(fix) = &finding.suggested_fix {
+                lines.push(format!("    Suggested fix: {fix}"));
+            }
+        }
+    }
+    if report.summary != Summary::default() {
+        lines.push(format!(
+            "\nSummary: {} pre-existing; {} fixed; {} suppressed",
+            report.summary.pre_existing, report.summary.fixed, report.summary.suppressed
+        ));
+    }
+    lines.push("\nFooter".into());
+    lines.extend(footer(report));
+    let text = lines
+        .into_iter()
+        .flat_map(|line| {
+            safe(&line)
+                .split('\n')
+                .flat_map(|part| {
+                    if part.starts_with("    ") {
+                        vec![fit(part, options.width.max(1))]
+                    } else {
+                        textwrap::wrap(part, options.width.max(1))
+                            .into_iter()
+                            .map(|line| line.into_owned())
+                            .collect()
+                    }
+                })
+                .collect::<Vec<_>>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+        + "\n";
+    if options.color_enabled() {
+        format!(
+            "\x1b[1m{}\x1b[0m{}",
+            text.lines().next().unwrap_or(""),
+            &text[text.find('\n').unwrap_or(text.len())..]
+        )
+    } else {
+        text
+    }
+}
+/// Live event text is also used on stderr by machine-readable formats.
+pub fn render_progress(event: &ReviewEvent) -> Option<String> {
+    Some(safe(&match event {
+        ReviewEvent::StepStarted { step } => format!("Running {step}…"),
+        ReviewEvent::StepFinished { step } => format!("Finished {step}"),
+        ReviewEvent::CheckFinished {
+            kind,
+            root,
+            outcome,
+            ..
+        } => format!("{} {}: {}", label(kind), root, outcome_label(outcome)),
+        _ => return None,
+    }))
+}
