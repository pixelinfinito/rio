+// Remove only parsed type nodes. Preserve the remaining source text, including
+// newlines: an unchanged token sequence can still change automatic semicolons.
+struct TypeErasure<'a> {
+    source: &'a [u8],
+    line_starts: Vec<usize>,
+    ranges: Vec<std::ops::Range<usize>>,
+}
+
+impl TypeErasure<'_> {
+    fn byte_range(&self, lines: LineRange) -> std::ops::Range<usize> {
+        if lines.count == 0 {
+            return 0..0;
+        }
+        let start = lines.start.saturating_sub(1) as usize;
+        self.line_starts
+            .get(start)
+            .copied()
+            .unwrap_or(self.source.len())
+            ..self
+                .line_starts
+                .get(start + lines.count as usize)
+                .copied()
+                .unwrap_or(self.source.len())
+    }
+
+    fn contains_type(&self, range: &std::ops::Range<usize>) -> bool {
+        self.ranges
+            .iter()
+            .any(|erased| erased.start < range.end && range.start < erased.end)
+    }
+
+    fn runtime_text(&self, range: std::ops::Range<usize>) -> String {
+        let mut output = Vec::new();
+        let mut cursor = range.start;
+        for erased in &self.ranges {
+            if erased.end <= range.start || erased.start >= range.end {
+                continue;
+            }
+            let start = erased.start.max(range.start);
+            output.extend_from_slice(&self.source[cursor..start]);
+            cursor = erased.end.min(range.end);
+        }
+        output.extend_from_slice(&self.source[cursor..range.end]);
+        String::from_utf8(output)
+            .expect("type and line boundaries preserve UTF-8")
+            .trim()
+            .to_owned()
+    }
+}
+
+fn typescript_type_erasure<'a>(path: &str, source: &'a [u8]) -> Result<Option<TypeErasure<'a>>> {
+    let parsed = crate::parse_source(path, source)?;
+    if parsed.root_node().has_error() {
+        return Ok(None);
+    }
+    fn collect(node: tree_sitter::Node<'_>, ranges: &mut Vec<std::ops::Range<usize>>) {
+        let mut cursor = node.walk();
+        let erased = matches!(
+            node.kind(),
+            "type_annotation"
+                | "type_arguments"
+                | "type_parameters"
+                | "interface_declaration"
+                | "type_alias_declaration"
+                | "ambient_declaration"
+        ) || matches!(node.kind(), "import_statement" | "export_statement")
+            && node.children(&mut cursor).any(|child| {
+                child.kind() == "type"
+                    || matches!(
+                        child.kind(),
+                        "interface_declaration" | "type_alias_declaration"
+                    )
+            });
+        if erased {
+            ranges.push(node.byte_range());
+        } else {
+            for child in node.children(&mut cursor) {
+                collect(child, ranges);
+            }
+        }
+    }
+    let mut ranges = Vec::new();
+    collect(parsed.root_node(), &mut ranges);
+    Ok(Some(TypeErasure {
+        source,
+        line_starts: std::iter::once(0)
+            .chain(
+                source
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, byte)| **byte == b'\n')
+                    .map(|(index, _)| index + 1),
+            )
+            .collect(),
+        ranges,
+    }))
+}
+
+fn type_only_changes(base: &Tree, tree: &Tree, file: &FileDiff) -> Result<BTreeSet<u32>> {
+    let mut ignored = BTreeSet::new();
+    if !matches!(
+        file.path.rsplit('.').next(),
+        Some("ts" | "tsx" | "mts" | "cts")
+    ) {
+        return Ok(ignored);
+    }
+    let old_path = file.old_path.as_deref().unwrap_or(&file.path);
+    let before = base
+        .get(old_path)
+        .map_or(&[][..], |entry| entry.content.as_slice());
+    let after = &tree[&file.path].content;
+    let (Some(before), Some(after)) = (
+        typescript_type_erasure(&file.path, before)?,
+        typescript_type_erasure(&file.path, after)?,
+    ) else {
+        return Ok(ignored);
+    };
+    for hunk in &file.hunks {
+        let old = before.byte_range(hunk.base);
+        let new = after.byte_range(hunk.head);
+        let has_types = before.contains_type(&old) || after.contains_type(&new);
+        if has_types && before.runtime_text(old) == after.runtime_text(new) {
+            ignored.extend(hunk.head.start..hunk.head.start + hunk.head.count);
+        }
+    }
+    Ok(ignored)
+}
+
+/// Merge every root's data before calling this function. Otherwise a shared
+/// package covered by its consumer can be incorrectly reported as untested.
+pub fn diff_coverage(
+    base: &Tree,
+    tree: &Tree,
+    diff: &Diff,
+    data: &CoverageData,
+    settings: &[CoverageSettings],
+) -> Result<CoverageFindings> {
+    let mut result = CoverageFindings::default();
+    for file in &diff.files {
+        if file.binary
+            || file.excluded.is_some()
+            || is_test_path(&file.path)
+            || crate::language_for_path(&file.path).is_none()
+        {
+            continue;
+        }
+        let Some(source) = tree.get(&file.path) else {
+            continue;
+        };
+        let syntax = analyze_source(&file.path, &source.content)?;
+        let added: BTreeSet<_> = file
+            .hunks
+            .iter()
+            .flat_map(|hunk| hunk.head.start..hunk.head.start + hunk.head.count)
+            .collect();
+        let type_only = type_only_changes(base, tree, file)?;
+        let instrumented = if let Some(coverage) = data.get(&file.path) {
+            coverage
+                .instrumented
+                .difference(&coverage.executed)
+                .filter(|line| !coverage.excluded.contains(line))
+                .copied()
+                .collect::<BTreeSet<_>>()
+        } else {
+            if syntax.executable_lines.is_disjoint(&added) {
+                continue;
+            }
+            let relevant: Vec<_> = settings
+                .iter()
+                .filter(|settings| {
+                    crate::language_for_path(&file.path) == Some(settings.language.as_str())
+                        && (settings.root == "."
+                            || file.path.starts_with(&format!("{}/", settings.root)))
+                })
+                .collect();
+            if !relevant.is_empty()
+                && relevant
+                    .iter()
+                    .all(|settings| settings.excludes(&file.path).unwrap_or(false))
+            {
+                result.excluded.push(ExcludedFile {
+                    path: file.path.clone(),
+                    reason: "coverage_excluded".into(),
+                });
+                continue;
+            }
+            // A source heuristic cannot prove that a line was instrumented.
+            // Only report entries establish executable lines for diff coverage.
+            result.excluded.push(ExcludedFile {
+                path: file.path.clone(),
+                reason: "coverage_not_instrumented".into(),
+            });
+            continue;
+        };
+        let mut groups = BTreeMap::<String, BTreeSet<u32>>::new();
+        for line in instrumented.intersection(&added) {
+            if type_only.contains(line) {
+                continue;
+            }
+            let symbol = syntax
+                .symbols
+                .iter()
+                .filter(|symbol| {
+                    matches!(
+                        symbol.kind,
+                        crate::SymbolKind::Function | crate::SymbolKind::Method
+                    ) && symbol.line_start <= *line
+                        && *line <= symbol.line_end
+                })
+                .min_by_key(|symbol| symbol.byte_end - symbol.byte_start)
+                .map(|symbol| symbol.symbol_path.clone())
+                .unwrap_or_default();
+            groups.entry(symbol).or_default().insert(*line);
+        }
+        for (symbol, lines) in groups {
+            let mut ranges: Vec<(u32, u32)> = Vec::new();
+            for line in lines {
+                if let Some((_, end)) = ranges.last_mut()
+                    && *end + 1 == line
+                {
+                    *end = line;
+                } else {
+                    ranges.push((line, line));
+                }
+            }
+            let locations: Vec<_> = ranges
+                .iter()
+                .map(|(start, end)| Location {
+                    path: file.path.clone(),
+                    line_start: *start,
+                    line_end: *end,
+                    column: None,
+                    symbol_path: symbol.clone(),
+                    occurrence_state: OccurrenceState::New,
+                })
+                .collect();
+            let range_text = ranges
+                .iter()
+                .map(|(start, end)| {
+                    if start == end {
+                        start.to_string()
+                    } else {
+                        format!("{start}-{end}")
+                    }
+                })
+                .collect::<Vec<_>>()
+                .join(", ");
+            let message =
+                format!("Changed executable lines are not covered by tests: {range_text}");
+            result.findings.push(Finding {
+                id: finding_id(
+                    "coverage/untested_change",
+                    &file.path,
+                    &symbol,
+                    "changed executable lines not covered",
+                    "",
+                ),
+                rule_id: "coverage/untested_change".into(),
+                category: Category::Risk,
+                evidence_level: EvidenceLevel::StaticProven,
+                severity: Severity::Warning,
+                state: State::New,
+                location: locations[0].clone(),
+                locations,
+                message,
+                trigger: "execution reaches the changed lines".into(),
+                impact: None,
+                suggested_fix: Some("Add a test that executes the changed behavior".into()),
+                evidence: vec!["merged coverage".into()],
+                source: Source::Tool {
+                    tool: "coverage".into(),
+                    version: "merged".into(),
+                },
+                advisory: None,
+            });
+        }
+    }
+    Ok(result)
+}
+
+pub struct CoverageRun {
+    pub data: CoverageData,
+    pub outcome: CheckOutcome,
+    pub processes: Vec<ProcessResult>,
+}
+
+pub struct CoverageRequest<'a> {
+    pub tool: &'a ResolvedTool,
+    pub settings: &'a CoverageSettings,
+    pub tool_tree: &'a Path,
+    pub worktree_root: Option<&'a Path>,
+    pub timeout: Duration,
+    pub output_limit: usize,
+}
+
+pub async fn run_coverage(
+    request: CoverageRequest<'_>,
+    supervisor: &ProcessSupervisor,
+    cancellation: CancellationToken,
+) -> CoverageRun {
+    let started = Instant::now();
+    let tool = request.tool;
+    let execution_root = request
+        .settings
+        .invocation_root
+        .as_deref()
+        .unwrap_or(&request.settings.root);
+    let root = request.tool_tree.join(execution_root);
+    let output = root.join(".rio-coverage");
+    let mut provider = None;
+    if tool.name == "vitest" {
+        let unavailable = if request.settings.vitest_browser_mode {
+            Some((
+                rio_core::SkipReason::NotSupportedByAdapter,
+                "coverage_unavailable: browser mode requires a browser environment",
+            ))
+        } else {
+            let providers = vitest_coverage_providers(&root, &tool.version);
+            match providers.as_slice() {
+                [] => Some((
+                    rio_core::SkipReason::ToolMissing,
+                    "coverage_unavailable: no installed Vitest coverage provider is resolvable from the execution root",
+                )),
+                [installed] => {
+                    provider = Some(*installed);
+                    None
+                }
+                _ => None, // Preserve the project's choice when both are available.
+            }
+        };
+        if let Some((reason, hint)) = unavailable {
+            return CoverageRun {
+                data: CoverageData::new(),
+                outcome: CheckOutcome::Skipped {
+                    reason,
+                    details: CheckDetails {
+                        hint: Some(hint.into()),
+                        ..Default::default()
+                    },
+                },
+                processes: Vec::new(),
+            };
+        }
+    }
+    let failure = |message: String, processes| CoverageRun {
+        data: CoverageData::new(),
+        outcome: CheckOutcome::Failed {
+            reason: FailureReason::UnparseableOutput,
+            details: CheckDetails {
+                hint: Some(crate::redact(&message)),
+                ..Default::default()
+            },
+        },
+        processes,
+    };
+    if let Err(error) = std::fs::create_dir_all(&output) {
+        return CoverageRun {
+            data: CoverageData::new(),
+            outcome: CheckOutcome::Failed {
+                reason: if error.raw_os_error() == Some(28) {
+                    FailureReason::DiskFull
+                } else {
+                    FailureReason::SpawnFailed
+                },
+                details: CheckDetails {
+                    hint: Some(error.to_string()),
+                    ..Default::default()
+                },
+            },
+            processes: Vec::new(),
+        };
+    }
+    let mut command = ToolCommand::new(tool.path.clone(), root.clone());
+    let (module, report_path) = match tool.name.as_str() {
+        "vitest" => {
+            command = vitest_coverage_command(tool, &root, &output);
+            command
+                .args
+                .extend(request.settings.runner_args.iter().map(Into::into));
+            if let Some(provider) = provider {
+                command
+                    .args
+                    .push(format!("--coverage.provider={provider}").into());
+            }
+            ("rio/adapter-typescript", output.join("lcov.info"))
+        }
+        "jest" => {
+            command.args = vec![
+                "--coverage".into(),
+                "--coverageReporters=lcov".into(),
+                format!("--coverageDirectory={}", output.display()).into(),
+                "--maxWorkers=2".into(),
+            ];
+            ("rio/adapter-typescript", output.join("lcov.info"))
+        }
+        "coverage" => {
+            command.args.push("run".into());
+            if request.settings.add_python_source {
+                command
+                    .args
+                    .push(format!("--source={}", root.display()).into());
+            }
+            command
+                .args
+                .extend(["-m".into(), "pytest".into(), "-q".into()]);
+            command.env.insert(
+                "COVERAGE_FILE".into(),
+                output.join(".coverage").into_os_string(),
+            );
+            ("rio/adapter-python", output.join("coverage.json"))
+        }
+        _ => {
+            return failure(
+                format!("unsupported coverage tool {}", tool.name),
+                Vec::new(),
+            );
+        }
+    };
+    command.timeout = request.timeout;
+    command.output_limit = request.output_limit;
+    command.env.insert("CI".into(), "1".into());
+    let result = supervisor.run(command, cancellation.clone()).await;
+    if tool.name != "coverage"
+        && result.cleanup_confirmed
+        && matches!(
+            result.termination,
+            Termination::Exited { code: Some(0 | 1) }
+        )
+        && [
+            String::from_utf8_lossy(&result.stdout),
+            String::from_utf8_lossy(&result.stderr),
+        ]
+        .iter()
+        .any(|text| text.contains("No test files found") || text.contains("No tests found"))
+    {
+        return CoverageRun {
+            data: CoverageData::new(),
+            outcome: CheckOutcome::Skipped {
+                reason: rio_core::SkipReason::NoTests,
+                details: CheckDetails {
+                    hint: Some("The project's test runner found no tests".into()),
+                    ..Default::default()
+                },
+            },
+            processes: vec![result],
+        };
+    }
+    let spec = tool_contract(module, "coverage", &tool.name).expect("built-in coverage contract");
+    let mut outcome = evaluate_exit(&result, &spec.exit_codes, Ok(Vec::new()));
+    let may_export = result.cleanup_confirmed
+        && matches!(
+            result.termination,
+            Termination::Exited { code: Some(0 | 1) }
+        );
+    let mut processes = vec![result];
+    if tool.name == "coverage" && may_export {
+        if request.settings.python_parallel {
+            let mut command = ToolCommand::new(tool.path.clone(), root.clone());
+            command.args = vec!["combine".into(), "--keep".into()];
+            command.env.insert(
+                "COVERAGE_FILE".into(),
+                output.join(".coverage").into_os_string(),
+            );
+            command.timeout = request.timeout.saturating_sub(started.elapsed());
+            command.output_limit = request.output_limit;
+            let result = supervisor.run(command, cancellation.clone()).await;
+            let succeeded = matches!(result.termination, Termination::Exited { code: Some(0) });
+            let combine_outcome = evaluate_exit(
+                &result,
+                &crate::ExitCodeContract {
+                    clean: vec![0],
+                    ..Default::default()
+                },
+                Ok(Vec::new()),
+            );
+            processes.push(result);
+            if !succeeded {
+                return CoverageRun {
+                    data: CoverageData::new(),
+                    outcome: combine_outcome,
+                    processes,
+                };
+            }
+        }
+        let mut command = ToolCommand::new(tool.path.clone(), root);
+        command.args = vec![
+            "json".into(),
+            "-o".into(),
+            report_path.clone().into_os_string(),
+        ];
+        command.env.insert(
+            "COVERAGE_FILE".into(),
+            output.join(".coverage").into_os_string(),
+        );
+        command.timeout = request.timeout.saturating_sub(started.elapsed());
+        command.output_limit = request.output_limit;
+        let result = supervisor.run(command, cancellation).await;
+        if !matches!(result.termination, Termination::Exited { code: Some(0) }) {
+            let export_contract = crate::ExitCodeContract {
+                clean: vec![0],
+                ..Default::default()
+            };
+            outcome = evaluate_exit(&result, &export_contract, Ok(Vec::new()));
+        }
+        processes.push(result);
+    }
+    let context = DiagnosticContext {
+        repository_root: request.tool_tree,
+        project_root: execution_root,
+        tool_version: &tool.version,
+        worktree_root: request.worktree_root,
+        sources: None,
+    };
+    let data = std::fs::read(report_path)
+        .map_err(anyhow::Error::from)
+        .and_then(|bytes| {
+            if tool.name == "coverage" {
+                parse_python_coverage(&bytes, &context)
+            } else {
+                parse_lcov(&bytes, &context)
+            }
+        });
+    let data = match data {
+        Ok(data) => data,
+        Err(error) if matches!(outcome, CheckOutcome::Passed { .. }) => {
+            return failure(error.to_string(), processes);
+        }
+        Err(_) => CoverageData::new(),
+    };
+    let has_coverage = data.values().any(|file| !file.instrumented.is_empty());
+    let runner_exit = processes
+        .first()
+        .and_then(|process| match process.termination {
+            Termination::Exited { code: Some(code) } if code != 0 => Some(code),
+            _ => None,
+        });
+    if !has_coverage && let Some(code) = runner_exit {
+        let stderr = String::from_utf8_lossy(&processes[0].stderr);
+        let first_line = stderr.lines().map(str::trim).find(|line| !line.is_empty());
+        outcome.details_mut().hint = Some(crate::redact(&format!(
+            "Test runner exited with code {code} without producing usable coverage{}",
+            first_line.map_or_else(String::new, |line| format!(": {line}"))
+        )));
+    } else if has_coverage
+        && matches!(
+            outcome,
+            CheckOutcome::Failed {
+                reason: FailureReason::TestsFailed,
+                ..
+            }
+        )
+    {
+        let count = processes.first().and_then(|process| {
+            let text = String::from_utf8_lossy(&process.stdout);
+            regex::Regex::new(r"(\d+) failed")
+                .unwrap()
+                .captures(&text)
+                .and_then(|captures| captures[1].parse::<usize>().ok())
+        });
+        outcome.details_mut().hint = Some(format!(
+            "{}; usable coverage from the incomplete run is retained",
+            count.map_or_else(
+                || "Tests failed (see raw output for details)".into(),
+                |count| format!("{count} tests failed")
+            )
+        ));
+    }
+    CoverageRun {
+        data,
+        outcome,
+        processes,
+    }
+}
+
+pub fn vitest_supports_all(version: &str) -> bool {
+    version
+        .trim_start_matches("vitest/")
+        .split('.')
+        .next()
+        .and_then(|part| part.parse::<u64>().ok())
+        .is_some_and(|major| major < 4)
+}
+
+/// Follow Node's ancestor node_modules lookup, including workspace symlinks.
+/// Do not infer availability from declarations or unrelated pnpm store entries.
+fn vitest_coverage_providers(root: &std::path::Path, version: &str) -> Vec<&'static str> {
+    let mut parts = version.trim_start_matches("vitest/").split('.');
+    let legacy = parts.next() == Some("0")
+        && parts
+            .next()
+            .and_then(|minor| minor.parse::<u64>().ok())
+            .is_some_and(|minor| minor < 32);
+    let default = if legacy { "c8" } else { "v8" };
+    [default, "istanbul"]
+        .into_iter()
+        .filter(|provider| {
+            let name = format!("@vitest/coverage-{provider}");
+            root.ancestors().any(|directory| {
+                let manifest = directory
+                    .join("node_modules")
+                    .join(&name)
+                    .join("package.json");
+                std::fs::read(manifest)
+                    .ok()
+                    .and_then(|bytes| serde_json::from_slice::<serde_json::Value>(&bytes).ok())
+                    .is_some_and(|value| value["name"].as_str() == Some(&name))
+            })
+        })
+        .collect()
+}
+
+/// Version-specific argv is kept together so unsupported flags never reach CAC.
+pub fn vitest_coverage_command(
+    tool: &crate::ResolvedTool,
+    root: &std::path::Path,
+    output: &std::path::Path,
+) -> ToolCommand {
+    let mut command = ToolCommand::new(tool.path.clone(), root.into());
+    command.args = vec![
+        "run".into(),
+        "--coverage.enabled".into(),
+        "--coverage.reporter=lcov".into(),
+        format!("--coverage.reportsDirectory={}", output.display()).into(),
+    ];
+    if vitest_supports_all(&tool.version) {
+        command.args.push("--coverage.all".into());
+    }
+    let major = tool
+        .version
+        .trim_start_matches("vitest/")
+        .split('.')
+        .next()
+        .and_then(|part| part.parse::<u64>().ok());
+    if major == Some(1) {
+        for (name, value) in [
+            ("VITEST_MAX_THREADS", "2"),
+            ("VITEST_MIN_THREADS", "1"),
+            ("VITEST_MAX_FORKS", "2"),
+            ("VITEST_MIN_FORKS", "1"),
+        ] {
+            command.env.insert(name.into(), value.into());
+        }
+    } else {
+        command.args.push("--maxWorkers=2".into());
+        if matches!(major, Some(2 | 3)) {
+            command.args.push("--minWorkers=1".into());
+        }
+    }
+    command
+}
diff --git a/crates/rio-adapters/src/coverage_config.rs b/crates/rio-adapters/src/coverage_config.rs
new file mode 100644
index 0000000..3436a4a
--- /dev/null
+++ b/crates/rio-adapters/src/coverage_config.rs
@@ -0,0 +1,470 @@
+use crate::{CoverageSettings, ancestor_config, parse_source, vitest_supports_all};
+use anyhow::{Context, Result};
+use rio_git::Tree;
+use serde_json::Value;
+use tree_sitter::Node;
+
+fn source_text<'a>(node: Node<'_>, source: &'a [u8]) -> &'a str {
+    std::str::from_utf8(&source[node.byte_range()]).unwrap_or_default()
+}
+
+fn property<'a>(object: Node<'a>, key: &str, source: &[u8]) -> Option<Node<'a>> {
+    let mut cursor = object.walk();
+    object.named_children(&mut cursor).find_map(|pair| {
+        let name = pair.child_by_field_name("key")?;
+        let name = source_text(name, source).trim_matches(['\'', '"']);
+        if name == key {
+            pair.child_by_field_name("value")
+        } else {
+            None
+        }
+    })
+}
+
+fn has_spread(node: Node<'_>) -> bool {
+    let mut cursor = node.walk();
+    node.named_children(&mut cursor)
+        .any(|child| child.kind() == "spread_element")
+}
+
+fn array(node: Node<'_>, source: &[u8]) -> Option<Vec<String>> {
+    if node.kind() != "array" {
+        return None;
+    }
+    let mut cursor = node.walk();
+    node.named_children(&mut cursor)
+        .filter(|child| child.kind() != "comment")
+        .map(|child| {
+            if child.kind() == "string" {
+                json5::from_str(source_text(child, source)).ok()
+            } else {
+                None
+            }
+        })
+        .collect()
+}
+
+/// Read the exported config object and static string arrays without executing
+/// project JavaScript. Calls other than defineConfig, spreads and computed
+/// values leave absent files unattributed.
+fn exported_object<'a>(node: Node<'a>, source: &[u8]) -> Option<Node<'a>> {
+    if node.kind() == "export_statement" {
+        let value = node
+            .child_by_field_name("value")
+            .or_else(|| node.child_by_field_name("declaration"))?;
+        return config_value(value, source);
+    }
+    if node.kind() == "assignment_expression"
+        && node
+            .child_by_field_name("left")
+            .is_some_and(|left| source_text(left, source) == "module.exports")
+    {
+        return node
+            .child_by_field_name("right")
+            .and_then(|value| config_value(value, source));
+    }
+    let mut cursor = node.walk();
+    node.named_children(&mut cursor)
+        .find_map(|child| exported_object(child, source))
+}
+
+fn config_value<'a>(value: Node<'a>, source: &[u8]) -> Option<Node<'a>> {
+    if value.kind() == "object" {
+        return Some(value);
+    }
+    if value.kind() == "call_expression"
+        && value
+            .child_by_field_name("function")
+            .is_some_and(|function| source_text(function, source) == "defineConfig")
+    {
+        let arguments = value.child_by_field_name("arguments")?;
+        let mut cursor = arguments.walk();
+        return arguments
+            .named_children(&mut cursor)
+            .next()
+            .and_then(|node| (node.kind() == "object").then_some(node));
+    }
+    None
+}
+
+pub fn typescript_test_runner(tree: &Tree, root: &str) -> Option<&'static str> {
+    let mut directory = root.to_owned();
+    loop {
+        if let Some(path) = ancestor_config(tree, &directory, &["package.json"])
+            && let Some(value) = tree
+                .get(&path)
+                .and_then(|entry| serde_json::from_slice::<Value>(&entry.content).ok())
+        {
+            for runner in ["vitest", "jest"] {
+                if ["dependencies", "devDependencies"]
+                    .iter()
+                    .any(|key| value[*key].get(runner).is_some())
+                    || value["scripts"].as_object().is_some_and(|scripts| {
+                        scripts.values().any(|script| {
+                            script.as_str().is_some_and(|script| {
+                                script.split_whitespace().any(|word| word == runner)
+                            })
+                        })
+                    })
+                {
+                    return Some(runner);
+                }
+            }
+            let parent = path.rsplit_once('/').map_or("", |(dir, _)| dir);
+            if parent.is_empty() {
+                break;
+            }
+            directory = parent
+                .rsplit_once('/')
+                .map_or(".", |(dir, _)| dir)
+                .to_owned();
+        } else {
+            break;
+        }
+    }
+    if ancestor_config(tree, root, VITEST_CONFIGS).is_some() {
+        Some("vitest")
+    } else if ancestor_config(
+        tree,
+        root,
+        &[
+            "jest.config.ts",
+            "jest.config.js",
+            "jest.config.mjs",
+            "jest.config.cjs",
+            "jest.config.json",
+        ],
+    )
+    .is_some()
+    {
+        Some("jest")
+    } else {
+        None
+    }
+}
+
+pub fn typescript_coverage_settings(
+    tree: &Tree,
+    root: &str,
+    runner: &str,
+    version: &str,
+) -> Result<CoverageSettings> {
+    let mut settings = CoverageSettings {
+        root: root.into(),
+        language: "typescript".into(),
+        static_known: true,
+        ..Default::default()
+    };
+    let names = if runner == "vitest" {
+        VITEST_CONFIGS.to_vec()
+    } else {
+        vec![
+            "jest.config.ts",
+            "jest.config.js",
+            "jest.config.mjs",
+            "jest.config.cjs",
+            "jest.config.json",
+        ]
+    };
+    if let Some(config) = ancestor_config(tree, root, &names) {
+        let entry = &tree[&config];
+        if config.ends_with(".json") {
+            let value: Value = serde_json::from_slice(&entry.content)?;
+            settings.include = value
+                .get("collectCoverageFrom")
+                .and_then(|value| serde_json::from_value(value.clone()).ok());
+            settings.static_known =
+                value.get("collectCoverageFrom").is_none() || settings.include.is_some();
+        } else {
+            let syntax = parse_source(&config, &entry.content)?;
+            let object = exported_object(syntax.root_node(), &entry.content);
+            if let Some(object) =
+                object.filter(|object| !has_spread(*object) && !syntax.root_node().has_error())
+            {
+                if runner == "vitest"
+                    && let Some(test) = property(object, "test", &entry.content)
+                    && test.kind() == "object"
+                    && !has_spread(test)
+                    && let Some(browser) = property(test, "browser", &entry.content)
+                {
+                    settings.vitest_browser_mode = browser.kind() == "true"
+                        || (browser.kind() == "object"
+                            && !has_spread(browser)
+                            && property(browser, "enabled", &entry.content)
+                                .is_some_and(|enabled| enabled.kind() == "true"));
+                    if settings.vitest_browser_mode {
+                        settings
+                            .notes
+                            .push("coverage_unavailable: browser mode".into());
+                    }
+                }
+                let coverage = if runner == "vitest" {
+                    property(object, "test", &entry.content)
+                        .and_then(|test| property(test, "coverage", &entry.content))
+                } else {
+                    Some(object)
+                };
+                if let Some(coverage) = coverage {
+                    if coverage.kind() != "object" || has_spread(coverage) {
+                        settings.static_known = false;
+                    } else {
+                        for (key, target) in [
+                            (
+                                if runner == "jest" {
+                                    "collectCoverageFrom"
+                                } else {
+                                    "include"
+                                },
+                                true,
+                            ),
+                            (
+                                if runner == "jest" {
+                                    "coveragePathIgnorePatterns"
+                                } else {
+                                    "exclude"
+                                },
+                                false,
+                            ),
+                        ] {
+                            if let Some(value) = property(coverage, key, &entry.content) {
+                                if let Some(patterns) = array(value, &entry.content) {
+                                    if target {
+                                        settings.include = Some(patterns);
+                                    } else if runner == "vitest" {
+                                        settings.exclude = patterns;
+                                    } else {
+                                        settings.static_known = false;
+                                    } // Jest ignore patterns are regexes, not globs.
+                                } else {
+                                    settings.static_known = false;
+                                }
+                            }
+                        }
+                    }
+                } else if runner == "vitest"
+                    && property(object, "test", &entry.content)
+                        .is_some_and(|test| test.kind() != "object" || has_spread(test))
+                {
+                    settings.static_known = false;
+                }
+            } else {
+                settings.static_known = false;
+            }
+        }
+        settings
+            .notes
+            .push(format!("coverage configuration: {config}"));
+    } else if runner == "jest"
+        && let Some(path) = ancestor_config(tree, root, &["package.json"])
+    {
+        let value: Value = serde_json::from_slice(&tree[&path].content)?;
+        settings.include = value["jest"]
+            .get("collectCoverageFrom")
+            .and_then(|value| serde_json::from_value(value.clone()).ok());
+    }
+    if runner == "vitest" {
+        let (cwd, args) = vitest_execution(tree, root);
+        settings.invocation_root = Some(cwd);
+        settings.runner_args = args;
+    }
+    settings.reports_unloaded = settings.static_known
+        && if runner == "vitest" {
+            vitest_supports_all(version) || settings.include.is_some()
+        } else {
+            settings.include.is_some()
+        };
+    Ok(settings)
+}
+
+fn list(value: &Value) -> Option<Vec<String>> {
+    value
+        .as_str()
+        .map(|value| {
+            value
+                .split([',', '\n'])
+                .map(str::trim)
+                .filter(|value| !value.is_empty())
+                .map(str::to_owned)
+                .collect()
+        })
+        .or_else(|| {
+            value.as_array().and_then(|values| {
+                values
+                    .iter()
+                    .map(|value| value.as_str().map(str::to_owned))
+                    .collect()
+            })
+        })
+}
+
+pub fn python_coverage_settings(tree: &Tree, root: &str) -> Result<CoverageSettings> {
+    let mut settings = CoverageSettings {
+        root: root.into(),
+        language: "python".into(),
+        static_known: true,
+        reports_unloaded: true,
+        ..Default::default()
+    };
+    let mut values = Value::Object(Default::default());
+    if let Some(config) = ancestor_config(
+        tree,
+        root,
+        &[".coveragerc", "pyproject.toml", "setup.cfg", "tox.ini"],
+    ) {
+        let text = std::str::from_utf8(&tree[&config].content)?;
+        if config.ends_with(".toml") {
+            let document: toml::Value =
+                toml::from_str(text).with_context(|| format!("invalid {config}"))?;
+            values = serde_json::to_value(document)?["tool"]["coverage"]["run"].clone();
+        } else {
+            let mut in_run = false;
+            let mut key = String::new();
+            for line in text.lines() {
+                let trimmed = line.trim();
+                if trimmed.starts_with('[') {
+                    in_run = matches!(trimmed, "[run]" | "[coverage:run]");
+                    key.clear();
+                    continue;
+                }
+                if !in_run || trimmed.is_empty() || trimmed.starts_with(['#', ';']) {
+                    continue;
+                }
+                if let Some((name, value)) = trimmed.split_once('=') {
+                    key = name.trim().into();
+                    values[&key] = Value::String(value.trim().into());
+                } else if line.starts_with(char::is_whitespace)
+                    && let Some(value) = values
+                        .get_mut(&key)
+                        .and_then(|value| value.as_str().map(str::to_owned))
+                {
+                    values[&key] = Value::String(format!("{value}\n{trimmed}"));
+                }
+            }
+        }
+        settings
+            .notes
+            .push(format!("coverage configuration: {config}"));
+    }
+    settings.python_parallel = values["parallel"].as_bool().unwrap_or_else(|| {
+        values["parallel"].as_str().is_some_and(|value| {
+            matches!(
+                value.to_ascii_lowercase().as_str(),
+                "true" | "yes" | "on" | "1"
+            )
+        })
+    });
+    settings.exclude = list(&values["omit"]).unwrap_or_default();
+    settings.include = list(&values["include"]);
+    let sources = list(&values["source"]);
+    settings.add_python_source = sources.is_none() && settings.include.is_none();
+    if let Some(sources) = sources {
+        let mut include = Vec::new();
+        for source in sources {
+            let module = source.replace('.', "/");
+            let prefix = if root == "." {
+                String::new()
+            } else {
+                format!("{root}/")
+            };
+            let mut found = false;
+            for candidate in [&source, &module, &format!("src/{module}")] {
+                if tree
+                    .keys()
+                    .any(|path| path.starts_with(&format!("{prefix}{candidate}/")))
+                {
+                    include.push(format!("{candidate}/**"));
+                    found = true;
+                } else if tree.contains_key(&format!("{prefix}{candidate}.py")) {
+                    include.push(format!("{candidate}.py"));
+                    found = true;
+                }
+            }
+            if !found {
+                settings.static_known = false;
+            }
+        }
+        if settings.static_known {
+            settings.include = Some(include);
+        }
+    }
+    if values.to_string().contains('$') {
+        settings.static_known = false;
+        settings.reports_unloaded = false;
+    }
+    Ok(settings)
+}
+
+const VITEST_CONFIGS: &[&str] = &[
+    "vitest.config.ts",
+    "vitest.config.js",
+    "vitest.config.mts",
+    "vitest.config.mjs",
+    "vitest.config.cts",
+    "vitest.config.cjs",
+    "vite.config.ts",
+    "vite.config.js",
+    "vite.config.mts",
+    "vite.config.mjs",
+    "vite.config.cts",
+    "vite.config.cjs",
+    "vitest.workspace.ts",
+    "vitest.workspace.js",
+    "vitest.workspace.mts",
+    "vitest.workspace.mjs",
+    "vitest.workspace.cts",
+    "vitest.workspace.cjs",
+    "vitest.workspace.json",
+];
+
+/// Keep workspace imports and relative project paths anchored to their config.
+/// File filters limit a root workspace run when no static project name exists.
+pub fn vitest_execution(tree: &Tree, root: &str) -> (String, Vec<String>) {
+    let workspace = ancestor_config(
+        tree,
+        root,
+        &VITEST_CONFIGS
+            .iter()
+            .copied()
+            .filter(|name| name.starts_with("vitest.workspace"))
+            .collect::<Vec<_>>(),
+    );
+    let mut directory = root.to_owned();
+    let mut projects = None;
+    while let Some(config) = ancestor_config(tree, &directory, VITEST_CONFIGS) {
+        let entry = &tree[&config];
+        if let Ok(syntax) = parse_source(&config, &entry.content)
+            && let Some(object) = exported_object(syntax.root_node(), &entry.content)
+            && property(object, "test", &entry.content)
+                .is_some_and(|test| property(test, "projects", &entry.content).is_some())
+        {
+            projects = Some(config.clone());
+            break;
+        }
+        let parent = config.rsplit_once('/').map_or("", |(dir, _)| dir);
+        if parent.is_empty() {
+            break;
+        }
+        directory = parent
+            .rsplit_once('/')
+            .map_or(".", |(dir, _)| dir)
+            .to_owned();
+    }
+    let config = projects
+        .or(workspace)
+        .or_else(|| ancestor_config(tree, root, VITEST_CONFIGS));
+    let Some(config) = config else {
+        return (root.into(), Vec::new());
+    };
+    let cwd = config
+        .rsplit_once('/')
+        .map_or(".", |(parent, _)| parent)
+        .to_owned();
+    let mut args = Vec::new();
+    if !config.contains("vitest.workspace.") {
+        args.extend(["--config".into(), config.rsplit('/').next().unwrap().into()]);
+    }
+    if cwd != root && root != "." {
+        args.push(root.strip_prefix(&format!("{cwd}/")).unwrap_or(root).into());
+    }
+    (cwd, args)
+}
