diff --git a/crates/rio-graph/src/model.rs b/crates/rio-graph/src/model.rs
new file mode 100644
index 0000000..0023b04
--- /dev/null
+++ b/crates/rio-graph/src/model.rs
@@ -0,0 +1,210 @@
+use anyhow::Result;
+use rio_core::{ImpactSummary, SymbolImpact, Version};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::{BTreeMap, BTreeSet, VecDeque},
+    io::Write,
+    path::Path,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum NodeKind {
+    File,
+    Function,
+    Method,
+    Class,
+    Test,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct GraphNode {
+    pub id: String,
+    pub kind: NodeKind,
+    pub path: String,
+    pub symbol_path: String,
+    pub name: String,
+    pub line_start: u32,
+    pub line_end: u32,
+    pub version: Version,
+    pub seed: bool,
+    pub hop: usize,
+    pub content_hash: String,
+}
+impl GraphNode {
+    pub fn key(&self) -> String {
+        format!("{}::{}", self.path, self.symbol_path)
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum EdgeKind {
+    Calls,
+    Imports,
+    References,
+    Defines,
+    Tests,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum Confidence {
+    Resolved,
+    Probable,
+    Unresolved,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum EdgeSource {
+    #[serde(rename = "tree-sitter")]
+    TreeSitter,
+    #[serde(rename = "text")]
+    Text,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct GraphEdge {
+    pub from: String,
+    pub to: String,
+    pub kind: EdgeKind,
+    pub source: EdgeSource,
+    pub confidence: Confidence,
+    pub version: Version,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct GraphSlice {
+    pub nodes: Vec<GraphNode>,
+    pub edges: Vec<GraphEdge>,
+    pub truncated: bool,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct GraphDelta {
+    pub added: Vec<String>,
+    pub removed: Vec<String>,
+    pub changed: Vec<String>,
+    pub edges_added: Vec<String>,
+    pub edges_removed: Vec<String>,
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct GraphSlices {
+    pub base: GraphSlice,
+    pub head: GraphSlice,
+    pub delta: GraphDelta,
+}
+impl GraphSlices {
+    pub fn new(base: GraphSlice, head: GraphSlice) -> Self {
+        let base_nodes: BTreeMap<_, _> = base.nodes.iter().map(|node| (node.key(), node)).collect();
+        let head_nodes: BTreeMap<_, _> = head.nodes.iter().map(|node| (node.key(), node)).collect();
+        let keys = |slice: &GraphSlice| -> BTreeSet<String> {
+            let nodes: BTreeMap<_, _> = slice
+                .nodes
+                .iter()
+                .map(|node| (node.id.as_str(), node.key()))
+                .collect();
+            slice
+                .edges
+                .iter()
+                .filter_map(|edge| {
+                    Some(format!(
+                        "{} -> {} ({:?}, {:?})",
+                        nodes.get(edge.from.as_str())?,
+                        nodes.get(edge.to.as_str())?,
+                        edge.kind,
+                        edge.confidence
+                    ))
+                })
+                .collect()
+        };
+        let base_edges = keys(&base);
+        let head_edges = keys(&head);
+        let delta = GraphDelta {
+            added: head_nodes
+                .keys()
+                .filter(|key| !base_nodes.contains_key(*key))
+                .cloned()
+                .collect(),
+            removed: base_nodes
+                .keys()
+                .filter(|key| !head_nodes.contains_key(*key))
+                .cloned()
+                .collect(),
+            changed: head_nodes
+                .iter()
+                .filter(|(key, node)| {
+                    base_nodes
+                        .get(*key)
+                        .is_some_and(|base| base.content_hash != node.content_hash)
+                })
+                .map(|(key, _)| key.clone())
+                .collect(),
+            edges_added: head_edges.difference(&base_edges).cloned().collect(),
+            edges_removed: base_edges.difference(&head_edges).cloned().collect(),
+        };
+        Self { base, head, delta }
+    }
+    pub fn write(&self, run: &Path) -> Result<()> {
+        let directory = run.join("graph");
+        rio_git::private_directory(&directory)?;
+        for (name, value) in [
+            ("base", serde_json::to_vec(&self.base)?),
+            ("head", serde_json::to_vec(&self.head)?),
+            ("delta", serde_json::to_vec(&self.delta)?),
+        ] {
+            let mut temporary = tempfile::NamedTempFile::new_in(&directory)?;
+            temporary.write_all(&value)?;
+            temporary.as_file().sync_all()?;
+            temporary
+                .persist(directory.join(format!("{name}.json")))
+                .map_err(|error| error.error)?;
+        }
+        rio_git::sync_directory(&directory)?;
+        Ok(())
+    }
+    pub fn impact(&self, hops: usize) -> ImpactSummary {
+        let mut symbols = Vec::new();
+        let mut seen = BTreeSet::new();
+        for slice in [&self.head, &self.base] {
+            let nodes: BTreeMap<_, _> = slice.nodes.iter().map(|node| (&node.id, node)).collect();
+            for seed in slice.nodes.iter().filter(|node| node.seed) {
+                if !seen.insert(seed.key()) {
+                    continue;
+                }
+                let mut references_per_hop = vec![0; hops];
+                let mut visited: BTreeSet<_> = [seed.id.clone()].into();
+                let mut queue: VecDeque<_> = [(seed.id.clone(), 0)].into();
+                let mut test_referenced = false;
+                let mut unresolved = 0;
+                while let Some((target, hop)) = queue.pop_front() {
+                    if hop >= hops {
+                        continue;
+                    }
+                    for edge in slice.edges.iter().filter(|edge| edge.to == target) {
+                        unresolved += usize::from(edge.confidence == Confidence::Unresolved);
+                        test_referenced |= edge.kind == EdgeKind::Tests
+                            || nodes
+                                .get(&edge.from)
+                                .is_some_and(|node| node.kind == NodeKind::Test);
+                        if visited.insert(edge.from.clone()) {
+                            references_per_hop[hop] += 1;
+                            queue.push_back((edge.from.clone(), hop + 1));
+                        }
+                    }
+                }
+                symbols.push(SymbolImpact {
+                    path: seed.path.clone(),
+                    symbol_path: seed.symbol_path.clone(),
+                    references_per_hop,
+                    test_referenced,
+                    unresolved,
+                });
+            }
+        }
+        symbols.sort_by(|a, b| (&a.path, &a.symbol_path).cmp(&(&b.path, &b.symbol_path)));
+        ImpactSummary {
+            unresolved: symbols.iter().map(|symbol| symbol.unresolved).sum(),
+            symbols,
+            truncated: self.base.truncated || self.head.truncated,
+        }
+    }
+}
diff --git a/crates/rio-graph/src/resolve.rs b/crates/rio-graph/src/resolve.rs
new file mode 100644
index 0000000..f3d81bf
--- /dev/null
+++ b/crates/rio-graph/src/resolve.rs
@@ -0,0 +1,174 @@
+use crate::{Confidence, GraphNode};
+use rio_adapters::{Identifier, SyntaxTable};
+use rio_git::Tree;
+
+fn parent(path: &str) -> &str {
+    path.rsplit_once('/').map_or("", |(parent, _)| parent)
+}
+fn normalize(path: &str) -> Option<String> {
+    let mut parts = Vec::new();
+    for part in path.split('/') {
+        match part {
+            "" | "." => {}
+            ".." => {
+                parts.pop()?;
+            }
+            _ => parts.push(part),
+        }
+    }
+    Some(parts.join("/"))
+}
+fn locate(tree: &Tree, path: &str, python: bool) -> Option<String> {
+    let path = normalize(path)?;
+    let mut candidates = vec![path.clone()];
+    if python {
+        candidates.extend([
+            format!("{path}.py"),
+            format!("{path}/__init__.py"),
+            format!("{path}.pyi"),
+        ]);
+    } else {
+        let stem = path
+            .strip_suffix(".js")
+            .or_else(|| path.strip_suffix(".mjs"))
+            .or_else(|| path.strip_suffix(".cjs"))
+            .unwrap_or(&path);
+        for extension in ["ts", "tsx", "mts", "cts", "js", "jsx", "mjs", "cjs"] {
+            candidates.extend([
+                format!("{stem}.{extension}"),
+                format!("{path}/index.{extension}"),
+            ]);
+        }
+    }
+    candidates
+        .into_iter()
+        .find(|candidate| tree.contains_key(candidate))
+}
+
+pub fn resolve_import(tree: &Tree, path: &str, module: &str) -> Option<String> {
+    let python = rio_adapters::language_for_path(path) == Some("python");
+    if !python {
+        if module.starts_with('.') {
+            return locate(tree, &format!("{}/{module}", parent(path)), false);
+        }
+        if let Some(config) = rio_adapters::ancestor_config(tree, parent(path), &["tsconfig.json"])
+            && let Ok(value) = json5::from_str::<serde_json::Value>(
+                std::str::from_utf8(&tree[&config].content).ok()?,
+            )
+        {
+            let options = &value["compilerOptions"];
+            let config_root = parent(&config);
+            let base = options["baseUrl"].as_str().unwrap_or(".");
+            for (pattern, targets) in options["paths"].as_object().into_iter().flatten() {
+                let wildcard = if let Some((prefix, suffix)) = pattern.split_once('*') {
+                    module
+                        .strip_prefix(prefix)
+                        .and_then(|value| value.strip_suffix(suffix))
+                } else {
+                    (module == pattern).then_some("")
+                };
+                if let Some(wildcard) = wildcard {
+                    for target in targets
+                        .as_array()
+                        .into_iter()
+                        .flatten()
+                        .filter_map(serde_json::Value::as_str)
+                    {
+                        if let Some(path) = locate(
+                            tree,
+                            &format!("{config_root}/{base}/{}", target.replace('*', wildcard)),
+                            false,
+                        ) {
+                            return Some(path);
+                        }
+                    }
+                }
+            }
+            if options["baseUrl"].is_string() {
+                return locate(tree, &format!("{config_root}/{base}/{module}"), false);
+            }
+        }
+        return None;
+    }
+    let dots = module
+        .chars()
+        .take_while(|&character| character == '.')
+        .count();
+    let module = module.trim_start_matches('.').replace('.', "/");
+    if dots > 0 {
+        let mut directory = parent(path);
+        for _ in 1..dots {
+            directory = parent(directory);
+        }
+        return locate(tree, &format!("{directory}/{module}"), true);
+    }
+    let mut directories = vec!["".to_owned(), "src".into()];
+    let mut directory = parent(path);
+    loop {
+        directories.extend([directory.into(), format!("{directory}/src")]);
+        if directory.is_empty() {
+            break;
+        }
+        directory = parent(directory);
+    }
+    for directory in directories {
+        if let Some(path) = locate(tree, &format!("{directory}/{module}"), true) {
+            return Some(path);
+        }
+    }
+    None
+}
+
+/// Imported aliases have a known target. Unresolved imports remain explicitly
+/// uncertain, and imports resolving to another definition are not connected.
+pub fn reference(
+    path: &str,
+    table: &SyntaxTable,
+    identifier: &Identifier,
+    target: &GraphNode,
+    resolved_imports: &std::collections::BTreeMap<String, Option<String>>,
+) -> Option<Confidence> {
+    if identifier.shadowed {
+        return None;
+    }
+    for import in &table.imports {
+        let imported = import.names.get(&identifier.name);
+        let relevant = target.symbol_path.is_empty() && imported.is_some()
+            || imported
+                .is_some_and(|name| name == &target.name || name == "default" || name == "*")
+            || identifier.name == target.name && import.names.values().any(|name| name == "*");
+        if !relevant {
+            continue;
+        }
+        match resolved_imports
+            .get(&import.module)
+            .and_then(Option::as_ref)
+        {
+            Some(definition) if definition == &target.path => return Some(Confidence::Resolved),
+            Some(_) => return None,
+            None if target.name.chars().count() >= 3
+                && (imported.is_some_and(|name| name == &target.name)
+                    || identifier.name == target.name
+                    || import.module.rsplit(['/', '.']).next()
+                        == target
+                            .path
+                            .rsplit('/')
+                            .next()
+                            .and_then(|name| name.split('.').next())) =>
+            {
+                return Some(Confidence::Unresolved);
+            }
+            None => return None,
+        }
+    }
+    if identifier.name != target.name {
+        return None;
+    }
+    if path == target.path {
+        Some(Confidence::Resolved)
+    } else if target.name.chars().count() >= 3 {
+        Some(Confidence::Probable)
+    } else {
+        None
+    }
+}
diff --git a/crates/rio-graph/tests/graph.rs b/crates/rio-graph/tests/graph.rs
