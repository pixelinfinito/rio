+    let outcome = evaluate_exit(&result, &contract.exit_codes, parsed);
+    assert!(
+        matches!(outcome, CheckOutcome::Findings { .. }),
+        "{outcome:?}; stderr={}",
+        String::from_utf8_lossy(&result.stderr)
+    );
+    assert!(!cached_path.join(dependency).exists());
