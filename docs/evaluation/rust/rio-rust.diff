+use rio_core::*;
+fn fixture(name: &str) -> Report {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests/fixtures")
+        .join(format!("{name}.json"));
+    serde_json::from_slice(&std::fs::read(path).unwrap()).unwrap()
+}
+#[test]
+fn terminal_and_markdown_snapshots() {
+    let policy = FailOn::default().compile().unwrap();
+    for name in ["complete", "incomplete", "partial", "no_changes", "error"] {
+        let mut report = fixture(name);
+        if name == "incomplete" {
+            report.findings.clear();
+            report.risks.clear();
+        }
+        for width in [80, 120] {
+            let options = RenderOptions {
+                width,
+                show_pre_existing: true,
+                policy: Some(&policy),
+                ..Default::default()
+            };
+            let output = render_terminal(&report, &options);
+            assert!(output.lines().all(|line| line.chars().count() <= width));
+            insta::assert_snapshot!(format!("{name}_{width}"), output);
+        }
+        insta::assert_snapshot!(
+            format!("{name}_markdown"),
+            render_markdown(&report, &RenderOptions::default())
+        );
+    }
+}
+#[test]
+fn json_validates_all_statuses_and_rejects_invalid_reports_before_output() {
+    for name in ["complete", "incomplete", "partial", "no_changes", "error"] {
+        let report = fixture(name);
+        let output = render_json(&report).unwrap();
+        let parsed: serde_json::Value = serde_json::from_slice(&output).unwrap();
+        assert!(parsed["metrics"]["wall_time_ms"].is_number());
+        for check in parsed["checks"].as_array().unwrap() {
+            assert!(check["wall_time_ms"].is_number());
+        }
+    }
+    assert!(render_json(&Report::empty(ReportStatus::Error)).is_err());
+}
+#[test]
+fn every_renderer_redacts_credentials_and_uses_stable_headings() {
+    let mut report = fixture("complete");
+    report
+        .footer
+        .notes
+        .push("token = ghp_abcdefghijklmnopqrstuvwxyz1234567890".into());
+    for output in [
+        render_terminal(&report, &RenderOptions::default()),
+        render_markdown(&report, &RenderOptions::default()),
+        String::from_utf8(render_json(&report).unwrap()).unwrap(),
+    ] {
+        assert!(!output.contains("abcdefghijklmnopqrstuvwxyz"));
+        assert!(output.contains("[REDACTED]"));
+        assert!(!output.contains('\x1b'));
+    }
+    let first = render_markdown(&report, &RenderOptions::default());
+    let second = render_markdown(&fixture("partial"), &RenderOptions::default());
+    for heading in ["## Deterministic results", "## Findings", "## Footer"] {
+        assert!(first.contains(heading));
+        assert!(second.contains(heading));
+    }
+}
+#[test]
+fn progress_reports_completed_outcomes() {
+    assert!(
+        render_progress(&ReviewEvent::CheckFinished {
+            kind: CheckKind::Coverage,
+            root: "pkg".into(),
+            findings: 0,
+            skipped: false,
+            outcome: CheckOutcome::Cancelled {
+                reason: CancellationReason::Timeout,
+                details: CheckDetails::default()
+            }
+        })
+        .unwrap()
+        .contains("cancelled (timeout)")
+    );
+}
+
+#[test]
+fn dependency_and_baseline_headers_count_unclassified_findings_and_name_a_remedy() {
+    for (reason, hint, note, expected) in [
+        (
+            Some(SkipReason::DependencyMismatch),
+            "installed example differs",
+            "",
+            "0 unclassified: dependency_mismatch; install from lockfile.",
+        ),
+        (
+            Some(SkipReason::DependencyMismatch),
+            "no lockfile (set trust_installed_dependencies to run anyway)",
+            "",
+            "0 unclassified: dependency_mismatch; set trust_installed_dependencies.",
+        ),
+        (
+            None,
+            "",
+            "baseline_failed: base dependencies differ",
+            "1 unclassified: baseline_failed; check base tools; install from base lockfile.",
+        ),
+        (
+            None,
+            "",
+            "baseline disabled in the profile",
+            "1 unclassified: baseline disabled; enable baseline in profile.",
+        ),
+        (
+            None,
+            "",
+            "",
+            "1 unclassified: baseline unavailable; check baseline hint in footer.",
+        ),
+    ] {
+        let mut report = fixture("complete");
+        report.risks.clear();
+        report.findings.truncate(1);
+        report.findings[0].state = if reason.is_some() {
+            State::PreExisting
+        } else {
+            State::Unclassified
+        };
+        report.checks.truncate(1);
+        report.incomplete.clear();
+        report.footer.notes = if note.is_empty() {
+            Vec::new()
+        } else {
+            vec![note.into()]
+        };
+        if let Some(reason) = reason {
+            report.checks[0].outcome = CheckOutcome::Skipped {
+                reason,
+                details: CheckDetails {
+                    hint: Some(hint.into()),
+                    ..Default::default()
+                },
+            };
+        }
+        for output in [
+            render_terminal(&report, &RenderOptions::default()),
+            render_markdown(&report, &RenderOptions::default()),
+        ] {
+            assert!(
+                output.lines().take(8).any(|line| line.trim() == expected),
+                "{output}"
+            );
+        }
+    }
+}
+
+#[test]
+fn trusted_results_with_a_baseline_do_not_claim_to_be_unclassified() {
+    let mut report = fixture("complete");
+    report
+        .findings
+        .iter_mut()
+        .for_each(|f| f.state = State::New);
+    report.risks.clear();
+    report
+        .footer
+        .notes
+        .push("dependencies_trusted: results use unverified dependencies".into());
+    for output in [
+        render_terminal(&report, &RenderOptions::default()),
+        render_markdown(&report, &RenderOptions::default()),
+    ] {
+        assert!(!output.contains("unclassified:"));
+        assert!(output.contains("dependencies_trusted"));
+    }
+}
diff --git a/crates/rio-engine/src/cache.rs b/crates/rio-engine/src/cache.rs
new file mode 100644
index 0000000..0ba96a5
--- /dev/null
+++ b/crates/rio-engine/src/cache.rs
@@ -0,0 +1,429 @@
+use anyhow::{Context, Result, ensure};
+use fs4::fs_std::FileExt;
+use rio_git::{private_directory, private_file, sync_directory};
+use serde::{Deserialize, Serialize};
+use std::{
+    collections::BTreeSet,
+    fs::{self, File},
+    io::Write,
+    path::{Component, Path, PathBuf},
+    sync::Mutex,
+    time::{Duration, Instant, SystemTime},
+};
+use tokio_util::sync::CancellationToken;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CacheOptions {
+    pub dir: PathBuf,
+    pub max_age: Duration,
+    pub max_size: u64,
+    pub retain_raw_output: bool,
+}
+impl CacheOptions {
+    pub fn for_repository(root: &Path) -> Self {
+        Self {
+            dir: root.join(".rio/cache"),
+            max_age: Duration::from_secs(30 * 86400),
+            max_size: 5 * 1024 * 1024 * 1024,
+            retain_raw_output: true,
+        }
+    }
+}
+
+pub fn atomic_write(path: &Path, bytes: &[u8]) -> Result<()> {
+    let parent = path.parent().context("cache path has no parent")?;
+    private_directory(parent)?;
+    let mut temporary = tempfile::Builder::new()
+        .prefix(&format!(
+            "{}.tmp-",
+            path.file_name().unwrap().to_string_lossy()
+        ))
+        .tempfile_in(parent)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        temporary
+            .as_file()
+            .set_permissions(fs::Permissions::from_mode(0o600))?;
+    }
+    temporary.write_all(bytes)?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(path).map_err(|error| error.error)?;
+    sync_directory(parent)?;
+    Ok(())
+}
+
+pub struct RunCache {
+    pub options: CacheOptions,
+    pub review_id: String,
+    pub run_id: String,
+    pub path: PathBuf,
+    _live: File,
+    refs: Mutex<BTreeSet<String>>,
+}
+impl RunCache {
+    pub fn begin(options: CacheOptions, review_id: String) -> Result<Self> {
+        ensure!(
+            review_id.len() == 16 && review_id.bytes().all(|byte| byte.is_ascii_hexdigit()),
+            "invalid review id"
+        );
+        private_directory(&options.dir)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            fs::set_permissions(&options.dir, fs::Permissions::from_mode(0o700))?;
+        }
+        let prune = private_file(&options.dir.join("prune.lock"), false)?;
+        FileExt::lock_shared(&prune)?;
+        atomic_write(&options.dir.join(".gitignore"), b"*\n")?;
+        let run_id = ulid::Ulid::new().to_string();
+        private_directory(&options.dir.join("active"))?;
+        let live = private_file(
+            &options.dir.join("active").join(format!("{run_id}.lock")),
+            false,
+        )?;
+        FileExt::lock_exclusive(&live)?;
+        atomic_write(
+            &options.dir.join("active").join(format!("{run_id}.refs")),
+            b"[]",
+        )?;
+        let path = options.dir.join(&review_id).join("runs").join(&run_id);
+        private_directory(&path)?;
+        drop(prune);
+        Ok(Self {
+            options,
+            review_id,
+            run_id,
+            path,
+            _live: live,
+            refs: Mutex::new(BTreeSet::new()),
+        })
+    }
+    pub fn reference(&self, relative: &str) -> Result<()> {
+        ensure!(
+            !relative.is_empty()
+                && Path::new(relative)
+                    .components()
+                    .all(|part| matches!(part, Component::Normal(_))),
+            "unsafe cache reference"
+        );
+        let prune = private_file(&self.options.dir.join("prune.lock"), false)?;
+        FileExt::lock_shared(&prune)?;
+        let mut refs = self.refs.lock().unwrap();
+        refs.insert(relative.into());
+        let bytes = serde_json::to_vec(&*refs)?;
+        atomic_write(
+            &self
+                .options
+                .dir
+                .join("active")
+                .join(format!("{}.refs", self.run_id)),
+            &bytes,
+        )?;
+        atomic_write(&self.path.join("shared.refs.json"), &bytes)?;
+        let used = self.options.dir.join(format!("{relative}.used"));
+        atomic_write(
+            &used,
+            &SystemTime::now()
+                .duration_since(SystemTime::UNIX_EPOCH)?
+                .as_secs()
+                .to_string()
+                .into_bytes(),
+        )?;
+        Ok(())
+    }
+    pub fn unreference(&self, relative: &str) -> Result<()> {
+        let prune = private_file(&self.options.dir.join("prune.lock"), false)?;
+        FileExt::lock_shared(&prune)?;
+        let mut refs = self.refs.lock().unwrap();
+        refs.remove(relative);
+        let bytes = serde_json::to_vec(&*refs)?;
+        atomic_write(
+            &self
+                .options
+                .dir
+                .join("active")
+                .join(format!("{}.refs", self.run_id)),
+            &bytes,
+        )?;
+        atomic_write(&self.path.join("shared.refs.json"), &bytes)
+    }
+
+    pub fn write(&self, relative: &str, bytes: &[u8]) -> Result<()> {
+        ensure!(
+            Path::new(relative)
+                .components()
+                .all(|part| matches!(part, Component::Normal(_))),
+            "unsafe run path"
+        );
+        let prune = private_file(&self.options.dir.join("prune.lock"), false)?;
+        FileExt::lock_shared(&prune)?;
+        atomic_write(&self.path.join(relative), bytes)
+    }
+    pub fn finish(&self, report: &rio_core::Report) -> Result<()> {
+        self.write("report.json", &serde_json::to_vec(report)?)?;
+        let prune = private_file(&self.options.dir.join("prune.lock"), false)?;
+        FileExt::lock_shared(&prune)?;
+        atomic_write(
+            &self.options.dir.join(&self.review_id).join("latest"),
+            self.run_id.as_bytes(),
+        )
+    }
+    pub async fn entry_lock(
+        &self,
+        relative: &str,
+        timeout: Duration,
+        cancellation: &CancellationToken,
+    ) -> Result<File> {
+        self.reference(relative)?;
+        let path = self.options.dir.join(format!("{relative}.lock"));
+        private_directory(path.parent().unwrap())?;
+        let lock = private_file(&path, false)?;
+        let start = Instant::now();
+        while !FileExt::try_lock_exclusive(&lock)? {
+            ensure!(
+                start.elapsed() < timeout,
+                "timeout waiting for cache entry {relative}"
+            );
+            tokio::select! {_=cancellation.cancelled()=>anyhow::bail!("interrupted"),_=tokio::time::sleep(Duration::from_millis(10))=>{}}
+        }
+        Ok(lock)
+    }
+}
+impl Drop for RunCache {
+    fn drop(&mut self) {
+        let _ = FileExt::unlock(&self._live);
+        let _ = fs::remove_file(
+            self.options
+                .dir
+                .join("active")
+                .join(format!("{}.lock", self.run_id)),
+        );
+        let _ = fs::remove_file(
+            self.options
+                .dir
+                .join("active")
+                .join(format!("{}.refs", self.run_id)),
+        );
+    }
+}
+
+fn list(directory: &Path) -> Vec<PathBuf> {
+    fs::read_dir(directory)
+        .into_iter()
+        .flatten()
+        .filter_map(|entry| entry.ok().map(|entry| entry.path()))
+        .collect()
+}
+fn size(path: &Path, deadline: Instant) -> u64 {
+    if Instant::now() >= deadline {
+        return 0;
+    }
+    match fs::symlink_metadata(path) {
+        Ok(metadata) if metadata.is_dir() => {
+            list(path).iter().map(|path| size(path, deadline)).sum()
+        }
+        Ok(metadata) => metadata.len(),
+        Err(_) => 0,
+    }
+}
+fn used(path: &Path) -> SystemTime {
+    fs::metadata(format!("{}.used", path.display()))
+        .and_then(|metadata| metadata.modified())
+        .or_else(|_| fs::metadata(path).and_then(|metadata| metadata.modified()))
+        .unwrap_or(SystemTime::UNIX_EPOCH)
+}
+fn remove(path: &Path) {
+    if fs::symlink_metadata(path).is_ok_and(|metadata| metadata.is_dir()) {
+        let _ = fs::remove_dir_all(path);
+    } else {
+        let _ = fs::remove_file(path);
+    }
+    let _ = fs::remove_file(format!("{}.used", path.display()));
+}
+fn repair_latest(review: &Path) -> Result<()> {
+    let latest = review.join("latest");
+    let current = fs::read_to_string(&latest).ok();
+    if current.as_ref().is_some_and(|id| {
+        !id.is_empty()
+            && Path::new(id)
+                .components()
+                .all(|part| matches!(part, Component::Normal(_)))
+            && review.join("runs").join(id).join("report.json").is_file()
+    }) {
+        return Ok(());
+    }
+    let newest = list(&review.join("runs"))
+        .into_iter()
+        .filter(|run| run.join("report.json").is_file())
+        .max_by_key(|run| used(&run.join("report.json")));
+    if let Some(run) = newest {
+        atomic_write(&latest, run.file_name().unwrap().as_encoded_bytes())?;
+    } else if latest.exists() {
+        fs::remove_file(latest)?;
+    }
+    Ok(())
+}
+
+fn referenced(path: &Path, cache: &Path, refs: &BTreeSet<String>) -> bool {
+    path.strip_prefix(cache).ok().is_some_and(|relative| {
+        refs.iter().any(|reference| {
+            let reference = Path::new(reference);
+            relative.starts_with(reference) || reference.starts_with(relative)
+        })
+    })
+}
+
+/// `reachable_bases = None` preserves baselines when reachability could not be
+/// established. Deletion is bounded and never follows source/dependency links.
+pub fn prune_cache(
+    options: &CacheOptions,
+    reachable_bases: Option<&BTreeSet<String>>,
+) -> Result<()> {
+    if !options.dir.exists() {
+        return Ok(());
+    }
+    let prune = private_file(&options.dir.join("prune.lock"), false)?;
+    if !FileExt::try_lock_exclusive(&prune)? {
+        return Ok(());
+    }
+    let start = Instant::now();
+    let now = SystemTime::now();
+    let mut live_refs = BTreeSet::new();
+    let mut live_ids = BTreeSet::new();
+    for marker in list(&options.dir.join("active"))
+        .into_iter()
+        .filter(|path| {
+            path.extension()
+                .is_some_and(|extension| extension == "lock")
+        })
+    {
+        let id = marker.file_stem().unwrap().to_string_lossy().into_owned();
+        let lock = private_file(&marker, false)?;
+        if !FileExt::try_lock_exclusive(&lock)? {
+            live_ids.insert(id);
+            if let Ok(bytes) = fs::read(marker.with_extension("refs"))
+                && let Ok(refs) = serde_json::from_slice::<BTreeSet<String>>(&bytes)
+            {
+                live_refs.extend(refs);
+            }
+        } else {
+            drop(lock);
+            remove(&marker);
+            remove(&marker.with_extension("refs"));
+        }
+    }
+    let mut persistent_refs = BTreeSet::new();
+    let mut entries = Vec::new();
+    for review in list(&options.dir).into_iter().filter(|path| {
+        path.file_name().is_some_and(|name| {
+            name.len() == 16
+                && name
+                    .to_string_lossy()
+                    .bytes()
+                    .all(|byte| byte.is_ascii_hexdigit())
+        })
+    }) {
+        for run in list(&review.join("runs")) {
+            let live = run
+                .file_name()
+                .is_some_and(|name| live_ids.contains(name.to_string_lossy().as_ref()));
+            if !live && now.duration_since(used(&run)).unwrap_or_default() > options.max_age {
+                remove(&run);
+                continue;
+            }
+            if let Ok(bytes) = fs::read(run.join("shared.refs.json"))
+                && let Ok(refs) = serde_json::from_slice::<BTreeSet<String>>(&bytes)
+            {
+                persistent_refs.extend(refs);
+            }
+            entries.push(run);
+        }
+        if list(&review.join("runs")).is_empty() {
+            remove(&review);
+        } else {
+            repair_latest(&review)?;
+        }
+        if start.elapsed() > Duration::from_secs(1) {
+            return Ok(());
+        }
+    }
+    fn recover(directory: &Path, live: &BTreeSet<String>, start: Instant) {
+        for path in list(directory) {
+            if start.elapsed() > Duration::from_secs(1) {
+                return;
+            }
+            let name = path.file_name().unwrap().to_string_lossy();
+            if live.contains(name.as_ref()) {
+                continue;
+            }
+            if let Some((entry, _)) = name.split_once(".tmp-") {
+                if live.iter().any(|id| name.ends_with(id)) {
+                    continue;
+                }
+                let lock_path = path.parent().unwrap().join(format!("{entry}.lock"));
+                let lock = File::open(lock_path).ok();
+                if lock
+                    .as_ref()
+                    .is_some_and(|lock| !FileExt::try_lock_exclusive(lock).unwrap_or(false))
+                {
+                    continue;
+                }
+                remove(&path);
+            } else if fs::symlink_metadata(&path).is_ok_and(|metadata| metadata.is_dir())
+                && name != "tree"
+            {
+                recover(&path, live, start);
+            }
+        }
+    }
+    recover(&options.dir, &live_ids, start);
+    for namespace in ["snapshots", "heads", "osv", "baselines"] {
+        for entry in list(&options.dir.join(namespace)) {
+            if start.elapsed() > Duration::from_secs(1) {
+                return Ok(());
+            }
+            let filename = entry.file_name().unwrap().to_string_lossy();
+            if filename.ends_with(".lock")
+                || filename.ends_with(".used")
+                || filename.contains(".tmp-")
+            {
+                continue;
+            }
+            let retained = referenced(&entry, &options.dir, &live_refs);
+            let unreachable = namespace == "baselines"
+                && reachable_bases.is_some_and(|bases| !bases.contains(filename.as_ref()));
+            let unreferenced =
+                namespace != "baselines" && !referenced(&entry, &options.dir, &persistent_refs);
+            if !retained && (unreachable || unreferenced) {
+                remove(&entry);
+            } else {
+                entries.push(entry);
+            }
+        }
+    }
+    let mut total = size(&options.dir, start + Duration::from_secs(1));
+    entries.sort_by_key(|entry| used(entry));
+    for entry in entries {
+        if total <= options.max_size || start.elapsed() > Duration::from_secs(1) {
+            break;
+        }
+        if referenced(&entry, &options.dir, &live_refs)
+            || entry
+                .file_name()
+                .is_some_and(|name| live_ids.contains(name.to_string_lossy().as_ref()))
+        {
+            continue;
+        }
+        let bytes = size(&entry, start + Duration::from_secs(1));
+        remove(&entry);
+        total = total.saturating_sub(bytes);
+        if entry
+            .parent()
+            .is_some_and(|parent| parent.file_name().is_some_and(|name| name == "runs"))
+        {
+            repair_latest(entry.parent().unwrap().parent().unwrap())?;
+        }
+    }
+    Ok(())
+}
diff --git a/crates/rio-engine/src/execute.rs b/crates/rio-engine/src/execute.rs
new file mode 100644
index 0000000..9700473
--- /dev/null
+++ b/crates/rio-engine/src/execute.rs
@@ -0,0 +1,1048 @@
+use crate::{
+    CacheOptions, PlanRequest, PlannedCheck, ReviewPlan, RunCache, atomic_write, plan_review,
+    profile_excludes, prune_cache,
+};
+use anyhow::{Context, Result, ensure};
+use rio_adapters::*;
+use rio_core::*;
+use rio_git::*;
+use rio_graph::{GraphBuilder, GraphOptions};
+use rio_profile::{ResolvedProfile, Step, parse_duration, resolve_module};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    path::PathBuf,
+    sync::Arc,
+    time::{Duration, Instant},
+};
+use tokio::{
+    sync::{Semaphore, mpsc},
+    task::JoinSet,
+};
+use tokio_util::sync::CancellationToken;
+
+pub struct ReviewRequest {
+    pub worktree: PathBuf,
+    pub working: Tree,
+    pub changes: ChangeSet,
+    pub profile: ResolvedProfile,
+    pub cache: CacheOptions,
+    pub parallelism: usize,
+    pub output_limit: usize,
+    pub offline: bool,
+}
+struct Execution {
+    request: ReviewRequest,
+    diff: Diff,
+    cache: Arc<RunCache>,
+    supervisor: ProcessSupervisor,
+    cancellation: CancellationToken,
+    deadline: Instant,
+    per_check: Duration,
+    links: Vec<DependencyLink>,
+    materials: Option<Materializations>,
+    material_error: Option<String>,
+}
+#[derive(Default)]
+struct CheckResult {
+    entries: Vec<CheckEntry>,
+    findings: Vec<Finding>,
+    coverage: CoverageData,
+    settings: Vec<CoverageSettings>,
+    notes: Vec<String>,
+    tools_ran: bool,
+}
+
+pub fn ordered_steps(profile: &ResolvedProfile) -> Result<Vec<Step>> {
+    let mut remaining = profile.profile.steps.clone();
+    let mut done = BTreeSet::new();
+    let mut ordered = Vec::new();
+    while !remaining.is_empty() {
+        let index = remaining
+            .iter()
+            .position(|step| step.needs.iter().all(|need| done.contains(need)))
+            .context("step dependency cycle")?;
+        let step = remaining.remove(index);
+        done.insert(step.id.clone());
+        ordered.push(step);
+    }
+    Ok(ordered)
+}
+fn emit(sender: &Option<mpsc::UnboundedSender<ReviewEvent>>, event: ReviewEvent) {
+    if let Some(sender) = sender {
+        let _ = sender.send(event);
+    }
+}
+fn timeout_for(kind: CheckKind, budget: Duration) -> Duration {
+    budget.mul_f64(match kind {
+        CheckKind::Typecheck | CheckKind::Lint => 0.4,
+        CheckKind::Coverage => 0.6,
+        _ => 0.1,
+    })
+}
+fn key(kind: CheckKind) -> &'static str {
+    match kind {
+        CheckKind::Typecheck => "typecheck",
+        CheckKind::Lint => "lint",
+        CheckKind::Coverage => "coverage",
+        CheckKind::Secrets => "secrets",
+        CheckKind::Dependencies => "dependencies",
+    }
+}
+fn component(root: &str) -> String {
+    if root == "." {
+        return "%2E".into();
+    }
+    root.bytes()
+        .map(|byte| {
+            if byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-' | b'.') {
+                (byte as char).to_string()
+            } else {
+                format!("%{byte:02X}")
+            }
+        })
+        .collect()
+}
+fn check_path(check: &PlannedCheck, version: Version) -> String {
+    format!(
+        "checks/{}/{}/{}",
+        key(check.kind),
+        component(&check.root),
+        if version == Version::Base {
+            "base"
+        } else {
+            "head"
+        }
+    )
+}
+fn cancelled(reason: CancellationReason) -> CheckOutcome {
+    CheckOutcome::Cancelled {
+        reason,
+        details: CheckDetails::default(),
+    }
+}
+fn failure(message: String) -> CheckOutcome {
+    CheckOutcome::Failed {
+        reason: if message.contains("disk_full") || message.contains("No space left") {
+            FailureReason::DiskFull
+        } else {
+            FailureReason::ToolCrashed
+        },
+        details: CheckDetails {
+            hint: Some(redact(&message)),
+            ..Default::default()
+        },
+    }
+}
+fn completed(outcome: &CheckOutcome) -> bool {
+    matches!(
+        outcome,
+        CheckOutcome::Passed { .. } | CheckOutcome::Findings { .. }
+    )
+}
+fn entry(
+    check: &PlannedCheck,
+    version: Version,
+    outcome: CheckOutcome,
+    wall: Duration,
+    cached: bool,
+) -> CheckEntry {
+    CheckEntry {
+        kind: check.kind,
+        language: check.language.clone(),
+        root: check.root.clone(),
+        version,
+        scheduled_as: check.scheduled_as,
+        outcome,
+        wall_time_ms: wall.as_millis() as u64,
+        cached,
+    }
+}
+
+impl Execution {
+    fn available(&self, kind: CheckKind) -> Duration {
+        timeout_for(kind, self.per_check)
+            .min(self.deadline.saturating_duration_since(Instant::now()))
+    }
+    fn before(&self) -> Option<CheckOutcome> {
+        if self.cancellation.is_cancelled() {
+            Some(cancelled(CancellationReason::Interrupted))
+        } else if Instant::now() >= self.deadline {
+            Some(cancelled(CancellationReason::Timeout))
+        } else {
+            None
+        }
+    }
+    fn persist_process(
+        &self,
+        check: &PlannedCheck,
+        version: Version,
+        result: &ProcessResult,
+    ) -> Result<()> {
+        if self.request.cache.retain_raw_output {
+            let path = check_path(check, version);
+            self.cache
+                .write(&format!("{path}/stdout.txt"), &result.raw_stdout)?;
+            self.cache
+                .write(&format!("{path}/stderr.txt"), &result.raw_stderr)?;
+        }
+        Ok(())
+    }
+    async fn diagnostic(
+        &self,
+        check: &PlannedCheck,
+        version: Version,
+    ) -> Result<(CheckEntry, bool)> {
+        let started = Instant::now();
+        if let Some(outcome) = self.before() {
+            return Ok((
+                entry(check, version, outcome, started.elapsed(), false),
+                false,
+            ));
+        }
+        let materials = self
+            .materials
+            .as_ref()
+            .context("materialization unavailable")?;
+        let (cached, tree) = if version == Version::Head {
+            (&materials.head, &self.request.changes.head)
+        } else {
+            (&materials.base, &self.request.changes.base)
+        };
+        let targets: Vec<_> = check
+            .targets
+            .iter()
+            .map(|path| {
+                if version == Version::Base {
+                    self.diff
+                        .files
+                        .iter()
+                        .find(|file| &file.path == path)
+                        .and_then(|file| file.old_path.clone())
+                        .unwrap_or_else(|| path.clone())
+                } else {
+                    path.clone()
+                }
+            })
+            .filter(|path| tree.contains_key(path))
+            .collect();
+        if check.kind == CheckKind::Lint && targets.is_empty() {
+            return Ok((
+                entry(
+                    check,
+                    version,
+                    CheckOutcome::Passed {
+                        details: CheckDetails {
+                            hint: Some("No changed files exist in this version".into()),
+                            ..Default::default()
+                        },
+                    },
+                    started.elapsed(),
+                    false,
+                ),
+                false,
+            ));
+        }
+        let disposable =
+            ToolTree::create_until(cached, &self.cache.path.join("tools"), &self.links, &|| {
+                self.before().is_some()
+            })?;
+        let remapped = if version == Version::Base && check.baseline_remap {
+            remap_base_dependencies(
+                &self.request.worktree,
+                disposable.path(),
+                &self.links,
+                &self.request.working,
+                tree,
+                &|| self.before().is_some(),
+            )?
+        } else {
+            BaseDependencyRemap::default()
+        };
+        let tool = check.tool.as_ref().context("no diagnostic tool")?;
+        let mut command = diagnostic_command(tool, tree, disposable.path(), &check.root, &targets)?;
+        if version == Version::Base && tool.name == "tsc" {
+            remapped.configure_typescript(&mut command)?;
+        }
+        if remapped.packages > 0 {
+            configure_base_command(
+                &mut command,
+                &self.request.worktree,
+                disposable.path(),
+                &self.links,
+                &tool.name,
+            )?;
+        }
+        command.timeout = self.available(check.kind);
+        command.output_limit = self.request.output_limit;
+        let result = self
+            .supervisor
+            .run(command, self.cancellation.clone())
+            .await;
+        let context = DiagnosticContext {
+            repository_root: disposable.path(),
+            project_root: &check.root,
+            tool_version: &tool.version,
+            worktree_root: Some(&self.request.worktree),
+            sources: Some(tree),
+        };
+        let adapter: &dyn Adapter = if check.language == "typescript" {
+            &TypeScriptAdapter
+        } else {
+            &PythonAdapter
+        };
+        let parsed = adapter.parse_output(&tool.name, &result.stdout, &result.stderr, &context);
+        let spec = tool_contract(&adapter.manifest().name, key(check.kind), &tool.name)?;
+        let mut outcome = evaluate_exit(&result, &spec.exit_codes, parsed);
+        outcome.details_mut().dependency_state = check.dependency_state;
+        if remapped.packages > 0 {
+            let note = format!(
+                "baseline: {} linked packages remapped to base",
+                remapped.packages
+            );
+            let hint = &mut outcome.details_mut().hint;
+            *hint = Some(
+                hint.as_ref()
+                    .map_or(note.clone(), |hint| format!("{hint}; {note}")),
+            );
+        }
+        if let Err(error) = self.persist_process(check, version, &result) {
+            outcome = failure(error.to_string());
+        }
+        if !result.cleanup_confirmed {
+            let preserved = disposable.preserve();
+            outcome.details_mut().hint = Some(format!(
+                "{}; disposable tree retained at {}",
+                outcome
+                    .details()
+                    .hint
+                    .as_deref()
+                    .unwrap_or("process cleanup unconfirmed"),
+                preserved.display()
+            ));
+        }
+        self.cache.write(
+            &format!("{}/findings.json", check_path(check, version)),
+            &serde_json::to_vec(&outcome.details().findings)?,
+        )?;
+        Ok((
+            entry(check, version, outcome, started.elapsed(), false),
+            true,
+        ))
+    }
+
+    async fn baseline(&self, check: &PlannedCheck) -> Result<(CheckEntry, bool)> {
+        // Unverified installation metadata cannot prove that a prior run used
+        // this environment. Compare trusted head/base results within this run.
+        // Linked overlays may consume untracked artifacts. Rebuild and run
+        // them per invocation rather than reuse a cache keyed by tracked inputs.
+        if check.dependency_state == Some(DependencyState::Trusted) || check.baseline_remap {
+            return self.diagnostic(check, Version::Base).await;
+        }
+        let tool = check.tool.as_ref().context("no baseline tool")?;
+        let mut targets = check.targets.clone();
+        targets.sort();
+        let input = serde_json::to_vec(
+            &serde_json::json!({"version":1,"root":check.root,"kind":check.kind,"tool":tool.name,"tool_version":tool.version,"targets":targets,"dependencies":check.dependency_hash,"dependency_state":check.dependency_state,"invocation":"rio-diagnostic-v4-source-overlay"}),
+        )?;
+        let hash = blake3::hash(&input).to_hex().to_string();
+        let relative = format!(
+            "baselines/{}/{}/{hash}.json",
+            self.request.changes.base_id,
+            key(check.kind)
+        );
+        let _lock = self
+            .cache
+            .entry_lock(&relative, self.available(check.kind), &self.cancellation)
+            .await?;
+        let path = self.cache.options.dir.join(&relative);
+        if let Ok(bytes) = std::fs::read(&path)
+            && let Ok(mut cached) = serde_json::from_slice::<CheckEntry>(&bytes)
+        {
+            cached.cached = true;
+            cached.wall_time_ms = 0;
+            return Ok((cached, false));
+        }
+        let (baseline, ran) = self.diagnostic(check, Version::Base).await?;
+        if completed(&baseline.outcome) {
+            atomic_write(&path, &serde_json::to_vec(&baseline)?)?;
+        }
+        Ok((baseline, ran))
+    }
+
+    async fn check(&self, check: PlannedCheck) -> Result<CheckResult> {
+        let started = Instant::now();
+        let mut result = CheckResult::default();
+        if let Some(outcome) = self.before().or_else(|| check.skip.clone()) {
+            result.entries.push(entry(
+                &check,
+                Version::Head,
+                outcome,
+                started.elapsed(),
+                false,
+            ));
+            return Ok(result);
+        }
+        match check.kind {
+            CheckKind::Typecheck | CheckKind::Lint => {
+                if let Some(error) = &self.material_error {
+                    result.entries.push(entry(
+                        &check,
+                        Version::Head,
+                        failure(error.clone()),
+                        started.elapsed(),
+                        false,
+                    ));
+                    return Ok(result);
+                }
+                let (mut head, ran) = self.diagnostic(&check, Version::Head).await?;
+                result.tools_ran |= ran;
+                if let Some(hint) = &check.baseline_hint {
+                    result
+                        .notes
+                        .push(format!("{} {}: {hint}", key(check.kind), check.root));
+                }
+                let baseline = if check.baseline && completed(&head.outcome) {
+                    match self.baseline(&check).await {
+                        Ok((base, ran)) => {
+                            result.tools_ran |= ran;
+                            let findings = completed(&base.outcome)
+                                .then(|| base.outcome.details().findings.clone());
+                            if findings.is_none() {
+                                result.notes.push(format!(
+                                    "baseline_failed: {} {}: {:?}",
+                                    key(check.kind),
+                                    check.root,
+                                    base.outcome
+                                ));
+                            }
+                            if base.cached {
+                                result.notes.push(format!(
+                                    "{} {} baseline cached",
+                                    key(check.kind),
+                                    check.root
+                                ));
+                            }
+                            result.entries.push(base);
+                            findings
+                        }
+                        Err(error) => {
+                            result.notes.push(format!(
+                                "baseline_failed: {} {}: {error}",
+                                key(check.kind),
+                                check.root
+                            ));
+                            None
+                        }
+                    }
+                } else {
+                    None
+                };
+                let findings = classify_and_group_scoped(
+                    baseline,
+                    head.outcome.details().findings.clone(),
+                    |path, line| self.diff.map_line(path, line),
+                    |location| {
+                        self.diff.files.iter().any(|file| {
+                            file.path == location.path
+                                && file.hunks.iter().any(|hunk| {
+                                    // Three context lines on either side, including
+                                    // the surviving boundary of a deletion-only hunk.
+                                    let start = hunk.head.start.saturating_sub(3).max(1);
+                                    let end = hunk
+                                        .head
+                                        .start
+                                        .saturating_add(hunk.head.count.saturating_sub(1))
+                                        .saturating_add(3);
+                                    location.line_start <= end && location.line_end >= start
+                                })
+                        })
+                    },
+                )?;
+                head.outcome.details_mut().findings = findings.clone();
+                result.findings = findings;
+                result.entries.insert(0, head);
+            }
+            CheckKind::Coverage => {
+                if let Some(error) = &self.material_error {
+                    result.entries.push(entry(
+                        &check,
+                        Version::Head,
+                        failure(error.clone()),
+                        started.elapsed(),
+                        false,
+                    ));
+                    return Ok(result);
+                }
+                let tool = check.tool.as_ref().context("coverage tool unavailable")?;
+                let mut settings = if check.language == "typescript" {
+                    typescript_coverage_settings(
+                        &self.request.changes.head,
+                        &check.root,
+                        &tool.name,
+                        &tool.version,
+                    )?
+                } else {
+                    python_coverage_settings(&self.request.changes.head, &check.root)?
+                };
+                let disposable = ToolTree::create_until(
+                    &self.materials.as_ref().unwrap().head,
+                    &self.cache.path.join("tools"),
+                    &self.links,
+                    &|| self.before().is_some(),
+                )?;
+                let run = run_coverage(
+                    CoverageRequest {
+                        tool,
+                        settings: &settings,
+                        tool_tree: disposable.path(),
+                        worktree_root: Some(&self.request.worktree),
+                        timeout: self.available(check.kind),
+                        output_limit: self.request.output_limit,
+                    },
+                    &self.supervisor,
+                    self.cancellation.clone(),
+                )
+                .await;
+                let mut outcome = run.outcome;
+                outcome.details_mut().dependency_state = check.dependency_state;
+                for (index, process) in run.processes.iter().enumerate() {
+                    if let Err(error) = self.persist_process(&check, Version::Head, process) {
+                        outcome = failure(error.to_string());
+                    }
+                    if self.request.cache.retain_raw_output {
+                        self.cache.write(
+                            &format!(
+                                "{}/process-{index}.stdout.txt",
+                                check_path(&check, Version::Head)
+                            ),
+                            &process.raw_stdout,
+                        )?;
+                        self.cache.write(
+                            &format!(
+                                "{}/process-{index}.stderr.txt",
+                                check_path(&check, Version::Head)
+                            ),
+                            &process.raw_stderr,
+                        )?;
+                    }
+                }
+                if run
+                    .processes
+                    .iter()
+                    .any(|process| !process.cleanup_confirmed)
+                {
+                    result.notes.push(format!(
+                        "coverage {}: retained disposable tree {}",
+                        check.root,
+                        disposable.preserve().display()
+                    ));
+                }
+                result.tools_ran = !run.processes.is_empty();
+                settings.reports_unloaded &= !run.data.is_empty();
+                result.coverage = run.data;
+                self.cache.write(
+                    &format!("{}/coverage.json", check_path(&check, Version::Head)),
+                    &serde_json::to_vec(&result.coverage)?,
+                )?;
+                result.settings.push(settings);
+                result.entries.push(entry(
+                    &check,
+                    Version::Head,
+                    outcome,
+                    started.elapsed(),
+                    false,
+                ));
+            }
+            CheckKind::Secrets => {
+                let findings = scan_secrets(&self.diff, &self.request.changes.head)?;
+                result.findings = group_preserving_states(findings);
+                let details = CheckDetails {
+                    findings: result.findings.clone(),
+                    ..Default::default()
+                };
+                let outcome = if result.findings.is_empty() {
+                    CheckOutcome::Passed { details }
+                } else {
+                    CheckOutcome::Findings { details }
+                };
+                result.entries.push(entry(
+                    &check,
+                    Version::Head,
+                    outcome,
+                    started.elapsed(),
+                    false,
+                ));
+            }
+            CheckKind::Dependencies => {
+                let audit = dependency_audit_plan(
+                    &self.request.changes.base,
+                    &self.request.changes.head,
+                    &self.diff,
+                )?;
+                result.notes.extend(audit.notes);
+                let client = OsvClient::new(self.request.cache.dir.clone())?;
+                // Advisory ids are discovered by the batch request. A directory
+                // reference protects detail publication and reuse until finish.
+                self.cache.reference("osv")?;
+                let outcome = match tokio::time::timeout(
+                    self.available(check.kind),
+                    client.audit(
+                        &audit.packages,
+                        self.request.offline,
+                        self.cancellation.clone(),
+                    ),
+                )
+                .await
+                {
+                    Ok(outcome) => outcome,
+                    Err(_) => cancelled(CancellationReason::Timeout),
+                };
+                for relative in client.used_cache_entries() {
+                    self.cache.reference(&relative)?;
+                }
+                self.cache.unreference("osv")?;
+                result.findings = outcome.details().findings.clone();
+                result.entries.push(entry(
+                    &check,
+                    Version::Head,
+                    outcome,
+                    started.elapsed(),
+                    false,
+                ));
+            }
+        }
+        Ok(result)
+    }
+}
+
+fn group_preserving_states(findings: Vec<Finding>) -> Vec<Finding> {
+    let mut grouped = BTreeMap::<String, Finding>::new();
+    for finding in findings {
+        if let Some(group) = grouped.get_mut(&finding.id) {
+            group.locations.extend(finding.locations);
+        } else {
+            grouped.insert(finding.id.clone(), finding);
+        }
+    }
+    for finding in grouped.values_mut() {
+        let new = finding
+            .locations
+            .iter()
+            .any(|location| location.occurrence_state == OccurrenceState::New);
+        let existing = finding
+            .locations
+            .iter()
+            .any(|location| location.occurrence_state == OccurrenceState::PreExisting);
+        finding.state = if new && existing {
+            State::Worsened
+        } else if new {
+            State::New
+        } else {
+            State::PreExisting
+        };
+    }
+    grouped.into_values().collect()
+}
+
+pub async fn review(
+    request: ReviewRequest,
+    supervisor: ProcessSupervisor,
+    cancellation: CancellationToken,
+    events: Option<mpsc::UnboundedSender<ReviewEvent>>,
+) -> Result<Report> {
+    ensure!(request.parallelism > 0, "parallelism must be positive");
+    let started = Instant::now();
+    let budget = parse_duration(&request.profile.profile.budget.fast.wall_time)
+        .map_err(anyhow::Error::msg)?;
+    let diff = diff(&request.changes, &profile_excludes(&request.profile))?;
+    let snapshot = Snapshot::from_changes(&request.changes);
+    let profile_hash = request.profile.hash()?;
+    let review_id = blake3::hash(format!("{}|{profile_hash}", snapshot.key).as_bytes()).to_hex()
+        [..16]
+        .to_owned();
+    let mut report = Report::empty(if diff.files.is_empty() {
+        ReportStatus::NoChanges
+    } else {
+        ReportStatus::Complete
+    });
+    report.review = ReviewHeader {
+        id: Some(review_id.clone()),
+        run_id: Some(ulid::Ulid::new().to_string()),
+        mode: Some(match request.changes.selection {
+            Selection::WorkingTree => ReviewMode::WorkingTree,
+            Selection::Staged => ReviewMode::Staged,
+            Selection::Branch { .. } => ReviewMode::Branch,
+        }),
+        base: Some(request.changes.base_id.clone()),
+        head: Some(request.changes.head_id.clone()),
