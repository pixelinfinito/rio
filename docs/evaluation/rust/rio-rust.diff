+fn changes(base: &str, head: &str) -> ChangeSet {
+    let tree = |text: &str| {
+        Tree::from([(
+            "a.ts".into(),
+            TreeEntry {
+                mode: 0o100644,
+                object_id: String::new(),
+                content: text.as_bytes().to_vec(),
+            },
+        )])
+    };
+    ChangeSet {
+        selection: Selection::WorkingTree,
+        base_id: "base".into(),
+        head_id: "head".into(),
+        base: tree(base),
+        head: tree(head),
+    }
+}
