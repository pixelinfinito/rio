+async fn biome_lint_classifies_new_and_existing_warnings_against_baseline() {
+    use std::os::unix::fs::PermissionsExt;
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    let profile = diagnostic_fixture(root, true);
