+//! Lockfile graphs preserve resolution locations and dependency edges. The audit
+//! uses their flattened versions; tool compatibility uses their effective graph.
+mod lockfiles;
+mod npm;
+mod pnpm;
+mod python;
+mod yarn;
+pub use lockfiles::*;
+mod effective;
+pub use effective::*;
+mod installation;
+pub use installation::*;
+mod compatibility;
+pub use compatibility::*;
+
+mod remap;
+pub use remap::*;
+mod source_entries;
+
+mod scope;
+pub use scope::*;
diff --git a/crates/rio-adapters/src/dependencies/npm.rs b/crates/rio-adapters/src/dependencies/npm.rs
new file mode 100644
index 0000000..81cf974
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/npm.rs
@@ -0,0 +1,162 @@
+use super::{
+    DependencyEdge, DependencyGraph, Ecosystem, Importer,
+    lockfiles::{node, strings},
+};
+use anyhow::{Context, Result, ensure};
+use serde_json::Value;
+use std::collections::BTreeMap;
+
+pub(super) fn install_name(location: &str) -> &str {
+    location
+        .rsplit_once("node_modules/")
+        .map_or(location, |(_, name)| name)
+}
+
+pub(super) fn resolve_location(
+    nodes: &BTreeMap<String, super::PackageNode>,
+    from: &str,
+    name: &str,
+) -> Option<String> {
+    let mut directory = from;
+    loop {
+        let candidate = if directory.is_empty() {
+            format!("node_modules/{name}")
+        } else {
+            format!("{directory}/node_modules/{name}")
+        };
+        if nodes.contains_key(&candidate) {
+            return Some(candidate);
+        }
+        if directory.is_empty() {
+            return None;
+        }
+        directory = directory.rsplit_once('/').map_or("", |(parent, _)| parent);
+        if directory.ends_with("node_modules") {
+            directory = directory.rsplit_once('/').map_or("", |(parent, _)| parent);
+        }
+    }
+}
+
+pub(super) fn parse(content: &str) -> Result<DependencyGraph> {
+    let value: Value = serde_json::from_str(content)?;
+    ensure!(
+        matches!(value["lockfileVersion"].as_u64(), Some(2 | 3)),
+        "only npm lockfile versions 2 and 3 are supported"
+    );
+    let packages = value["packages"]
+        .as_object()
+        .context("npm lockfile has no packages table")?;
+    let mut graph = DependencyGraph::new("npm");
+    for (location, package) in packages {
+        if location.is_empty() || !location.split('/').any(|p| p == "node_modules") {
+            continue;
+        }
+        let mut entry = node(
+            location.clone(),
+            package["name"]
+                .as_str()
+                .unwrap_or(install_name(location))
+                .into(),
+            package["version"].as_str().unwrap_or_default().into(),
+            Ecosystem::Npm,
+        );
+        entry.flags.dev = package["dev"].as_bool().unwrap_or(false);
+        entry.flags.optional = package["optional"].as_bool().unwrap_or(false)
+            || package["devOptional"].as_bool().unwrap_or(false);
+        entry.flags.peer = package["peer"].as_bool().unwrap_or(false);
+        entry.flags.os = strings(&package["os"]);
+        entry.flags.cpu = strings(&package["cpu"]);
+        entry.flags.libc = strings(&package["libc"]);
+        if package["link"].as_bool() == Some(true) {
+            entry.link = package["resolved"].as_str().map(str::to_owned);
+            if let Some(link) = &entry.link
+                && let Some(linked) = packages.get(link)
+            {
+                entry.version = linked["version"].as_str().unwrap_or_default().into();
+                entry.name = linked["name"].as_str().unwrap_or(&entry.name).into();
+            }
+        } else if entry.version.is_empty() {
+            graph.unverified(format!("missing installed version at {location}"));
+        }
+        graph.nodes.insert(location.clone(), entry);
+    }
+    for (location, package) in packages {
+        if package["link"].as_bool() == Some(true) {
+            continue;
+        }
+        let mut dependencies = Vec::new();
+        for (kind, dev, optional, peer) in [
+            ("dependencies", false, false, false),
+            ("devDependencies", true, false, false),
+            ("optionalDependencies", false, true, false),
+            ("peerDependencies", false, false, true),
+        ] {
+            // A package's dev dependencies are not installed; importers' are.
+            if dev && graph.nodes.contains_key(location) {
+                continue;
+            }
+            if let Some(entries) = package[kind].as_object() {
+                for (name, _) in entries {
+                    let target = resolve_location(&graph.nodes, location, name);
+                    let optional = optional
+                        || (peer
+                            && package["peerDependenciesMeta"][name]["optional"].as_bool()
+                                == Some(true));
+                    if target.is_none() && !optional {
+                        graph.unverified(format!("unresolved {name} from {location}"));
+                    }
+                    if let Some(target) = target {
+                        dependencies.push(DependencyEdge {
+                            name: name.clone(),
+                            target,
+                            dev,
+                            optional,
+                            peer,
+                            ..Default::default()
+                        });
+                    }
+                }
+            }
+        }
+        // optionalDependencies replaces the matching regular dependency.
+        let optional_names: Vec<_> = dependencies
+            .iter()
+            .filter(|edge| edge.optional)
+            .map(|edge| edge.name.clone())
+            .collect();
+        dependencies.retain(|edge| edge.optional || !optional_names.contains(&edge.name));
+        if let Some(entry) = graph.nodes.get_mut(location) {
+            entry.dependencies = dependencies;
+        } else {
+            graph.importers.insert(
+                if location.is_empty() {
+                    ".".into()
+                } else {
+                    location.clone()
+                },
+                Importer { dependencies },
+            );
+        }
+    }
+    // A workspace link resolves dependencies in its actual source directory.
+    let links: Vec<_> = graph
+        .nodes
+        .iter()
+        .filter_map(|(key, node)| {
+            node.link
+                .as_ref()
+                .map(|target| (key.clone(), target.clone()))
+        })
+        .collect();
+    for (key, target) in links {
+        if let Some(importer) = graph.importers.get(&target) {
+            graph.nodes.get_mut(&key).unwrap().dependencies = importer
+                .dependencies
+                .iter()
+                .filter(|edge| !edge.dev)
+                .cloned()
+                .collect();
+        }
+    }
+    Ok(graph)
+}
diff --git a/crates/rio-adapters/src/dependencies/pnpm.rs b/crates/rio-adapters/src/dependencies/pnpm.rs
new file mode 100644
index 0000000..edae0c8
--- /dev/null
+++ b/crates/rio-adapters/src/dependencies/pnpm.rs
@@ -0,0 +1,229 @@
+use super::{
+    DependencyEdge, DependencyGraph, Ecosystem, Importer,
+    lockfiles::{node, strings},
+};
+use anyhow::{Context, Result};
+use serde::Deserialize;
+use serde_json::Value;
+
+fn split_key(key: &str) -> Option<(String, String)> {
+    let key = key.trim_start_matches('/').split('(').next()?;
+    let at = key
+        .rfind('@')
+        .filter(|&index| index > 0 && !key[..index].contains('('));
+    if let Some(at) = at {
+        return Some((key[..at].into(), key[at + 1..].split('(').next()?.into()));
+    }
+    let (name, version) = key.rsplit_once('/')?;
+    Some((name.into(), version.split('_').next()?.into()))
+}
+
+fn target(graph: &mut DependencyGraph, importer: &str, name: &str, raw: &Value) -> Option<String> {
+    let version = raw.as_str().or_else(|| raw["version"].as_str())?;
+    if let Some(relative) = version
+        .strip_prefix("link:")
+        .or_else(|| version.strip_prefix("workspace:"))
+    {
+        let key = format!("{importer}::{name}");
+        let mut entry = node(key.clone(), name.into(), String::new(), Ecosystem::Npm);
+        entry.link = Some(super::python::normalize_relative(importer, relative));
+        graph.nodes.insert(key.clone(), entry);
+        return Some(key);
+    }
+    let candidates = [
+        format!("{name}@{version}"),
+        format!("/{name}@{version}"),
+        format!("/{name}/{version}"),
+        version.to_owned(),
+    ];
+    candidates
+        .into_iter()
+        .find(|key| graph.nodes.contains_key(key))
+}
+
+pub(super) fn parse(content: &str) -> Result<DependencyGraph> {
+    // pnpm 11/12 prepend an environment/bootstrap lock; the second
+    // document is the project graph (pnpm lockfile yaml_documents.rs).
+    let mut documents = serde_yaml::Deserializer::from_str(content.trim_start_matches('\u{feff}'));
+    let first = documents.next().context("empty pnpm lockfile")?;
+    let first = Value::deserialize(first)?;
+    let value = match documents.next() {
+        Some(main) => Value::deserialize(main)?,
+        None => first,
+    };
+    value
+        .get("lockfileVersion")
+        .context("pnpm lockfile has no version")?;
+    let mut graph = DependencyGraph::new("pnpm");
+    let packages = value["packages"].as_object();
+    let snapshots = value["snapshots"].as_object().or(packages);
+    if let Some(snapshots) = snapshots {
+        for (key, snapshot) in snapshots {
+            let Some((name, version)) = split_key(key) else {
+                graph.unverified(format!("unsupported pnpm snapshot {key}"));
+                continue;
+            };
+            let mut entry = node(key.clone(), name, version, Ecosystem::Npm);
+            let metadata = packages
+                .and_then(|packages| {
+                    packages
+                        .get(key)
+                        .or_else(|| packages.get(key.split('(').next().unwrap()))
+                })
+                .unwrap_or(snapshot);
+            entry.flags.dev = metadata["dev"].as_bool().unwrap_or(false);
+            entry.flags.optional = metadata["optional"].as_bool().unwrap_or(false);
+            entry.flags.os = strings(&metadata["os"]);
+            entry.flags.cpu = strings(&metadata["cpu"]);
+            entry.flags.libc = strings(&metadata["libc"]);
+            graph.nodes.insert(key.clone(), entry);
+        }
+        for (key, snapshot) in snapshots {
+            let mut edges = Vec::new();
+            for (kind, optional) in [("dependencies", false), ("optionalDependencies", true)] {
+                if let Some(dependencies) = snapshot[kind].as_object() {
+                    for (name, version) in dependencies {
+                        match target(&mut graph, ".", name, version) {
+                            Some(target) => edges.push(DependencyEdge {
+                                name: name.clone(),
+                                target,
+                                optional,
+                                ..Default::default()
+                            }),
+                            None if !optional => graph
+                                .unverified(format!("unresolved pnpm dependency {name} in {key}")),
+                            None => {}
+                        }
+                    }
+                }
+            }
+            if let Some(entry) = graph.nodes.get_mut(key) {
+                entry.dependencies = edges;
+            }
+        }
+    }
+    let importers = value["importers"]
+        .as_object()
+        .cloned()
+        .unwrap_or_else(|| [(".".into(), value.clone())].into_iter().collect());
+    for (path, importer) in &importers {
+        let mut edges = Vec::new();
+        for (kind, dev, optional) in [
+            ("dependencies", false, false),
+            ("devDependencies", true, false),
+            ("optionalDependencies", false, true),
+        ] {
+            if let Some(dependencies) = importer[kind].as_object() {
+                for (name, version) in dependencies {
+                    match target(&mut graph, path, name, version) {
+                        Some(target) => edges.push(DependencyEdge {
+                            name: name.clone(),
+                            target,
+                            dev,
+                            optional,
+                            ..Default::default()
+                        }),
+                        None if !optional => {
+                            graph.unverified(format!("unresolved pnpm importer {path}: {name}"))
+                        }
+                        None => {}
+                    }
+                }
+            }
+        }
+        graph.importers.insert(
+            path.clone(),
+            Importer {
+                dependencies: edges,
+            },
+        );
+    }
+    let links: Vec<_> = graph
+        .nodes
+        .iter()
+        .filter_map(|(key, node)| {
+            node.link
+                .as_ref()
+                .map(|target| (key.clone(), target.clone()))
+        })
+        .collect();
+    for (key, target) in links {
+        if let Some(importer) = graph.importers.get(&target) {
+            graph.nodes.get_mut(&key).unwrap().dependencies = importer
+                .dependencies
+                .iter()
+                .filter(|edge| !edge.dev)
+                .cloned()
+                .collect();
+        }
+    }
+    Ok(graph)
+}
+/// pnpm 10.12.1 packages/dependency-path and pnpm 12.4.1 deps-path use
+/// this escaping and SHA-256 prefix (not Rust's platform-dependent hashing).
+pub(super) fn dep_path_to_filename(key: &str, max_length: usize) -> String {
+    use sha2::{Digest, Sha256};
+    let mut filename = key
+        .strip_prefix('/')
+        .unwrap_or(key)
+        .replace(['\\', '/', ':', '*', '?', '"', '<', '>', '|', '#'], "+");
+    if filename.contains('(') {
+        if filename.ends_with(')') {
+            filename.pop();
+        }
+        filename = filename.replace(")(", "_").replace(['(', ')'], "_");
+    }
+    if filename.len() > max_length
+        || (filename != filename.to_lowercase() && !filename.starts_with("file+"))
+    {
+        let hash: String = Sha256::digest(filename.as_bytes())
+            .iter()
+            .take(16)
+            .map(|byte| format!("{byte:02x}"))
+            .collect();
+        let prefix: String = filename
+            .chars()
+            .take(max_length.saturating_sub(33))
+            .collect();
+        return format!("{prefix}_{}", &hash[..32]);
+    }
+    filename
+}
+
+/// pnpm 8 (the historical tRPC evidence) used a 26-character base32 MD5
+/// suffix. Only try its exact path when the current SHA-256 path is absent.
+pub(super) fn legacy_dep_path_to_filename(key: &str) -> String {
+    use md5::{Digest, Md5};
+    let mut filename = key
+        .strip_prefix('/')
+        .unwrap_or(key)
+        .replace(['\\', '/', ':', '*', '?', '"', '<', '>', '|'], "+");
+    if filename.contains('(') {
+        if filename.ends_with(')') {
+            filename.pop();
+        }
+        filename = filename.replace(")(", "_").replace(['(', ')'], "_");
+    }
+    if filename.len() <= 120
+        && (filename == filename.to_lowercase() || filename.starts_with("file+"))
+    {
+        return filename;
+    }
+    let digest = Md5::digest(filename.as_bytes());
+    let alphabet = b"abcdefghijklmnopqrstuvwxyz234567";
+    let mut bits = 0u32;
+    let mut count = 0;
+    let mut hash = String::new();
+    for byte in digest {
+        bits = (bits << 8) | u32::from(byte);
+        count += 8;
+        while count >= 5 {
+            count -= 5;
+            hash.push(alphabet[((bits >> count) & 31) as usize] as char);
+        }
+    }
+    if count > 0 {
+        hash.push(alphabet[((bits << (5 - count)) & 31) as usize] as char);
+    }
+    format!("{}_{}", filename.chars().take(93).collect::<String>(), hash)
+}
