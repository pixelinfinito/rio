+    installed_lock["packages"]["node_modules/legacy/node_modules/lodash"]["version"] =
+        json!("4.17.21");
+    write(
+        root.path(),
+        "node_modules/.package-lock.json",
+        &installed_lock.to_string(),
+    );
+    package(root.path(), "node_modules/lodash", "lodash", "3.10.1");
