@@ -0,0 +1,103 @@
+use std::{fs, path::Path};
+
+use serde_json::{Value, json};
+
+fn schema(name: &str) -> Value {
+    let path = Path::new(env!("CARGO_MANIFEST_DIR")).join(format!("../../schemas/{name}-v1.json"));
+    serde_json::from_str(&fs::read_to_string(path).unwrap()).unwrap()
+}
+
+#[test]
+fn example_findings_and_reports_validate() {
+    let finding_validator = jsonschema::validator_for(&schema("finding")).unwrap();
+    let report_validator = jsonschema::validator_for(&schema("report")).unwrap();
+    let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("tests/fixtures");
+    for entry in fs::read_dir(root).unwrap() {
+        let path = entry.unwrap().path();
+        let value: Value = serde_json::from_str(&fs::read_to_string(&path).unwrap()).unwrap();
+        let validator = if path.file_name().unwrap() == "finding.json" {
+            &finding_validator
+        } else {
+            &report_validator
+        };
+        let errors: Vec<_> = validator
+            .iter_errors(&value)
+            .map(|e| e.to_string())
+            .collect();
+        assert!(errors.is_empty(), "{}: {errors:?}", path.display());
+    }
+}
+
+#[test]
+fn malformed_reports_and_dependency_findings_are_rejected() {
+    let validator = jsonschema::validator_for(&schema("report")).unwrap();
+    let mut report: Value = serde_json::from_str(include_str!("fixtures/error.json")).unwrap();
+    report.as_object_mut().unwrap().remove("error");
+    assert!(!validator.is_valid(&report));
+    report = serde_json::from_str(include_str!("fixtures/complete.json")).unwrap();
+    report["error"] = json!({"code": "unexpected", "message": "wrong status", "details": []});
+    assert!(!validator.is_valid(&report));
+    let validator = jsonschema::validator_for(&schema("finding")).unwrap();
+    let mut finding: Value = serde_json::from_str(include_str!("fixtures/finding.json")).unwrap();
+    finding["rule_id"] = json!("dependency/vulnerable_dependency");
+    assert!(!validator.is_valid(&finding));
+    finding["advisory"] = json!({"id": "GHSA-example", "aliases": [], "severity": "unknown",
+        "fixed_version": "unknown", "url": "https://osv.dev/vulnerability/GHSA-example"});
+    assert!(validator.is_valid(&finding));
+    finding["confidence"] = json!(0.95);
+    assert!(!validator.is_valid(&finding));
+}
+
+#[test]
+fn typed_finding_and_check_round_trip_against_the_schemas() {
+    let value: Value = serde_json::from_str(include_str!("fixtures/finding.json")).unwrap();
+    let finding: rio_core::Finding = serde_json::from_value(value.clone()).unwrap();
+    assert_eq!(serde_json::to_value(&finding).unwrap(), value);
+    assert_eq!(finding.state, rio_core::State::Worsened);
+    assert!(rio_core::EvidenceLevel::Reproduced > rio_core::EvidenceLevel::StaticProven);
+    assert!(rio_core::EvidenceLevel::StaticProven > rio_core::EvidenceLevel::Plausible);
+    assert!(rio_core::EvidenceLevel::Plausible > rio_core::EvidenceLevel::Refuted);
+
+    let schema = schema("report");
+    let check_schema = json!({"$ref": "#/$defs/check", "$defs": schema["$defs"]});
+    let validator = jsonschema::validator_for(&check_schema).unwrap();
+    for fixture in [
+        include_str!("fixtures/complete.json"),
+        include_str!("fixtures/partial.json"),
+    ] {
+        let report: Value = serde_json::from_str(fixture).unwrap();
+        let check: rio_core::CheckEntry =
+            serde_json::from_value(report["checks"][0].clone()).unwrap();
+        let serialized = serde_json::to_value(&check).unwrap();
+        assert_eq!(serialized, report["checks"][0]);
+        assert!(validator.is_valid(&serialized));
+        assert!(!check.outcome.details().findings.is_empty());
+    }
+}
+
+#[test]
+fn reports_and_events_round_trip() {
+    use rio_core::{Report, ReviewEvent};
+    let validator = jsonschema::validator_for(&schema("report")).unwrap();
+    for fixture in [
+        include_str!("fixtures/complete.json"),
+        include_str!("fixtures/incomplete.json"),
+        include_str!("fixtures/partial.json"),
+        include_str!("fixtures/no_changes.json"),
+        include_str!("fixtures/error.json"),
+    ] {
+        let value: Value = serde_json::from_str(fixture).unwrap();
+        let report: Report = serde_json::from_value(value.clone()).unwrap();
+        assert_eq!(serde_json::to_value(&report).unwrap(), value);
+        assert!(validator.is_valid(&serde_json::to_value(&report).unwrap()));
+        let event = ReviewEvent::Done {
+            report: Box::new(report),
+        };
+        let serialized = serde_json::to_value(&event).unwrap();
+        assert_eq!(serialized["event"], "review:done");
+        assert_eq!(
+            serde_json::from_value::<ReviewEvent>(serialized).unwrap(),
+            event
+        );
+    }
+}
diff --git a/crates/rio-core/tests/identity.rs b/crates/rio-core/tests/identity.rs
new file mode 100644
index 0000000..47795d0
--- /dev/null
+++ b/crates/rio-core/tests/identity.rs
@@ -0,0 +1,169 @@
+use proptest::prelude::*;
+use rio_core::{
+    Finding, OccurrenceState, State, classify_and_group, finding_id, normalized_location,
+    normalized_message,
+};
+
+fn diagnostic(line: u32) -> Finding {
+    let mut finding: Finding = serde_json::from_str(include_str!("fixtures/finding.json")).unwrap();
+    finding.location.line_start = line;
+    finding.location.line_end = line;
+    finding.locations = vec![finding.location.clone()];
+    finding
+}
+
+#[test]
+fn normalization_preserves_semantics() {
+    assert_eq!(
+        normalized_location("/repo/./src/a.ts", "a.Class.run", "/repo"),
+        "src/a.ts::a.Class.run"
+    );
+    assert_eq!(
+        normalized_location(r"C:\repo\src\a.ts", "a.run", r"C:\repo"),
+        "src/a.ts::a.run"
+    );
+    assert_eq!(
+        normalized_message(
+            "/repo/src/a.ts(12,5): line 42, column 7: tmp_abcdef12 Type '1'",
+            "/repo"
+        ),
+        "src/a.ts(line,column): line <n>, column <n>: <tool-id> Type '1'"
+    );
+    assert_eq!(
+        normalized_message("/tmp/cache/a.ts: Type 'One' is not 'one'", "/repo"),
+        "a.ts: Type 'One' is not 'one'"
+    );
+    let id = |rule, message| finding_id(rule, "src/a.ts", "a.run", message, "/repo");
+    assert_ne!(
+        id("tsc/TS2322", "Type '1' is not '2'"),
+        id("tsc/TS2322", "Type '3' is not '2'")
+    );
+    assert_ne!(id("lint/a", "same"), id("lint/b", "same"));
+    assert_ne!(id("lint/a", "Type One"), id("lint/a", "Type one"));
+    assert_eq!(
+        id("lint/a", "line 2: tmp_abcdef"),
+        id("lint/a", "line 20: tmp_123abc")
+    );
+}
+
+#[test]
+fn an_extra_occurrence_is_worsened_and_losing_one_is_pre_existing() {
+    let result = classify_and_group(
+        Some(vec![diagnostic(8)]),
+        vec![diagnostic(8), diagnostic(12)],
+        |_, line| Some(line),
+    )
+    .unwrap();
+    assert_eq!(result.len(), 1);
+    assert_eq!(result[0].state, State::Worsened);
+    assert_eq!(
+        result[0]
+            .locations
+            .iter()
+            .filter(|l| l.occurrence_state == OccurrenceState::New)
+            .count(),
+        1
+    );
+    assert_eq!(result[0].location.line_start, 12);
+    let result = classify_and_group(
+        Some(vec![diagnostic(8), diagnostic(10), diagnostic(12)]),
+        vec![diagnostic(8), diagnostic(12)],
+        |_, line| Some(line),
+    )
+    .unwrap();
+    assert_eq!(result[0].state, State::PreExisting);
+    assert_eq!(
+        result[0]
+            .locations
+            .iter()
+            .filter(|l| l.occurrence_state == OccurrenceState::Fixed)
+            .count(),
+        1
+    );
+    assert_eq!(result[0].locations.last().unwrap().line_start, 10);
+}
+
+#[test]
+fn moved_occurrences_pair_in_order_after_exact_mapping() {
+    let result = classify_and_group(
+        Some(vec![diagnostic(4), diagnostic(8)]),
+        vec![diagnostic(1), diagnostic(12), diagnostic(20)],
+        |_, line| (line == 8).then_some(12),
+    )
+    .unwrap();
+    assert_eq!(
+        result[0].locations[0].occurrence_state,
+        OccurrenceState::PreExisting
+    );
+    assert_eq!(
+        result[0].locations[1].occurrence_state,
+        OccurrenceState::PreExisting
+    );
+    assert_eq!(
+        result[0].locations[2].occurrence_state,
+        OccurrenceState::New
+    );
+}
+
+#[test]
+fn absent_baseline_is_unclassified_empty_baseline_is_new_and_removed_is_fixed() {
+    assert_eq!(
+        classify_and_group(None, vec![diagnostic(8)], |_, _| None).unwrap()[0].state,
+        State::Unclassified
+    );
+    assert_eq!(
+        classify_and_group(Some(vec![]), vec![diagnostic(8)], |_, _| None).unwrap()[0].state,
+        State::New
+    );
+    assert_eq!(
+        classify_and_group(Some(vec![diagnostic(8)]), vec![], |_, _| None).unwrap()[0].state,
+        State::Fixed
+    );
+}
+
+proptest! {
+    #[test]
+    fn identity_survives_insertions_and_function_reordering(inserted in 0usize..100, reorder in any::<bool>()) {
+        let function = "function run() {\n  const value: number = 'bad';\n}";
+        let other = "function unrelated() { return 0; }";
+        let original = format!("{function}\n{other}");
+        let moved = format!("{}{}", "\n".repeat(inserted), if reorder {format!("{other}\n{function}")} else {original.clone()});
+        let original_line = original.lines().position(|l| l.contains("'bad'")).unwrap() + 1;
+        let moved_line = moved.lines().position(|l| l.contains("'bad'")).unwrap() + 1;
+        let before = finding_id("typecheck/tsc/TS2322", "src/a.ts", "a.run", &format!("line {original_line}: Type 'string' is not 'number'"), "/repo");
+        let after = finding_id("typecheck/tsc/TS2322", "src/a.ts", "a.run", &format!("line {moved_line}: Type 'string' is not 'number'"), "/repo");
+        prop_assert_eq!(before, after);
+    }
+}
+
+#[test]
+fn missing_baseline_annotates_scope_without_hiding_any_occurrence() {
+    use rio_core::classify_and_group_scoped;
+    let head = vec![diagnostic(2), diagnostic(8)];
+    let result =
+        classify_and_group_scoped(None, head.clone(), |_, _| None, |l| l.line_start == 8).unwrap();
+    assert_eq!(result[0].state, State::Unclassified);
+    assert_eq!(result[0].location.line_start, 2);
+    assert_eq!(
+        result[0].locations[0].occurrence_state,
+        OccurrenceState::Unclassified
+    );
+    assert_eq!(
+        result[0].locations[1].occurrence_state,
+        OccurrenceState::Unclassified
+    );
+    assert!(
+        result[0]
+            .evidence
+            .iter()
+            .any(|e| e.contains("baseline unavailable"))
+    );
+    let result = classify_and_group_scoped(None, head.clone(), |_, _| None, |_| false).unwrap();
+    assert_eq!(result[0].state, State::Unclassified);
+    let result = classify_and_group_scoped(Some(vec![]), head, |_, _| None, |_| false).unwrap();
+    assert_eq!(
+        result[0].state,
+        State::New,
+        "a successful baseline retains cross-file regressions"
+    );
+}
diff --git a/crates/rio-core/tests/policy.rs b/crates/rio-core/tests/policy.rs
new file mode 100644
index 0000000..8d0fad0
--- /dev/null
+++ b/crates/rio-core/tests/policy.rs
@@ -0,0 +1,190 @@
+use rio_core::*;
+
+fn report() -> Report {
+    let mut report: Report = serde_json::from_str(include_str!("fixtures/complete.json")).unwrap();
+    report.findings.clear();
+    report.checks.clear();
+    report
+}
+
+fn check(outcome: CheckOutcome) -> CheckEntry {
+    CheckEntry {
+        kind: CheckKind::Typecheck,
+        language: "typescript".into(),
+        root: ".".into(),
+        version: Version::Head,
+        scheduled_as: ScheduledAs::Changed,
+        outcome,
+        wall_time_ms: 0,
+        cached: false,
+    }
+}
+
+fn finding() -> Finding {
+    let mut finding: Finding = serde_json::from_str(include_str!("fixtures/finding.json")).unwrap();
+    finding.state = State::New;
+    finding
+}
+
+#[test]
+fn all_suppression_types_remove_every_copy_and_attribute_counts() {
+    let f = finding();
+    for suppression in [
+        Suppression::Path {
+            path: "src/**".into(),
+        },
+        Suppression::Rule {
+            rule: "typecheck/tsc/*".into(),
+        },
+        Suppression::Finding {
+            finding: f.id.clone(),
+        },
+    ] {
+        let mut report = report();
+        report.findings.push(f.clone());
+        report.checks.push(check(CheckOutcome::Findings {
+            details: CheckDetails {
+                findings: vec![f.clone()],
+                ..Default::default()
+            },
+        }));
+        apply_suppressions(&mut report, &[suppression]).unwrap();
+        assert!(report.findings.is_empty());
+        assert!(report.checks[0].outcome.details().findings.is_empty());
+        assert_eq!(report.summary.suppressed, 1);
+        assert_eq!(
+            report.footer.suppressions,
+            vec![SuppressionCount { entry: 0, count: 1 }]
+        );
+    }
+}
+
+#[test]
+fn default_policy_distinguishes_regressions_from_risks_and_existing_findings() {
+    let policy = FailOn::default().compile().unwrap();
+    let mut f = finding();
+    assert!(policy.matches(&f));
+    f.state = State::Worsened;
+    assert!(policy.matches(&f));
+    f.state = State::PreExisting;
+    assert!(!policy.matches(&f));
+    f.state = State::New;
+    f.evidence_level = EvidenceLevel::Plausible;
+    assert!(!policy.matches(&f));
+    f.evidence_level = EvidenceLevel::StaticProven;
+    f.category = Category::Risk;
+    assert!(!policy.matches(&f));
+    f.rule_id = "coverage/untested_change".into();
+    assert!(
+        FailOn {
+            rules: vec!["coverage/*".into()],
+            ..Default::default()
+        }
+        .compile()
+        .unwrap()
+        .matches(&f)
+    );
+}
+
+#[test]
+fn failed_and_required_skipped_checks_affect_exit_independently_of_report_status() {
+    let mut r = report();
+    let policy = FailOn::default().compile().unwrap();
+    r.checks.push(check(CheckOutcome::Failed {
+        reason: FailureReason::ToolCrashed,
+        details: CheckDetails::default(),
+    }));
+    derive_report_status(&mut r);
+    assert_eq!(r.status, ReportStatus::Incomplete);
+    assert_eq!(exit_code(&r, &policy, ExitContext::default()), 4);
+    assert_eq!(
+        exit_code(
+            &r,
+            &FailOn {
+                incomplete: false,
+                ..Default::default()
+            }
+            .compile()
+            .unwrap(),
+            ExitContext::default()
+        ),
+        0
+    );
+    r.checks[0].outcome = CheckOutcome::Skipped {
+        reason: SkipReason::ToolMissing,
+        details: CheckDetails::default(),
+    };
+    derive_report_status(&mut r);
+    assert_eq!(r.status, ReportStatus::Incomplete);
+    assert_eq!(exit_code(&r, &policy, ExitContext::default()), 0);
+    assert_eq!(
+        exit_code(
+            &r,
+            &FailOn {
+                required_checks: vec![CheckKind::Typecheck],
+                ..Default::default()
+            }
+            .compile()
+            .unwrap(),
+            ExitContext::default()
+        ),
+        4
+    );
+    r.checks[0].outcome = CheckOutcome::Skipped {
+        reason: SkipReason::Disabled,
+        details: CheckDetails::default(),
+    };
+    derive_report_status(&mut r);
+    assert_eq!(r.status, ReportStatus::Complete);
+    assert_eq!(r.incomplete.len(), 1);
+}
+
+#[test]
+fn precedence_and_partial_status_are_preserved() {
+    let mut r = report();
+    r.status = ReportStatus::Partial;
+    r.findings.push(finding());
+    r.checks.push(check(CheckOutcome::Cancelled {
+        reason: CancellationReason::Interrupted,
+        details: CheckDetails::default(),
+    }));
+    derive_report_status(&mut r);
+    assert_eq!(r.status, ReportStatus::Partial);
+    let policy = FailOn::default().compile().unwrap();
+    assert_eq!(exit_code(&r, &policy, ExitContext::default()), 1);
+    assert_eq!(
+        exit_code(
+            &r,
+            &policy,
+            ExitContext {
+                second_interrupt: true,
+                error: None
+            }
+        ),
+        130
+    );
+    assert_eq!(
+        exit_code(
+            &r,
+            &policy,
+            ExitContext {
+                second_interrupt: true,
+                error: Some(StartError::UsageOrConfiguration)
+            }
+        ),
+        2
+    );
+    assert_eq!(
+        exit_code(
+            &r,
+            &policy,
+            ExitContext {
+                second_interrupt: true,
+                error: Some(StartError::RepositoryOrInternal)
+            }
+        ),
+        3
+    );
+    r.findings.clear();
+    assert_eq!(exit_code(&r, &policy, ExitContext::default()), 4);
+}
