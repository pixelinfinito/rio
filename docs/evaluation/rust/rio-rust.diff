+mod common;
+
+use common::*;
+use rio_git::{
+    ChangeSet, GixRepo, Repo, Selection, Snapshot, Tree, TreeEntry, materialize_tree,
+    read_snapshot, select,
+};
+use std::{collections::BTreeMap, fs};
+
+fn entry(content: &str) -> TreeEntry {
+    TreeEntry {
+        mode: 0o100644,
+        object_id: "unused".into(),
+        content: content.as_bytes().to_vec(),
+    }
+}
+fn changes(base: Tree, head: Tree) -> ChangeSet {
+    ChangeSet {
+        selection: Selection::Staged,
+        base_id: "base".into(),
+        head_id: "head".into(),
+        base,
+        head,
+    }
+}
+
+#[test]
+fn canonical_keys_distinguish_whitespace_and_deleted_paths() {
+    let base: Tree = [("a.ts".into(), entry("a\n")), ("b.ts".into(), entry("b\n"))]
+        .into_iter()
+        .collect();
+    let first = changes(
+        base.clone(),
+        [("b.ts".into(), entry("b\n"))].into_iter().collect(),
+    );
+    let second = changes(
+        base.clone(),
+        [("a.ts".into(), entry("a\n"))].into_iter().collect(),
+    );
+    let one = Snapshot::from_changes(&first);
+    assert_eq!(one.key, Snapshot::from_changes(&first).key);
+    assert_ne!(one.key, Snapshot::from_changes(&second).key);
+    assert_eq!(one.manifest.deleted, ["a.ts"]);
+    let mut with_space = first.clone();
+    with_space.head.get_mut("b.ts").unwrap().content.push(b' ');
+    assert_ne!(one.key, Snapshot::from_changes(&with_space).key);
+    let mut other_base = first;
+    other_base.base_id = "different base".into();
+    assert_ne!(one.key, Snapshot::from_changes(&other_base).key);
+}
+
+#[test]
+fn archive_round_trip_and_delete_before_write_reconstruct_head() {
+    let directory = tempfile::tempdir().unwrap();
+    let base: Tree = [
+        ("a.ts".into(), entry("deleted\n")),
+        ("b.ts".into(), entry("renamed\n")),
+        ("Case.ts".into(), entry("case\n")),
+    ]
+    .into_iter()
+    .collect();
+    let head: Tree = [
+        ("c.ts".into(), entry("renamed and edited\n")),
+        ("case.ts".into(), entry("case\n")),
+    ]
+    .into_iter()
+    .collect();
+    let changes = changes(base.clone(), head.clone());
+    let snapshot = Snapshot::from_changes(&changes);
+    let archive = snapshot.write(directory.path()).unwrap();
+    let read = read_snapshot(&archive, &snapshot.key).unwrap();
+    assert_eq!(snapshot.key, read.key);
+    assert_eq!(read.manifest.deleted, ["Case.ts", "a.ts", "b.ts"]);
+    let destination = directory.path().join("tree");
+    materialize_tree(&destination, &base).unwrap();
+    read.apply(&destination).unwrap();
+    assert!(!destination.join("a.ts").exists());
+    assert!(!destination.join("b.ts").exists());
+    assert_eq!(
+        fs::read(destination.join("c.ts")).unwrap(),
+        head["c.ts"].content
+    );
+    assert_eq!(
+        fs::read(destination.join("case.ts")).unwrap(),
+        head["case.ts"].content
+    );
+    let names: Vec<_> = fs::read_dir(&destination)
+        .unwrap()
+        .map(|e| e.unwrap().file_name().to_str().unwrap().to_owned())
+        .collect();
+    assert!(!names.contains(&"Case.ts".into()));
+    assert!(read_snapshot(&archive, "incorrect key").is_err());
+}
+
+#[test]
+fn selected_head_id_is_the_same_key_as_the_persisted_snapshot() {
+    let directory = init();
+    write(directory.path(), "a.py", "base = 1\n");
+    commit(directory.path(), "base");
+    write(directory.path(), "a.py", "staged = 2\n");
+    git(directory.path(), &["add", "a.py"]);
+    write(directory.path(), "a.py", "unstaged = 3\n");
+    let repo = GixRepo::discover(directory.path()).unwrap();
+    let changes = select(&repo, Selection::Staged).unwrap();
+    let snapshot = Snapshot::from_changes(&changes);
+    assert_eq!(changes.head_id, format!("snapshot:{}", snapshot.key));
+    assert_eq!(snapshot.files["a.py"].content, b"staged = 2\n");
+    let cache = tempfile::tempdir().unwrap();
+    let archive = snapshot.write(cache.path()).unwrap();
+    assert_eq!(snapshot.write(cache.path()).unwrap(), archive);
+    assert_eq!(
+        Snapshot::read(&archive).unwrap().files["a.py"].content,
+        b"staged = 2\n"
+    );
+    assert_eq!(repo.status().unwrap().staged, ["a.py"]);
+}
+
+#[test]
+fn unsafe_manifest_is_rejected_before_applying_any_file() {
+    let directory = tempfile::tempdir().unwrap();
+    let source = changes(
+        BTreeMap::new(),
+        [("safe.ts".into(), entry("okay"))].into_iter().collect(),
+    );
+    let mut snapshot = Snapshot::from_changes(&source);
+    snapshot.manifest.deleted.push("../outside.txt".into());
+    assert!(snapshot.apply(directory.path()).is_err());
+    assert!(!directory.path().join("safe.ts").exists());
+}
+
+#[test]
+fn archive_member_with_parent_traversal_is_rejected_without_extraction() {
+    use std::io::Write;
+    let directory = tempfile::tempdir().unwrap();
+    let source = changes(
+        Tree::new(),
+        [("safe.ts".into(), entry("okay"))].into_iter().collect(),
+    );
+    let snapshot = Snapshot::from_changes(&source);
+    let archive_path = directory.path().join("unsafe.tar.zst");
+    let encoder = zstd::Encoder::new(fs::File::create(&archive_path).unwrap(), 3).unwrap();
+    let mut archive = tar::Builder::new(encoder);
+    let manifest = serde_json::to_vec(&snapshot.manifest).unwrap();
+    let mut header = tar::Header::new_gnu();
+    header.set_size(manifest.len() as u64);
+    header.set_mode(0o600);
+    header.set_cksum();
+    archive
+        .append_data(&mut header, "manifest.json", manifest.as_slice())
+        .unwrap();
+    let mut header = tar::Header::new_gnu();
+    header.set_size(4);
+    header.set_mode(0o600);
+    let name = b"files/../outside.txt";
+    header.as_mut_bytes()[..name.len()].copy_from_slice(name);
+    header.set_cksum();
+    archive.append(&header, &b"oops"[..]).unwrap();
+    archive
+        .into_inner()
+        .unwrap()
+        .finish()
+        .unwrap()
+        .flush()
+        .unwrap();
+    let error = Snapshot::read(&archive_path).unwrap_err().to_string();
+    assert!(error.contains("unsafe_path"), "{error}");
+    assert!(!directory.path().join("outside.txt").exists());
+}
diff --git a/crates/rio-graph/src/build.rs b/crates/rio-graph/src/build.rs
new file mode 100644
index 0000000..caccf22
--- /dev/null
+++ b/crates/rio-graph/src/build.rs
@@ -0,0 +1,329 @@
+use crate::{EdgeKind, EdgeSource, GraphEdge, GraphNode, GraphSlice, GraphSlices, NodeKind};
+use aho_corasick::AhoCorasick;
+use anyhow::{Result, ensure};
+use rio_adapters::{Symbol, SymbolKind, SyntaxCache, SyntaxTable, is_test_path, language_for_path};
+use rio_core::Version;
+use rio_git::{ChangeSet, Diff, Exclusions, Tree};
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+
+#[derive(Debug, Clone)]
+pub struct GraphOptions {
+    pub hops: usize,
+    pub max_nodes: usize,
+    pub exclude: Vec<String>,
+}
+impl Default for GraphOptions {
+    fn default() -> Self {
+        Self {
+            hops: 2,
+            max_nodes: 2000,
+            exclude: Vec::new(),
+        }
+    }
+}
+
+fn graph_node(
+    path: &str,
+    symbol: Option<&Symbol>,
+    source: &[u8],
+    version: Version,
+    seed: bool,
+    hop: usize,
+) -> GraphNode {
+    let symbol_path = symbol
+        .map(|symbol| symbol.symbol_path.clone())
+        .unwrap_or_default();
+    let id = blake3::hash(format!("{version:?}:{path}::{symbol_path}").as_bytes())
+        .to_hex()
+        .to_string();
+    let kind = if is_test_path(path) {
+        NodeKind::Test
+    } else {
+        match symbol.map(|symbol| symbol.kind) {
+            Some(SymbolKind::Function) => NodeKind::Function,
+            Some(SymbolKind::Method) => NodeKind::Method,
+            Some(SymbolKind::Class | SymbolKind::Interface | SymbolKind::Enum) => NodeKind::Class,
+            _ => NodeKind::File,
+        }
+    };
+    let content = symbol
+        .map(|symbol| &source[symbol.byte_start..symbol.byte_end])
+        .unwrap_or(source);
+    GraphNode {
+        id,
+        kind,
+        path: path.into(),
+        symbol_path,
+        name: symbol
+            .map(|symbol| symbol.name.clone())
+            .unwrap_or_else(|| path.rsplit('/').next().unwrap_or(path).into()),
+        line_start: symbol.map_or(1, |symbol| symbol.line_start),
+        line_end: symbol.map_or_else(
+            || source.split(|&byte| byte == b'\n').count() as u32,
+            |symbol| symbol.line_end,
+        ),
+        version,
+        seed,
+        hop,
+        content_hash: blake3::hash(content).to_hex().to_string(),
+    }
+}
+
+fn ignored(tree: &Tree, path: &str) -> Result<bool> {
+    let mut files: Vec<_> = tree
+        .iter()
+        .filter(|(name, _)| name.rsplit('/').next() == Some(".gitignore"))
+        .collect();
+    files.sort_by_key(|(name, _)| name.len());
+    let mut ignored = false;
+    for (name, entry) in files {
+        let directory = name.rsplit_once('/').map_or("", |(directory, _)| directory);
+        let relative = if directory.is_empty() {
+            path
+        } else if let Some(path) = path.strip_prefix(&format!("{directory}/")) {
+            path
+        } else {
+            continue;
+        };
+        let mut builder = ignore::gitignore::GitignoreBuilder::new("");
+        for line in std::str::from_utf8(&entry.content)?.lines() {
+            builder.add_line(None, line)?;
+        }
+        match builder
+            .build()?
+            .matched_path_or_any_parents(relative, false)
+        {
+            ignore::Match::Ignore(_) => ignored = true,
+            ignore::Match::Whitelist(_) => ignored = false,
+            ignore::Match::None => {}
+        }
+    }
+    Ok(ignored)
+}
+
+#[derive(Default)]
+pub struct GraphBuilder {
+    pub syntax: SyntaxCache,
+}
+impl GraphBuilder {
+    pub fn build(
+        &self,
+        changes: &ChangeSet,
+        diff: &Diff,
+        options: &GraphOptions,
+    ) -> Result<GraphSlices> {
+        self.build_until(changes, diff, options, &|| false)
+    }
+    pub fn build_until(
+        &self,
+        changes: &ChangeSet,
+        diff: &Diff,
+        options: &GraphOptions,
+        stop: &dyn Fn() -> bool,
+    ) -> Result<GraphSlices> {
+        ensure!(options.max_nodes > 0, "graph max_nodes must be positive");
+        let base = self.slice(&changes.base, diff, Version::Base, options, stop)?;
+        let head = self.slice(&changes.head, diff, Version::Head, options, stop)?;
+        Ok(GraphSlices::new(base, head))
+    }
+    fn slice(
+        &self,
+        tree: &Tree,
+        diff: &Diff,
+        version: Version,
+        options: &GraphOptions,
+        stop: &dyn Fn() -> bool,
+    ) -> Result<GraphSlice> {
+        let exclusions = Exclusions::new(tree, &options.exclude)?;
+        let mut slice = GraphSlice::default();
+        let mut nodes = BTreeMap::new();
+        let mut queue = VecDeque::new();
+        let mut tables = BTreeMap::<String, SyntaxTable>::new();
+        for file in &diff.files {
+            if stop() {
+                slice.truncated = true;
+                break;
+            }
+            if file.binary || file.excluded.is_some() {
+                continue;
+            }
+            let path = if version == Version::Base {
+                file.old_path.as_deref().unwrap_or(&file.path)
+            } else {
+                &file.path
+            };
+            let Some(entry) = tree.get(path) else {
+                continue;
+            };
+            if language_for_path(path).is_none() {
+                continue;
+            }
+            let table = self.syntax.analyze(path, &entry.content)?;
+            let mut seeds = BTreeSet::new();
+            for hunk in &file.hunks {
+                let range = if version == Version::Base {
+                    hunk.base
+                } else {
+                    hunk.head
+                };
+                for line in range.start..range.start + range.count {
+                    seeds.insert(
+                        table
+                            .enclosing(line)
+                            .map(|symbol| symbol.symbol_path.clone()),
+                    );
+                }
+            }
+            if file.hunks.is_empty() {
+                seeds.insert(None);
+            }
+            for seed in seeds {
+                let symbol = seed.as_ref().and_then(|seed| {
+                    table
+                        .symbols
+                        .iter()
+                        .find(|symbol| &symbol.symbol_path == seed)
+                });
+                let node = graph_node(path, symbol, &entry.content, version, true, 0);
+                if nodes.contains_key(&node.id) {
+                    continue;
+                }
+                if nodes.len() >= options.max_nodes {
+                    slice.truncated = true;
+                    break;
+                }
+                queue.push_back(node.id.clone());
+                nodes.insert(node.id.clone(), node);
+            }
+            tables.insert(path.into(), table);
+        }
+        let candidates: Vec<_> = tree
+            .iter()
+            .filter(|(path, entry)| {
+                language_for_path(path).is_some()
+                    && entry.mode != 0o120000
+                    && exclusions.reason(path, entry, true).is_none()
+            })
+            .filter_map(|(path, entry)| match ignored(tree, path) {
+                Ok(false) => Some(Ok((path, entry))),
+                Ok(true) => None,
+                Err(error) => Some(Err(error)),
+            })
+            .collect::<Result<_>>()?;
+        let mut edges = BTreeMap::new();
+        let mut imports = BTreeMap::<String, BTreeMap<String, Option<String>>>::new();
+        'expand: while let Some(id) = queue.pop_front() {
+            if stop() {
+                slice.truncated = true;
+                break;
+            }
+            let target = nodes[&id].clone();
+            if target.hop >= options.hops {
+                continue;
+            }
+            // Import declarations keep aliased references in the candidate set.
+            // Parsing then discards matches in comments and strings.
+            let module = target
+                .path
+                .rsplit('/')
+                .next()
+                .unwrap_or(&target.path)
+                .split('.')
+                .next()
+                .unwrap_or(&target.name);
+            let search = AhoCorasick::new([target.name.as_str(), module])?;
+            for (path, entry) in &candidates {
+                if stop() {
+                    slice.truncated = true;
+                    break;
+                }
+                if !search.is_match(&entry.content) {
+                    continue;
+                }
+                if !tables.contains_key(*path) {
+                    tables.insert((*path).clone(), self.syntax.analyze(path, &entry.content)?);
+                }
+                let table = &tables[*path];
+                let resolved_imports = imports.entry((*path).clone()).or_insert_with(|| {
+                    table
+                        .imports
+                        .iter()
+                        .map(|import| {
+                            (
+                                import.module.clone(),
+                                crate::resolve::resolve_import(tree, path, &import.module),
+                            )
+                        })
+                        .collect()
+                });
+                let mut names = BTreeSet::from([target.name.as_str()]);
+                for import in &table.imports {
+                    for (alias, name) in &import.names {
+                        if target.symbol_path.is_empty()
+                            || name == &target.name
+                            || name == "default"
+                            || name == "*"
+                        {
+                            names.insert(alias);
+                        }
+                    }
+                }
+                for identifier in &table.identifiers {
+                    if stop() {
+                        slice.truncated = true;
+                        break;
+                    }
+                    if !names.contains(identifier.name.as_str()) {
+                        continue;
+                    }
+                    let Some(confidence) = crate::resolve::reference(
+                        path,
+                        table,
+                        identifier,
+                        &target,
+                        resolved_imports,
+                    ) else {
+                        continue;
+                    };
+                    let symbol = table.enclosing_byte(identifier.byte_start);
+                    let node =
+                        graph_node(path, symbol, &entry.content, version, false, target.hop + 1);
+                    if node.id == target.id {
+                        continue;
+                    }
+                    if !nodes.contains_key(&node.id) {
+                        if nodes.len() >= options.max_nodes {
+                            slice.truncated = true;
+                            break 'expand;
+                        }
+                        queue.push_back(node.id.clone());
+                        nodes.insert(node.id.clone(), node.clone());
+                    }
+                    let kind = if is_test_path(path) {
+                        EdgeKind::Tests
+                    } else if identifier.call {
+                        EdgeKind::Calls
+                    } else {
+                        EdgeKind::References
+                    };
+                    edges
+                        .entry((node.id.clone(), target.id.clone(), kind))
+                        .or_insert(GraphEdge {
+                            from: node.id,
+                            to: target.id.clone(),
+                            kind,
+                            source: EdgeSource::TreeSitter,
+                            confidence,
+                            version,
+                        });
+                }
+            }
+        }
+        slice.nodes = nodes.into_values().collect();
+        slice
+            .nodes
+            .sort_by(|a, b| (&a.path, &a.symbol_path).cmp(&(&b.path, &b.symbol_path)));
+        slice.edges = edges.into_values().collect();
+        Ok(slice)
+    }
+}
