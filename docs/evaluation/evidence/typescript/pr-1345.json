  "title": "fix: skip patches of a draft discarded by writing its base value back",
  "user": {
    "login": "Enesuygurs",
    "id": 54417817,
    "node_id": "MDQ6VXNlcjU0NDE3ODE3",
    "avatar_url": "https://avatars.githubusercontent.com/u/54417817?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/Enesuygurs",
    "html_url": "https://github.com/Enesuygurs",
    "followers_url": "https://api.github.com/users/Enesuygurs/followers",
    "following_url": "https://api.github.com/users/Enesuygurs/following{/other_user}",
    "gists_url": "https://api.github.com/users/Enesuygurs/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/Enesuygurs/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/Enesuygurs/subscriptions",
    "organizations_url": "https://api.github.com/users/Enesuygurs/orgs",
    "repos_url": "https://api.github.com/users/Enesuygurs/repos",
    "events_url": "https://api.github.com/users/Enesuygurs/events{/privacy}",
    "received_events_url": "https://api.github.com/users/Enesuygurs/received_events",
    "type": "User",
