            "symbol_path": "calc.average"
          }
        ],
        "message": "The change removes the `count == 0` guard from `average`. At base, `average(total, 0)` returned 0. At head, it evaluates `total / count` directly and raises `ZeroDivisionError`.",
        "rule_id": "correctness/removed-zero-guard",
        "severity": "error",
        "source": {
          "agent": "correctness"
        },
        "state": "new",
        "suggested_fix": "Restore the guard (`if count == 0: return 0`), or if raising is intended, make that an explicit documented contract and update callers.",
        "trigger": "Call `average(total, 0)` with any total, such as `average(0, 0)` or `average(10, 0)`. Base returned 0; head raises `ZeroDivisionError`.",
